behavior
{
	name bh_hqlogic
	inherited bh_mission_logic_base
	states
	{
		st_init
		{
			group Neutral
			patterns
			{
				pt_default
				{
					actions
					{
						SetAttr "frags 0,0,100,on_change_event:OnZealotKilled"
						SetAttr "NeedFrags ZHQA_FRAGS_ASSAULT"
						SetAttr "PlayerPath PATH_GOOD"
						SetAttr "PlayerDoNotKillSWAT 1"
					}
				}
			}
		}
		st_start
		{
			group Neutral
			patterns
			{
				pt_default
				{
					actions
					{
						PlayerKarma show
						MissionLog add_primary,main,#P3_ZHQA_MISSION1
						MissionLog add_primary,main2,#P3_ZHQA_COUNTER
						MissionLog add_secondary,sec1,#P3_ZHQA_SEC1
					}
					events
					{
						OnZealotKilled "ExecutePattern .xpt_counter"
					}
				}
				xpt_counter
				{
					actions
					{
						//ChangeAttr "frags +1"
						ChangeAttr "NeedFrags -1"
						MissionLog add_primary,main2,#P3_ZHQA_COUNTER
						IfAttr "frags == ZHQA_FRAGS_GARDEN	EntFireInput spawner_apples,Enable"
						IfAttr "frags == ZHQA_FRAGS_VILLAGE	EntFireInput spawner_village,Enable"
						IfAttr "frags == ZHQA_FRAGS_HOUSE	EntFireInput spawner_house,Enable"
						IfAttr "frags == ZHQA_FRAGS_ASSAULT	Pattern pt_al"
					}
				}
				pt_al
				{
					actions
					{
						EntFireInput door_01,Unlock
						EntFireInput door_02,Unlock
						EntFireInput door_7,Unlock
						EntFireInput shop_door_c,Unlock
						EntFireInput spawner_algore,Enable
						EntFireInput spawner_ranged2,Enable
						EntFireInput spawner_melee2,Enable
						MissionLog done,main
						MissionLog done,main2
						playvideo zhqa_door,1,1
						MissionLog add_primary,main3,#P3_ZHQA_MISSION2
					}
					
				}
				pt_end
				{
					actions
					{
						CheckAttr "PlayerDoNotKillSWAT MissionLog done,sec1"
						MissionLog done,main3
						Wait 1
						EntFireInput proxy,Say:TASKFINISH
						EntFireInput fade_out,Fade
						Wait 1
						TargetPlayer 1
						IfAttr "Karma:target >  0 EntFireInput pcc1,Command:video_exitcmd zhqa_2 p3_end_mission"
						IfAttr "Karma:target <= 0 EntFireInput pcc1,Command:video_exitcmd zhqa_4 p3_end_mission"
					}
				}
				pt_fail
				{
					actions
					{
						CheckAttr "PlayerDoNotKillSWAT MissionLog done,sec1"
						MissionLog fail,main3
						PlayerKarma -KARMA_FULL
						Wait 1
						EntFireInput proxy,Say:ALKILL
						EntFireInput fade_out,Fade
						Wait 1
						EntFireInput "pcc1,Command:video_exitcmd zhqa_3 p3_end_mission"
					}
				}
			}
		}
		st_util
		{
			Group Neutral
			Patterns
			{
				xpt_OnPlayerKillSWAT
				{
					actions
					{
						MissionLog fail,sec1
						RemoveAttr PlayerDoNotKillSWAT
					}
				}
			}
		}
	}
	events
	{
		OnUser3 "Pattern st_start.pt_end"
		OnUser4 "Pattern st_start.pt_fail"
		OnFire_SWATDeadByPlayer	"ExecutePattern st_util.xpt_OnPlayerKillSWAT"
		
		OnNewGame "ExecutePattern weaponGive.ZHQA"
	}
}