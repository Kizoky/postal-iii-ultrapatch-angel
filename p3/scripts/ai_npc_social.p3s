		so_seecorpse
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						FreeMovement false
						LookAt true
						Pattern pt_moveto
					}
				}
				
				pt_moveto
				{
					actions
					{
						MoveToTarget walk
						Wait 5
						State st_start
					}
					events
					{
						OnTargetClose "Pattern pt_decide"
					}
				}
				
				pt_decide
				{
					actions
					{
						CheckAttr "flag_bystander Block begin"
							CheckAttr "ImAMan Block begin"
								SetAttr "droch_rnd 0"
								ChangeAttr "droch_rnd 0:99"
								IfAttr "droch_rnd <= 1 SetAttr StartDroch 1"
								RemoveAttr droch_rnd
								
								CheckAttr "StartDroch Block begin"
									RemoveAttr StartDroch
									State ev_fapfap
								Block end
							Block end
						Block end
						
						Pattern pt_shock,pt_fear,pt_callcop
					}
				}
				
				pt_shock
				{
					actions
					{
						SetAttr "NewReaction RE_PUKE"
						Pattern pt_end
					}
				}
				
				pt_fear
				{
					actions
					{
						ExecutePattern st_util.xpt_AddTargetToFear
						SetAttr "NewReaction RE_FEAR"
						Pattern pt_end
					}
				}
				
				pt_callcop
				{
					actions
					{
						Sequence seq.reaction_shocked,seq.reaction_shocked_2,2:2
						Wait 0.2:0.2
						IfAttr "VoicePrefix:self != String:HOBO and VoicePrefix:self != String:WHR Say GETCOP"
						IfAttr "VoicePrefix:self == String:HOBO	Say SEECARNAGE"
						IfAttr "VoicePrefix:self == String:WHR	Say SEECARNAGE"
						WaitForEnd 1
						Pattern pt_end
					}
				}
				
				pt_end
				{
					actions
					{
						IgnoreTarget 50
						ResetTarget 1
						LookAt false
						State st_start
					}
				}
				
				xpt_ReactionChange
				{
					actions
					{
						Pattern pt_end
					}
				}
			}
		}
		
