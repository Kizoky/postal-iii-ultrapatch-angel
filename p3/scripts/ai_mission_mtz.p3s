behavior					/// ДА! У нас можно мочить террористов в сортире! :)
{
	name bh_toilet_talib
	inherited bh_citizen
	states
	{
		ev_chair
		{
			group Neutral
			patterns
			{
				pt_default
				{
					actions
					{
						FreeMovement false
						Sequence seq.weemote_idle,9000
						Wait 9000
						State st_start
					}
					events
					{
						OnHearDanger "Pattern pt_fear"
						OnHearCombat "Pattern pt_fear"
						OnHit "Pattern pt_fear"
					}
				}
				pt_fear
				{
					actions
					{
						Say FEARFUL
						SetAttr "scared 1"
						ResetSequence 1
						FreeMovementParams area_all,0,ED_MIDDLE,area_group
						FreeMovement run
					}
					events
					{
						OnHit "Say DONTKILLME"
					}
				}
			}
		}
	}
}