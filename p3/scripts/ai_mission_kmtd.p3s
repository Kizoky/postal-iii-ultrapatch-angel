behavior
{
	name bh_trafficlight
	states
	{
		st_init
		{
			group Neutral
			patterns
			{
				pt_default
				{
					actions
					{
					}
				}
			}
		}
		st_green
		{
			group Neutral
			patterns
			{
				pt_default
				{
					actions
					{
						AreaEvent GreenLight,12000
						EntFireInput trafficlight_logic,InValue:green
						EntFireInput trafficlight_logic1,InValue:green
						EntFireInput trafficlight_logic2,InValue:green
						EntFireInput trafficlight_logic3,InValue:green
						EntFireInput trafficlight_logic4,InValue:green
						EntFireInput trafficlight_logic5,InValue:green
						EntFireInput trafficlight_logic6,InValue:green
						EntFireInput trafficlight_logic7,InValue:green
						EntFireInput trafficlight_logic8,InValue:green
						EntFireInput trafficlight_logic9,InValue:green
						Wait 10:5
						EntFireInput trafficlight_logic,InValue:yellow
						EntFireInput trafficlight_logic1,InValue:yellow
						EntFireInput trafficlight_logic2,InValue:yellow
						EntFireInput trafficlight_logic3,InValue:yellow
						EntFireInput trafficlight_logic4,InValue:yellow
						EntFireInput trafficlight_logic5,InValue:yellow
						EntFireInput trafficlight_logic6,InValue:yellow
						EntFireInput trafficlight_logic7,InValue:yellow
						EntFireInput trafficlight_logic8,InValue:yellow
						EntFireInput trafficlight_logic9,InValue:yellow
						Wait 3
						State st_red
					}
				}
			}
		}
		st_red
		{
			group Neutral
			patterns
			{
				pt_default
				{
					actions
					{
						AreaEvent RedLight,12000
						EntFireInput trafficlight_logic,InValue:red
						EntFireInput trafficlight_logic1,InValue:red
						EntFireInput trafficlight_logic2,InValue:red
						EntFireInput trafficlight_logic3,InValue:red
						EntFireInput trafficlight_logic4,InValue:red
						EntFireInput trafficlight_logic5,InValue:red
						EntFireInput trafficlight_logic6,InValue:red
						EntFireInput trafficlight_logic7,InValue:red
						EntFireInput trafficlight_logic8,InValue:red
						EntFireInput trafficlight_logic9,InValue:red
						Wait 10:5
						EntFireInput trafficlight_logic,InValue:yellow
						EntFireInput trafficlight_logic1,InValue:yellow
						EntFireInput trafficlight_logic2,InValue:yellow
						EntFireInput trafficlight_logic3,InValue:yellow
						EntFireInput trafficlight_logic4,InValue:yellow
						EntFireInput trafficlight_logic5,InValue:yellow
						EntFireInput trafficlight_logic6,InValue:yellow
						EntFireInput trafficlight_logic7,InValue:yellow
						EntFireInput trafficlight_logic8,InValue:yellow
						EntFireInput trafficlight_logic9,InValue:yellow
						Wait 3
						State st_green
					}
				}
			}
		}
	}
}
behavior
{
	name bh_kmtd_nerd
	inherited bh_civil
	states
	{
		st_init
		{
			group Neutral
			patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern bh_base:st_init.pt_default
						Timer tSay,1:30
						Timer tCheckPlayer,10,repeated
						SetSquad Nerd_squad
						SetSquadRelation Player_squad:enemy:3
						//Timer tCheckPlayer,2,repeated
					}
				}
			}
		}
		st_init_ranged
		{
			group Neutral
			patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern st_init.pt_default
						SetAttr "flag_IgnoreCombat 1"
						SetAttr "flag_IgnoreWeapon 1"
						SetAttr "ReactionThreshold RE_DANGER"
					}
				}
			}
		}
		st_idle
		{
			group Neutral
			patterns
			{
				pt_decide
				{
					actions
					{
						Pattern pt_idle
					}
				}
				xpt_report
				{
					actions
					{
						IfAttr "target.ea_Manner == Manner:Player and DistTo:target < ED_MIDDLE Say POSTAL"
						IfAttr "target.ea_Faction == Faction:Police Say COPREPORT"
						Timer tSay,1:60
					}
				}
				xpt_check
				{
					actions
					{
						TargetPlayer 1
						IfAttr "DistTo:target < ED_FAR State st_start"
						ResetTarget 1
					}
				}
				xpt_OnVisible
				{
					actions
					{
						TargetCaller 1
						IfAttr "RelationTo:target == Relation:enemy State st_start"
						IgnoreTarget 10
						ResetTarget 1
					}
				}
				xpt_OnHearCombat
				{
					actions
					{
						IfAttr "RelationTo:caller == Relation:enemy Block begin"
							TargetCaller 1
							State st_start
						Block end
					}
				}
			}
			events
			{
				OnHearCombat		"ExecutePattern .xpt_OnHearCombat"
				OnTimer_tCheckPlayer "ExecutePattern .xpt_check"
			}
		}
		st_OnDeath
		{
			Group Alert
			Patterns
			{
				pt_default
				{
					actions
					{
						Say DYING
						ExecutePattern bh_base:st_OnDeath.pt_default
					}
				}
			}
		}
	}
	events
	{
		OnTimer_tSay "ExecutePattern st_idle.xpt_report"
	}
}
