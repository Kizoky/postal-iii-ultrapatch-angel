Constants
{
	Const GRG_FRAGS_NEEDED,15
}
behavior
{
	name bh_rodeo_good_logic
	inherited bh_mission_logic_base
	states
	{
		st_init
		{
			group Neutral
			patterns
			{
				pt_default
				{
					actions
					{
						SetAttr "RonDead 0"
						SetAttr "Totaldead 0"
						SetAttr "Zealotsdead 0,on_change_event"
						SetAttr "outside 0"
						SetAttr "PlayerPath PATH_GOOD"
					}
				}
			}
		}
		st_start
		{
			group Neutral
			patterns
			{
				pt_default
				{
					actions
					{
						PlayerKarma show
						
						EntFireInput npc_rhino,SetRider:Randy
						MissionLog add_primary,main,#P3_RODEO_GOOD_MISSION1_OBJ
						MissionLog add_secondary,randy,#P3_RODEO_GOOD_SEC1
						EntFireUser spawner_zealot,1
					}
					events
					{
						OnAttrChange_Zealotsdead "ExecutePattern st_start.xpt_counter"
					}
				}
				pt_rhino
				{
					actions
					{
						EntFireInput muzak.battle,FadeOut:1
						playvideo grg_2,1,1
						EntFireUser npc_rhino,1
						Wait 1
						EntFireInput muzak.rhinobattle,PlaySound
						Wait 1
						ShowMessage "#P3_RODEO_GOOD_MISSION2"
						MissionLog done,main
						MissionLog add_primary,main2,#P3_RODEO_GOOD_MISSION2_OBJ
						Pattern pt_teleport
					}
				}
				pt_teleport
				{
					actions
					{
						TargetEntByName npc_rhino
						IfAttr "target.ea_health < 50 Block begin"
							IfAttr "outside == 0 Block begin"
								playvideo grg_3,1,1
								Wait 0.9
								EntFireInput rhino_teleport,Teleport
								EntFireInput npc_rhino,SetState:st_berserk
								EntFireInput player_teleport,Teleport
							Block end
							Pattern pt_empty
						Block end
						Repeat 5
					}
				}
				pt_empty
				{
					actions
					{
					}
				}
				xpt_counter
				{
					actions
					{
						IfAttr "Zealotsdead == GRG_FRAGS_NEEDED Pattern pt_rhino"
					}
				}
				pt_done
				{
					actions
					{
						//Mission complete
						MissionLog done,main2
						EntFireInput proxy,Say:TASKFINISH
						EntFireInput fade_out,Fade
						Wait 1
						TargetPlayer 1
						IfAttr "Karma:player >  0 EntFireInput pcc1,Command:video_exitcmd grg_4 p3_end_mission"
						IfAttr "Karma:player == 0 EntFireInput pcc1,Command:video_exitcmd grg_5 p3_end_mission"
					}
					events
					{
						OnFire_RandyDead "Wait 0"
					}
				}
				pt_fail
				{
					actions
					{
						MissionLog fail,main2
						EntFireInput proxy,Say:ALKILL
						Wait 1
						EntFireInput fader2,Fade
						Wait 1
						EntFireInput pcc1,Command:reload
						
					}
				}
				xpt_OnRandyDead
				{
					actions
					{
						MissionLog fail,Randy
						TargetEntByName npc_rhino
						IfAttr "Name:target == String:npc_rhino and target.ea_health > 0 PlayerKarma -KARMA_FULL"
					}
				}
			}
		}
	}
	events
	{
		OnRunIn "SetAttr outside 1"
		OnRunOut "SetAttr outside 0"
		OnUser4 "Pattern st_start.pt_done"
		OnUser3 "Pattern st_start.pt_fail"
		OnFire_RandyDead	"ExecutePattern st_start.xpt_OnRandyDead"
		
		OnNewGame	"ExecutePattern weaponGive.GRG"
	}
}

behavior
{
	name bh_randy_rodeo
	inherited bh_citizen
	states
	{
		st_init
		{
			group Neutral
			patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern bh_base:st_init.pt_default
						TargetEntByName mission_logic
						TargetToMem msGP
						ResetTarget 1
						SetAttr "ea_takeable 0"
						SetAttr "voice_pitch 1"
					}
				}
			}
		}
		st_start
		{
			group Neutral
			patterns
			{
				pt_default
				{
					actions
					{
						Timer tYeah,10:20
					}
				}
				pt_yeah
				{
					actions
					{
						Say CHEER
						State st_start
					}
				}
				pt_fall
				{
					actions
					{
						SetAttr "Conscious 0"
						Say HIT
						SetAttr "ea_health 0"
					}
				}
			}
		}
		st_deactivate
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						TargetFromMem msGP
						FireEvent RandyDead
						ExecutePattern bh_base:st_deactivate.pt_default
					}
				}
			}
		}
		ChangeKarma
		{
			Group Neutral
			Patterns
			{
				Lethal
				{
					actions
					{
					}
				}
				NonLethal
				{
					actions
					{
					}
				}
			}
		}
	}
	events
	{
		OnHit "Say HIT"
		OnFallToGround "ExecutePattern st_start.pt_fall"
		OnKicked "ExecutePattern st_start.pt_fall"
		OnTimer_tYeah "Pattern st_start.pt_yeah"
	}
}

behavior
{
	name bh_rodeo_good_zealot
	inherited bh_civil
	states
	{
		st_init
		{
			group Neutral
			patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern bh_base:st_init.pt_default
						
						SetAreaGroup AG_DEFAULT,AG_battle
						SetSquadRelation player_squad:enemy:8
						SetSquad sq_zea
						
						SetAttr "TaskCombat TC_SEARCH"
						Timer tRebel,10:10
						
						SetAttr "flag_VitalEnemy 1"
						SetAttr "flag_IgnorePlayerFear 1"
						SetAttr "flag_IgnoreCombat 1"
						SetAttr "flag_IgnoreWeapon 1"
					}
				}
			}
		}
		st_idle
		{
			group Neutral
			patterns
			{
				pt_default
				{
					actions
					{
						TargetPlayer 1
						MoveToTarget run,ED_CLOSE
						IfAttr "DistTo:target < ED_FAR State st_start"
						Repeat 1
					}
					events
					{
						OnInvalidRoute "FreeMovement run,reset"
					}
				}
			}
		}
		st_util
		{
			Group Neutral
			Patterns
			{
				xpt_SayRebel
				{
					actions
					{
						Say REBEL
						Timer tRebel,10:10
					}
				}
			}
		}
		st_deactivate
		{
			Group Alert
			Patterns
			{
				pt_default
				{
					actions
					{
						ChangeAttr "slot#msGP.Zealotsdead +1"
						ExecutePattern bh_base:st_deactivate.pt_default
					}
				}
			}
		}
	}
	events
	{
		OnTimer_tRebel "ExecutePattern st_util.xpt_SayRebel"
	}
}
