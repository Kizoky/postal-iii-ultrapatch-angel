						CheckAttr "HatesPlayer Pattern pt_hit"
						Pattern pt_check
					}
				}
				
				pt_hit
				{
					actions
					{
						Face true
						IfAttr "HasWeapon:ranged == 2 Pattern pt_shoot"
						Pattern pt_kick
					}
				}
				
				pt_shoot
				{
					actions
					{
						Aim true
						WaitForEnd 1
						Hit 1
						Say DEADTAUNT
						Wait 0.2:0.5
						Pattern pt_end
					}
				}
				
				pt_kick
				{
					actions
					{
						MoveToTarget walk,0,0
						Wait 0.7
						Sequence seq.melee_kick1
						Wait 0.2
						Say DEADTAUNT
						WaitForEnd 1
						Pattern pt_end
					}
				}
				
				pt_check
				{
					actions
					{
						Face true
						Sequence seq.env_inspect_ground
						Wait 0.3
						Say DEADTAUNT
						WaitForEnd 1
						//IfAttr "RelationTo:player == Relation:enemy ShowMessage [!!!],$P3Debug"
						//ShowMessage "[Dude is dead ololol],$P3Debug"
						Pattern pt_end
					}
				}
				
				
				pt_end
				{
					actions
					{
						Aim false
						Face false
						LookAt false
						IgnoreTarget 10
						ResetTarget 1
						State st_start
					}
				}
				
				xpt_reactionchange
				{
					actions
					{
						IfAttr "reaction >= RE_BUMPED Pattern pt_end"
						SetAttr "NewReaction RE_NONE"
						SetAttr "reaction RE_NONE"
					}
				}
			}
		}
