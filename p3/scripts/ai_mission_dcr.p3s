behavior
{
	name bh_dcr_sewer_hobo
	inherited bh_civil
	States
	{
	
		st_init
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern bh_base:st_init.pt_default
						
						SetAreaGroup AG_SEWER
						SetAttr "ReactionTreshold RE_FEAR"
					}
				}
			}
		}
		
		st_idle
		{
			Group Neutral
			Patterns
			{
				pt_idle
				{
					actions
					{
						AvoidProhibitedArea true
						Pattern bh_base:st_idle.pt_idle
					}
					events
					{
						OnInvalidRoute "Pattern pt_return"
					}
				}
				
				pt_return
				{
					actions
					{
						AvoidProhibitedArea false
						SetAreaGroup AG_SEWER,AG_DEFAULT:walkable
						FreeMovementParams area_all,ED_MIDDLE,-1,area_group
						FreeMovement run
						Wait 10
						State st_start
					}
					events
					{
						OnTargetReach "State st_start"
					}
				}
				
				xpt_SetAreaGroup
				{
					actions
					{
						SetAreaGroup AG_SEWER
					}
				}
				
				xpt_SetHintGroup
				{
					actions
					{
						SetHintGroup wish_fun_hobo
					}
				}
				
				xpt_OnVisible
				{
					actions
					{
						IfAttr "Object:caller == Object:player Block begin"
							CheckAttr "slot#msGP.PlayerUnderground Block begin"
								ExecutePattern st_util.xpt_AddPlayerToEnemy
								AreaEvent EnemyDetected,128
								State st_start
							Block end
						Block end
						
						IgnoreTarget 5
						ResetTarget 1
					}
				}
			}
		}
		
		st_util
		{
			Group Neutral
			Patterns
			{
				xpt_AddPlayerToEnemy
				{
					actions
					{
						TargetPlayer 1
						Relationship target,enemy,3
						Timer tCheckPlayer,3,repeated
						AvoidProhibitedArea false
					}
				}
				
				xpt_CheckPlayerPlace
				{
					actions
					{
						CheckAttr "slot#msGP.PlayerUnderground Block begin"
							Timer tStopPursuit,10
							//this timer resets if player is in underground
							//when he leaves, hobos stop pursuing him after 10 seconds
							//Return 1
						Block end
						
						//Timer tStopPursuit,10
					}
				}
				
				xpt_ForgivePlayer
				{
					actions
					{
						TargetPlayer 1
						Relationship target,neutral
						Timer tCheckPlayer,0
						AvoidProhibitedArea true
						State st_start
					}
				}
			}
		}
		
	}
	events
	{
		OnAE_EnemyDetected "ExecutePattern st_util.xpt_AddPlayerToEnemy"
		OnTimer_tCheckPlayer "ExecutePattern st_util.xpt_CheckPlayerPlace"
		OnTimer_tStopPursuit	"ExecutePattern st_util.xpt_ForgivePlayer"
	}
}


behavior 
{
	name bh_sushi
	inherited bh_military_new
	
	states
	{
		st_init
		{
			Group Neutral
			
			Patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern bh_base:st_init.pt_default
						
						SetSquad Sushi_squad
						SetSquadRelation Player_squad:enemy:3
						
						SetAttr "flag_IgnorePlayerFear 1"
						SetAttr "flag_IgnoreCombat 1"
						SetAttr "flag_IgnoreWeapon 1"
						
						SetAttr "ReactionThreshold RE_DANGER"
						SetAttr "LoveAnimals 0"
					}
				}
			}
		}
		
		st_start
		{
			Group Neutral
			
			Patterns
			{
				xpt_combat
				{
					actions
					{
						AreaEvent SushiEnemySpotted,64
						ExecutePattern bh_base:st_start.xpt_combat
					}
				}
			}
		}
		
		st_idle
		{
			Group Neutral
			
			Patterns
			{
				xpt_SelectWeapon
				{
					actions
					{
						IfAttr "ea_ActiveWeapon == Weapon:Ranged Aim true,false"
					}
				}
				
				pt_gotohint
				{
					actions
					{
						Pattern pt_idle
					}
				}
				
				pt_idle
				{
					actions
					{
						CheckAttr "PlayerInHouseA Pattern bh_base:st_idle.pt_idle"
						CheckAttr "PlayerInHouseB Pattern bh_base:st_idle.pt_idle"
						CheckAttr "PlayerInGarage Pattern bh_base:st_idle.pt_idle"
						
						TargetPlayer 1
						MoveToTarget run,0
						Wait 5
						State st_start
					}
				}
				
				pt_end
				{
					actions
					{
						State st_start
					}
				}
				
				xpt_OnVisible
				{
					actions
					{
						TargetCaller 1
						IfAttr "RelationTo:Target == Relation:Enemy State st_start"
					}
				}
				
				xpt_OnSushiEnemySpotted
				{
					actions
					{
						TargetCaller 1
						AssistTarget 1
						Relationship target,enemy
						State st_start
					}
				}
				
			}
			events
			{
				OnAE_SushiEnemySpotted "ExecutePattern .xpt_OnSushiEnemySpotted"
			}
		}
		
		st_combat_logic
		{
			Group Combat
			Patterns
			{
				xpt_SayAttack
				{
					actions
					{
						IfAttr "Timer:tCanSay > 0 Return 1"
						Say POSTAL,SEECATPOACHER
						Timer tCanSay,5:3
					}
				}
				
				xpt_SayShoot
				{
					actions
					{
						IfAttr "Timer:tCanSay > 0 Return 1"
						Say POSTAL,SEECATPOACHER
						Timer tCanSay,5:3
					}
				}
			}
		}
		
		st_util
		{
			Group Neutral
			
			Patterns
			{
				xpt_OnCatPicked
				{
					actions
					{
						Say SEECATPOACHER,2
						Timer tCanSay,3:3
					}
				}
				
				xpt_CatnipKillerCheck
				{
					actions
					{
						IfAttr "ea_NumEnemies == 0 and ea_NumFear == 0 Block begin"
							TargetCaller 1
							Hate true
						Block end
						
						State st_start
					}
					events
					{
						OnEnemiesDead "Hate false"
					}
				}
				
				xpt_AddCallerToEnemy
				{
					actions
					{
						TargetCaller 1
						Relationship target,enemy
						AreaEvent SushiEnemySpotted,64
					}
				}
				
				xpt_OnHit
				{
					actions
					{
						ExecutePattern bh_base:st_util.xpt_OnHit
						IfAttr "Object:caller == Object:player ExecutePattern st_util.xpt_AddCallerToEnemy"
					}
				}
			}
		}
	}
	
	events
	{
		//OnAE_CATNIP "ExecutePattern st_util.xpt_CatnipKillerCheck"
		//OnAE_Dervish "ExecutePattern st_util.xpt_AddCallerToEnemy"
		OnCatPicked "ExecutePattern st_util.xpt_OnCatPicked"
	}
}

behavior
{
	name bh_dcr_cat
	inherited bh_cat
	States
	{
		st_catched
		{
			Group Neutral
			Patterns
			{
				pt_default:ignore_ext_events
				{
					actions
					{
						EntFireInput npc_sushi,FireFSMScriptEvent:OnCatPicked,64
						Pattern bh_base:st_catched.pt_default
					}
				}
			}
		}
		
	}
}