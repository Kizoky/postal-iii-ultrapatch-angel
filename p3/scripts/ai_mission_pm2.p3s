behavior
{
	name bh_pm2_babuska
	inherited bh_civil
	States
	{
		st_init
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern bh_base:st_init.pt_default
						SetAttr "ReactionThreshold RE_DANGER"
						//ResetTarget 1
					}
				}
			}
		}
		
		st_start
		{
			Group Neutral
			Patterns
			{
				xpt_ChooseEnemy
				{
					actions
					{
						CheckAttr "slot#msENEMY.active Block begin"
							TargetFromMem msENEMY
							State st_creep
						Block end
						ExecutePattern bh_base:st_start.xpt_ChooseEnemy
					}
				}
				
				xpt_FirstRun
				{
					actions
					{
						TargetEntByName "npc_victim"
						TargetToMem msENEMY
						Relationship target,enemy,1
						
						ExecutePattern bh_base:st_start.xpt_FirstRun
					}
				}
			}
		}
		
		st_idle
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						Wait 1
						State st_start
					}
					events
					{
						OnNewEnemy "State st_start"
					}
				}
			}
		}
		
		st_combat_logic
		{
			Group Combat
			Patterns
			{
				xpt_setTaskDefault  // дефолтное задание
				{
					actions 
					{
						SetAttr "TaskCombat TC_POSITION"
					}
				}
			}
		}
		
		st_creep
		{
			Group Combat
			Patterns
			{
				pt_default
				{
					actions 
					{
						Face true
						Aim true,false
						SetAttr "NumCreepLoops 0,0,3"
						Pattern pt_creep_loop
					}
				}
				
				pt_creep_loop
				{
					actions
					{
						Say TOUGH
						Wait 3
						CheckAttr "slot#msGP.Crime03Active Block begin"
							Hit SpreadMove
							SetAttr "ea_status sMILITANT"
						Block end
						Wait 2:2
						CheckAttr "slot#msGP.Crime03Active ChangeAttr NumCreepLoops +1"
						IfAttr "NumCreepLoops == 3 Pattern pt_shoot"
						Repeat 0
					}
				}
				
				pt_shoot
				{
					actions
					{
						Hit SpreadMove
						Wait 1:2
						Repeat 0
					}
				}
				
				pt_done
				{
					actions
					{
						ExecutePattern st_util.xpt_AddPlayerToEnemy
						Pattern pt_end
					}
				}
				
				pt_end
				{
					actions
					{
						Face false
						State st_start
					}
				}
				
				xpt_ReactionChange
				{
					actions
					{
						IfAttr "reaction >= RE_SNATCHED Pattern pt_end"
					}
				}
			}
			events
			{
				OnTargetReset "Pattern pt_end"
				OnFire_VictimDead "Pattern pt_done"
			}
		}
		
		
		st_deactivate
		{
			Group Alert
			Patterns
			{
				pt_default
				{
					actions
					{
						TargetFromMem msGP
						FireEvent BabuskaDead
						ExecutePattern bh_base:st_deactivate.pt_default
					}
				}
			}
		}
	}
	events
	{
		OnFire_VictimDead "ExecutePattern st_util.xpt_AddPlayerToEnemy"
	}
}


behavior
{
	name bh_pm2_rob_victim
	inherited bh_pm2_civil
	States
	{
		st_start
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						Crouch false
						Senses true
						TargetEntByName npc_babuska
						IfAttr "Object:target != Object:Null Block begin"
							CheckAttr "target.active Block begin"
								Relationship target,fear
								State st_begging
							Block end
						Block end
						ExecutePattern bh_base:st_start.pt_default
					}
				}
			}
		}
		
		st_begging
		{
			Group Alert
			Patterns
			{
				pt_default
				{
					actions
					{
						Sequence seq.env_crouch,9000
						//FreeMovementParams area_visible,16,32
						//FreeMovement true
						Gesture g_emote_afraid
						Timer tCover,3,repeated
						Timer tSay,7:3,repeated
					}
					events
					{
						OnTimer_tCover	"Gesture g_emote_afraid"
						OnTimer_tSay	"Say CRY,DONTKILLME"
					}
				}
				
				pt_done
				{
					actions
					{
						SetAttr "NewReaction RE_FEAR"
						Pattern pt_end
					}
				}
				
				pt_end
				{
					actions
					{
						State st_start
					}
				}
				
				xpt_ReactionChange
				{
					actions
					{
						IfAttr "reaction > RE_FEAR Pattern pt_end"
					}
				}
			}
			events
			{
				OnTargetReset "Pattern pt_done"
				OnTargetArrested "Pattern pt_done"
				OnTargetUnconscious "Pattern pt_done"
			}
		}
		
		st_deactivate
		{
			Group Alert
			Patterns
			{
				pt_default
				{
					actions
					{
						TargetEntByName npc_babuska
						FireEvent VictimDead
						TargetFromMem msGP
						FireEvent VictimDead
						ExecutePattern bh_base:st_deactivate.pt_default
					}
				}
			}
		}
	}
}

behavior
{
	name bh_pm2_fighter
	inherited bh_civil
	States
	{
		st_init
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern bh_base:st_init.pt_default
						Timer tRetarget,0
						Timer tCheckActivity,1,repeated
						SetAttr "StandBy 1"
						
						SetAttr "flag_IgnoreCombat 1"
						SetAttr "flag_IgnorePlayerFear 1"
						SetAttr "flag_IgnorePlayerAttack 1"
						SetAttr "flag_IgnoreWeapon 1"
						SetAttr "ReactionThreshold RE_DANGER"
						
						SetAttr "NumInvRoute 0,0,3"
					}
				}
			}
		}
		
		st_init1
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern st_init.pt_default
						SetSquad fighter_squad1
						SetAttr "GangNum 1"
						//SetSquadRelation fighter_squad2:enemy:1
					}
				}
			}
		}
		
		st_init2
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern st_init.pt_default
						SetSquad fighter_squad2
						SetAttr "GangNum 2"
						//SetSquadRelation fighter_squad1:enemy:1
					}
				}
			}
		}
		
		st_start
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern st_util.xpt_SetRetargetTimer
						ExecutePattern bh_base:st_start.pt_default
					}
				}
				
				xpt_ChooseEnemy
				{
					actions
					{
						IfAttr "slot#msGP.FightersNum <= 3 ExecutePattern st_util.xpt_AddPlayerToEnemy"
						IfAttr "NumInvRoute == 3 State st_cheer"
						ExecutePattern bh_base:st_start.xpt_ChooseEnemy
					}
				}
			}
		}
		
		st_idle
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						SetAttr "busy 1"
						CheckAttr "StandBy Pattern pt_standby_decide"
						IfAttr "ea_NumEnemy > 0 State st_start"
						CheckAttr "slot#msGP.Crime05NotDone State st_start"
						
						ExecutePattern bh_base:st_idle.pt_default
					}
				}
				
				pt_standby_decide
				{
					actions
					{
						CheckAttr "GangLeader Pattern pt_provoke"
						Pattern pt_standby
					}
				}
				
				pt_provoke
				{
					actions
					{
						Wait 0:2
						Sequence emote_aggro
						Say TOUGH,BULLY,TAUNT
						Wait 5:3
						State st_start
					}
				}
				
				pt_standby
				{
					actions
					{
						Wait 5
						State st_start
					}
				}
				
				xpt_CheckActivity
				{
					actions
					{
						CheckAttr "slot#msGP.Crime05Active Block begin"
							RemoveAttr StandBy
							Timer tCheckActivity,0
							Timer tChangePlace,3:7
							IfAttr "GangNum == 1 SetSquadRelation fighter_squad2:enemy:1"
							IfAttr "GangNum == 2 SetSquadRelation fighter_squad1:enemy:1"
							
							CheckAttr "ImAMan Block begin"
								SetActPack ACT_IDLE,melee_box_idle,Alert
								SetActPack ACT_IDLE,melee_box_idle,wound
							Block end
						Block end
					}
				}
			}
			events
			{
				OnVisible "Wait 0"
				OnTimer_tCheckActivity "ExecutePattern .xpt_CheckActivity"
			}
		}
		
		st_attack_melee
		{
			Group Combat
			Patterns
			{
				pt_default
				{
					actions
					{
						IfAttr "Timer:tChangePlace <= 0 and Object:target != Object:Player Pattern pt_change_place"
						IfAttr "Object:target == Object:player Block begin"
							HeadBlob 2,Attention
							Timer tResetHeadBlob,3
						Block end
						Pattern bh_base:st_attack_melee.pt_default
					}
				}
				pt_attack
				{
					actions 
					{
						AreaEvent Crime05,8
						Pattern bh_base:st_attack_melee.pt_attack
					}
				}
				pt_runloop
				{
					actions
					{
						MoveToTarget run,1
						Repeat 3
					}
					events
					{ 
						OnTargetReach "Pattern pt_face"
						OnInvalidRoute "Pattern pt_invroute"
					}
				}

				pt_box
				{
					actions
					{
						AreaEvent Crime05,8
						Pattern bh_base:st_attack_melee.pt_box
					}
				}
				pt_push
				{
					actions
					{
						AreaEvent Crime05,8
						Pattern bh_base:st_attack_melee.pt_push
					}
					events
					{
						OnAnim_PUSH_HEAVY "ExecutePattern .xpt_ChoosePush"
					}
				}
				xpt_ChoosePush
				{
					actions
					{
						CheckAttr "target.GangNum Return 1"
						IfAttr "Object:target == Object:player Push self,target,hard"
						IfAttr "Object:target != Object:player Push self,target,medium"
					}
				}
				pt_change_place
				{
					actions
					{
						FreeMovementParams area_all,ED_VERY_CLOSE,ED_CLOSE
						FreeMovement run
						Timer tChangePlace,5:5
						Wait 2:1
						Pattern pt_end
					}
					events
					{
						OnTargetReach "Pattern pt_end"
					}
				}
				pt_invroute
				{
					actions
					{
						ChangeAttr "NumInvRoute +1"
						Pattern pt_end
					}
				}
			}
		}
		
		st_cheer
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						SetAttr "NumInvRoute 0"
						Pattern pt_cheer
					}
				}
				pt_cheer
				{
					actions
					{
						Sequence emote_aggro
						Say CHEER,BULLY,TOUGH
						WaitForEnd 1
						Wait 1:1
						Pattern pt_end
					}
				}
				pt_end
				{
					actions
					{
						State st_start
					}
				}
				xpt_ReactionChange
				{
					actions
					{
						Pattern pt_end
					}
				}
			}
		}
		
		st_util
		{
			Group Neutral
			Patterns
			{
				xpt_AddPlayerToEnemy
				{
					actions
					{
						TargetPlayer 1
						SetSquadRelation Player_squad:enemy:5
					}
				}
				
				xpt_OnHit
				{
					actions
					{
						ExecutePattern bh_base:st_util.xpt_OnHit
						ExecutePattern st_util.xpt_AgressionDetected
					}
				}
				
				xpt_AgressionDetected
				{
					actions
					{
						IfAttr "Object:caller == Object:player Block begin"
							AreaEvent PlayerBad,8,Citizen
							ExecutePattern st_util.xpt_AddPlayerToEnemy
						Block end
					}
				}
				
				xpt_SetRetargetTimer
				{
					actions
					{
						IfAttr "Timer:tRetarget <= 0 Block begin"
							Timer tRetarget,10
							IfAttr "Object:target == Object:player Timer tRetarget,30"
						Block end
					}
				}
				
				xpt_Retarget
				{
					actions
					{
						IfAttr "RelationTo:target == Relation:Enemy Block begin"
							IgnoreTarget 1
							ResetTarget 1
							TargetEnemy 1
						Block end
						ExecutePattern st_util.xpt_SetRetargetTimer
						State st_start
					}
				}
				
				xpt_OnAttackedByPlayer
				{
					actions
					{
						ExecutePattern bh_base:st_util.xpt_OnAttackedByPlayer
						CheckAttr "slot#msGP.Crime05Active Return 1"
						TargetFromMem msGP
						FireEvent Crime05StartsEarly
						ResetTarget 1
					}
				}
			}
		}
		
		st_deactivate
		{
			Group Alert
			Patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern st_util.xpt_AgressionDetected
						TargetFromMem msGP
						IfAttr "ea_health <= 0 FireEvent FighterDead"
						IfAttr "ea_health >  0 FireEvent FighterDone"
						ExecutePattern bh_base:st_deactivate.pt_default
					}
				}
			}
		}
		
	}
	events
	{
		OnTimer_tRetarget "ExecutePattern st_util.xpt_SetRetargetTimer"
		OnTargetUnconscious "ExecutePattern st_util.xpt_Retarget"
		OnTargetArrested "ExecutePattern st_util.xpt_Retarget"
		
		OnTimer_tResetHeadblob	"Headblob 2,false"
		OnImGangLeader	"SetAttr GangLeader 1"
	}
}




behavior
{
	name bh_pm2_monkey
	inherited bh_animal
	States
	{
		st_init
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern bh_base:st_init.pt_default
						
						TargetEntByName mission_logic
						TargetToMem msGP
						ResetTarget 1
						
						Timer tFacefuck,0
						Timer tCheckDistance,10,repeated
					}
				}
			}
		}
		
		st_attack
		{
			Group Alert
			Patterns
			{
				pt_default
				{
					actions
					{
						TargetToMem msTEMP
						TargetItem 1
						IfAttr "Object:target == Object:slot#msTEMP State st_facefuck"
						TargetFromMem msTEMP
						ClearMem msTEMP
						State st_throw
					}
				}
			}
		}
		
		st_throw
		{
			Group Combat
			Patterns
			{
				pt_default
				{
					actions
					{
						State st_start
					}
				}
			}
		}
		
		st_facefuck
		{
			Group Alert
			Patterns
			{
				pt_default
				{
					actions
					{
						FreeMovement false
						IfAttr "Timer:tFacefuck > 0 State st_start"
						Headblob 2,Attention
						Timer tResetHeadblob,3
						IfAttr "DistTo:target < 32 Pattern pt_snatch"
						Pattern pt_move
					}
				}
				
				pt_move
				{
					actions
					{
						MoveToTarget run,2
						Wait 5:5
						IgnoreTarget 5
						ResetTarget 1
						State st_start
					}
					events
					{
						OnTargetClose "Pattern pt_snatch"
						OnTargetReach "Pattern pt_snatch"
					}
				}
				
				pt_snatch
				{
					actions
					{
						//MoveToTarget false
						//Wait 0.1
						Snatch true,fucking_monkey
						Wait 2.5
						Pattern pt_end
					}
					events
					{
						OnSnatch "Pattern pt_fuck"
					}
				}
				
				pt_fuck
				{
					actions
					{
						
						Wait 4:4
						Timer tFacefuck,20
						Snatch false
					}
					events
					{
						OnUnsnatch "Pattern pt_end"
					}
				}
				
				pt_end
				{
					actions
					{
						IgnoreTarget 10
						ResetTarget 1
						State st_start
					}
				}
			}
		}
		
		st_idle
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						ResetTarget 1
						CallPattern pt_angry
						Wait 0:2
						Pattern pt_move
					}
				}
				
				pt_angry
				{
					actions
					{
						SetAttr "rnd 0"
						ChangeAttr "rnd 0:4"
						
						IfAttr "rnd == 0 Block begin"
							RemoveAttr rnd
							Wait 0:2
							Sequence seq.idle_angry
							WaitForEnd 1
							ResetSequence 1
						Block end
						
						RemoveAttr rnd
					}
				}
				
				pt_move
				{
					actions
					{
						SetAreaGroup AG_MONKEY
						FreeMovementParams area_all,ED_CLOSE,ED_FAR,area_group
						FreeMovement random
						Wait 3:5
						Pattern pt_default
					}
					events
					{
						OnTargetReach "Pattern pt_default"
						OnInvalidRoute "Pattern pt_default"
					}
				}
				
				xpt_OnVisible
				{
					actions
					{
						StateMatrix faction
						StateMatrix social
						IgnoreTarget 3
						ResetTarget 1
					}
				}
			}
			events
			{
				OnVisible "ExecutePattern .xpt_OnVisible"
			}
		}
		
		st_deactivate
		{
			Group Alert
			Patterns
			{
				pt_default
				{	
					actions
					{
						TargetFromMem msGP
						FireEvent MonkeyDead
						
						ExecutePattern bh_base:st_deactivate.pt_default
					}
				}
			}
		}
		st_util
		{
			Group Neutral
			Patterns
			{
				xpt_CheckDistance
				{
					actions
					{
						IfAttr "DistTo:Player < ED_VERY_FAR Return 1"
						
						TargetFromMem msGP
						FireEvent PlayerLeftCrime02
					}
				}
			}
		}
	}
	events
	{
		OnTimer_tResetHeadblob	"Headblob 2,false"
		OnTimer_tCheckDistance	"ExecutePattern st_util.xpt_CheckDistance"
	}
}



behavior
{
	name bh_pm2_civil
	inherited bh_hub2_civil
	States
	{
		st_init
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern bh_base:st_init.pt_default
						SetAttr "flag_bystander 1"
					}
				}
			}
		}
		st_init_static
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern st_init.pt_default
						SetAttr "flag_static 1"
					}
				}
			}
		}
		st_idle
		{
			Group Neutral
			Patterns
			{
				xpt_SetAreaGroup
				{
					actions
					{
						SetAreaGroup AG_DEFAULT,AG_MONKEY,AG_FASTFOOD
					}
				}
				
				xpt_SetHintGroup
				{
					actions
					{
						SetHintGroup wish_fun_idle
						CheckAttr "IHaveCell SetHintGroup wish_fun_idle,wish_fun_phone"
						CheckAttr "ImAMan SetHintGroup wish_fun_idle,wish_fun_phone,wish_fun_man"
						//Because all MAvgs can use phone
						
						IfAttr "ea_manner == Manner:LowLife SetHintGroup wish_fun_hobo"
					}
				}
			}
		}
		
	}
	events
	{
		OnAE_HasWeapon "Wait 0"
		OnAE_Crime05	"SetAttr NewReaction RE_FEAR"
	}
}


