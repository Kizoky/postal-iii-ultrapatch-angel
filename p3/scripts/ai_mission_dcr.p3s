behavior
{
	name bh_dcr_civil_shopkeeper
	inherited bh_dcr_civil
	
	States
	{
		st_start
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						IfAttr "RelationTo:player == Relation:enemy Block begin"
							CheckAttr "slot#msGP.PlayerInShop Timer tForgivePlayer,20"
						Block end
						
						ExecutePattern bh_base:st_start.pt_default
					}
				}
			}
		}
		
		st_OnHearCombat
		{
			Group Alert
			Patterns
			{
				pt_default
				{
					actions
					{
						IfAttr "Object:caller == Object:player Block begin"
							CheckAttr "slot#msGP.PlayerInShop Pattern st_seeweapon.pt_check" //��������� �� ���� ��������
						Block end
						
						IfAttr "Object:caller != Object:player Pattern bh_base:st_OnHearCombat.pt_default"
						
						Pattern pt_end
					}
				}
			}
		}
		
	}
}


behavior
{
	name bh_dcr_civil_house
	inherited bh_dcr_civil
	
	States
	{
		st_idle
		{
			Group Neutral
			Patterns
			{
				pt_decide
				{
					actions
					{
						ExecutePattern .xpt_SetAreaGroup
						Pattern pt_idle,pt_gotohint
					}
				}
				
				xpt_SetAreaGroup
				{
					actions
					{
						CheckAttr "LiveInHouseA SetAreaGroup AG_HOUSEA"
						CheckAttr "LiveInHouseB SetAreaGroup AG_HOUSEB"
						CheckAttr "LiveInGarage SetAreaGroup AG_GARAGE"
					}
				}
				
				xpt_SetHintGroup
				{
					actions
					{
						CheckAttr "LiveInHouseA Block begin"
							SetHintGroup wish_fun_housea
							SetLeanGroup lg_housea
						Block end
						
						CheckAttr "LiveInHouseB SetHintGroup wish_fun_houseb"
						CheckAttr "LiveInGarage SetHintGroup wish_fun_garage"
					}
				}
				
				xpt_OnVisible
				{
					actions
					{
						IfAttr "Object:caller == Object:player Block begin"
							CheckAttr "LiveInHouseA Block begin"
								CheckAttr "slot#msGP.PlayerInHouseA SetAttr PlayerInvader 1"
							Block end
							
							CheckAttr "LiveInHouseB Block begin"
								CheckAttr "slot#msGP.PlayerInHouseB SetAttr PlayerInvader 1"
							Block end
							
							CheckAttr "LiveInGarage Block begin"
								CheckAttr "slot#msGP.PlayerInGarage SetAttr PlayerInvader 1"
							Block end
							
							CheckAttr "PlayerInvader Block begin"
								ExecutePattern st_util.xpt_AddPlayerToEnemy
								//Say POSTAL
								RemoveAttr PlayerInvader
								Timer tCheckPlayerLoc,3,repeated
								State st_start
							Block end
						Block end
						
						ExecutePattern bh_base:st_idle.xpt_OnVisible
					}
				}
			}
		}
		
		st_util
		{
			Group Neutral
			Patterns
			{
				xpt_CheckPlayerLocation
				{
					actions
					{
						SetAttr "PlayerLeft 1"
						
						CheckAttr "LiveInHouseA Block begin"
							CheckAttr "slot#msGP.PlayerInHouseA RemoveAttr PlayerLeft"
						Block end
						
						CheckAttr "LiveInHouseB Block begin"
							CheckAttr "slot#msGP.PlayerInHouseB RemoveAttr PlayerLeft"
						Block end
						
						CheckAttr "LiveInGarage Block begin"
							CheckAttr "slot#msGP.PlayerInGarage RemoveAttr PlayerLeft"
						Block end
						
						CheckAttr "PlayerLeft Block begin"
							TargetPlayer 1
							Relationship target,neutral
							ResetTarget 1
							State st_start
						Block end
					}
				}
			}
		}
		
	}
	events
	{
		OnLiveInHouseA	"SetAttr LiveInHouseA 1"
		OnLiveInHouseB	"SetAttr LiveInHouseB 1"
		OnLiveInGarage	"SetAttr LiveInGarage 1"
		OnTimer_tCheckPlayerLoc "ExecutePattern st_util.xpt_CheckPlayerLocation"
	}
	
}

