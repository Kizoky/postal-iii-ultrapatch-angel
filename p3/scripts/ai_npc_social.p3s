		so_greet
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						CheckAttr "target.flag_bystander Block begin"
							CheckAttr "target.busy Pattern pt_end"
							SetAttr "busy 1"
							SetAttr "leader 1"
							Pattern pt_pregreet,pt_end
						Block end
						
						Pattern pt_end
					}
				}
				
				pt_pregreet
				{
					actions
					{
						CheckAttr "greet_sleazy Pattern pt_greet"
						SetAttr "greet_normal 1"
						Pattern pt_greet
					}
				}
				
				pt_greet
				{
					actions
					{
						Wait 0:1
						FireEvent SGreet
						LookAt true
						Gesture g_greet_normal
						Wait 0.2
						CheckAttr "greet_sleazy Say SLEEZ"
						CheckAttr "greet_normal Say GREET"
						//AreaEvent Greet,10000
						Wait 0.5
						FireEvent SGreetResponseOK
						Wait 5
						Pattern pt_end
					}
					events
					{
						OnFire_SGreetResponse "Pattern pt_chat,pt_end"
					}
				}
				
				pt_wait
				{
					actions
					{
						//ShowMessage "[Waiting],$P3Debug"
						//AreaEvent Waiting,10000
						SetAttr "busy 1"
						TargetCaller 1
						Wait 5
						FireEvent Cancel
						Pattern pt_end
					}
					events
					{
						OnFire_SGreetResponseOK "Pattern pt_response"
					}
				}
				
				pt_response
				{
					actions
					{
						//AreaEvent Response,10000
						//ShowMessage "[Responsing],$P3Debug"
						LookAt true
						Gesture g_greet_normal
						Wait 0.2
						CheckAttr "target.greet_normal Say GREET,GREETRESPONSE"
						CheckAttr "target.greet_sleazy Say SLEEZ,SLEAZYRESPONSE"
						Wait 0.2:0.3
						FireEvent SGreetResponse
						Wait 5
						Pattern pt_end
					}
					events
					{
						OnFire_SChatRequest "Pattern pt_chatok"
					}
				}
				
				pt_chat
				{
					actions
					{
						State so_chat
					}
				}
				
				pt_chatok
				{
					actions
					{
						//IfAttr "Visible:target == false Pattern pt_end"
						Wait 0.2
						FireEvent SChatResponse
						Pattern so_chat.pt_moveto
					}
				}
				
				pt_end
				{
					actions
					{
						CheckAttr "leader FireEvent Cancel"
						RemoveAttr "leader"
						RemoveAttr "greet_sleazy"
						RemoveAttr "greet_normal"
						IgnoreTarget 30
						LookAt false
						ResetTarget 1
						State st_start
					}
				}
				
				xpt_ReactionChange
				{
					actions
					{
						Pattern pt_end
					}
				}
			}
			events
			{
				OnFire_Cancel "IfAttr Object:caller == Object:target Pattern pt_end"
			}
		}
		
