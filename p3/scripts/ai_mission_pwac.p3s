				{
					actions
					{
						SetSquad Cops_squad_03
						SetSquadRelation Prison_squad_03:enemy:2,Player_squad:enemy:4
						ExecutePattern bh_base:st_util.xpt_OnSpawned_Battle03
					}
				}
				xpt_OnSpawned_Battle04
				{
					actions
					{
						SetSquad Cops_squad_04
						SetSquadRelation Prison_squad_04:enemy:2,Player_squad:enemy:4
						ExecutePattern bh_base:st_util.xpt_OnSpawned_Battle04
					}
				}
				xpt_OnSpawned_Battle05
				{
					actions
					{
						SetSquad Cops_squad_05
						SetSquadRelation Prison_squad_05:enemy:2,Player_squad:enemy:4
						ExecutePattern bh_base:st_util.xpt_OnSpawned_Battle05
					}
				}
				xpt_OnSpawned_Battle06
				{
					actions
					{
						SetSquad Cops_squad_06
						SetSquadRelation Prison_squad_06:enemy:2,Player_squad:enemy:4
						ExecutePattern bh_base:st_util.xpt_OnSpawned_Battle06
					}
				}
				xpt_OnSpawned_Battle07
				{
					actions
					{
						SetSquad Cops_squad_07
						SetSquadRelation Prison_squad_07:enemy:2,Player_squad:enemy:4
						ExecutePattern bh_base:st_util.xpt_OnSpawned_Battle07
					}
				}
				xpt_OnSpawned_Battle08
				{
					actions
					{
						SetSquad Cops_squad_08
						SetSquadRelation Prison_squad_08:enemy:2,Player_squad:enemy:4
						ExecutePattern bh_base:st_util.xpt_OnSpawned_Battle08
					}
				}
			}
		}
		
		st_deactivate
		{
			Group Alert
			Patterns
			{
				pt_default
				{
					actions
					{
						TargetToMem msTEMP
						TargetEntByName "npc_cop"
						IfAttr "Object:target != Object:self FireEvent CopDown"
						TargetFromMem msTEMP
						
						ExecutePattern bh_base:st_deactivate.pt_default
					}
				}
			}
		}
	}
	events
	{
		OnFire_CopDown "ExecutePattern st_util.xpt_OnCopDown"
	}
	
}

behavior
{
