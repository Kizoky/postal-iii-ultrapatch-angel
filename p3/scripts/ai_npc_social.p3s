		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						SetAttr "busy 1"
						ResetTarget 1
						FireInput self,HeadTurningOff
						FreeMovement false
						Pattern pt_inspect
					}
				}
				
				pt_inspect
				{
					actions
					{
						Sequence seq.env_inspect_ground,9000
						Wait 3:5
						
						IfAttr "VoicePrefix:self != String:HOBO and VoicePrefix:self != String:WHR Say INVESTIGATE"
						IfAttr "VoicePrefix:self == String:HOBO	Say WM_INVESTIGATE"
						IfAttr "VoicePrefix:self == String:WHR	Say WF_INVESTIGATE"
						
						Wait 3:3
						Pattern pt_end
					}
				}
				
				pt_end
				{
					actions
					{
						ResetSequence 1
						FireInput self,HeadTurningOn
						State st_start
					}
				}
				
				xpt_ReactionChange
				{
					actions
					{
						Pattern pt_end
					}
				}
			}
		}
		
		ev_fapfap
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						ResetTarget 1
						FireInput self,HeadTurningOff
						SetAttr "ea_status sGROSS"
						SetAttr "busy 1"
						Pattern pt_droch1
					}
				}
				
				pt_droch1
				{
					actions
					{
						Sequence seq.droch_slow,9000
						Wait 10:10
						Pattern pt_droch2
					}
				}
				
				pt_droch2
				{
					actions
					{
						Sequence seq.droch_med,9000
						Wait 30:20
						Pattern pt_droch3
					}
				}
				
				pt_droch3
				{
					actions
					{
						Sequence seq.droch_fast,9000
						Wait 15:15
						Pattern pt_finish
					}
				}
				
				pt_finish
				{
					actions
					{
						Say CHEER
						Sequence reaction_fun
						WaitForEnd 1
						Pattern pt_end
					}
				}
				
				pt_end
				{
					actions
					{
						SetAttr "ea_status sNEUTRAL"
						ResetSequence 1
						FireInput self,HeadTurningOn
						State st_start
					}
				}
				
				xpt_ReactionChange
				{
					actions
					{
						Pattern pt_end
					}
				}
			}
		}
		
		ev_xxxshop
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						CheckAttr "ImAMan State ev_interest,ev_fapfap"
						State ev_interest
					}
				}
			}
		}
		
		ev_shop
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						FireInput self,HeadTurningOff
						SetAttr "busy 1"
						Pattern pt_stay
					}
				}
				
				pt_stay
				{
					actions
					{
						Sequence idle_shopkeeper,9000
						Wait 30:60
						Repeat 0
					}
				}
				
				pt_end
				{
					actions
					{
						FireInput self,HeadTurningOn
						
						IfAttr "reaction < RE_DANGER Block begin"
							SetAttr "reaction RE_NONE"
							SetAttr "NewReaction RE_NONE"
						Block end
						
						State st_start
					}
				}
				
				xpt_ReactionChange
				{
					actions
					{	
						IfAttr "reaction >= RE_DANGER Pattern pt_end"
					}
				}
			}
		}

		
		st_feartarget
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						SetAttr "busy 1"
						ExecutePattern st_util.xpt_AddTargetToFear
						SetAttr "NewReaction RE_FEAR"
						State st_start
					}
				}
				
				xpt_ReactionChange
				{
					actions
					{
						IfAttr "reaction >= RE_FEAR State st_start"
					}
				}
			}
		}
		
		st_seeweapon
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						IfAttr "Object:target == Object:Player Block begin"
							IfAttr "slot#msGP.PlayerPath == PATH_GOOD Block begin"
								SetAttr "PlayerGood 1"
								CheckAttr "slot#msGP.PlayerBehaveBad RemoveAttr PlayerGood 1"
								
								CheckAttr "PlayerGood Block begin"
									RemoveAttr PlayerGood
									IgnoreTarget 10
									ResetTarget 1
									Pattern pt_end
								Block end
							Block end
						Block end
						
						SetAttr "busy 1"
						
						CheckTarget 1
						CheckLOS 1
						Wait 0.2
						Pattern pt_end
					}
					events
					{
						OnVisible	"Pattern pt_check"
						OnLOS		"Pattern pt_check"
					}
				}
				xpt_precheck
				{
					actions
					{
						Pattern pt_check
					}
				}
				pt_check
				{
					actions
					{
						CheckAttr "target.ea_ActiveWeapon Block begin"
							IfAttr "target.ea_ActiveWeapon == 0 Pattern pt_fistfight" //empty hands -
							IfAttr "target.ea_ActiveWeapon == 1 Pattern pt_ignore" //animals -
							IfAttr "target.ea_ActiveWeapon == 2 Pattern pt_ignore" //gadgets,grenades -
							IfAttr "target.ea_ActiveWeapon == 3 Pattern pt_ignore" //nonlethal melee -
							IfAttr "target.ea_ActiveWeapon == 4 Pattern pt_ignore" //nonlethal ranged -
							IfAttr "target.ea_ActiveWeapon == 5 Pattern pt_attack_melee" //,pt_fear" //lethal melee
							IfAttr "target.ea_ActiveWeapon == 6 Pattern pt_attack_ranged" //,pt_fear" //ranged
							IfAttr "target.ea_ActiveWeapon == 7 Pattern pt_fear" //scary ranged
						Block end
					}
				}
				
				pt_fistfight
				{
					actions
					{
						IfAttr "HasWeapon:ranged == 0 and HasWeapon:melee == 0 Block begin"
							CheckAttr "flag_IgnorePlayerAttack Block begin"
								CheckAttr "flag_IgnorePlayerFear Pattern pt_ignore"
								Pattern pt_prefear,pt_ignore
							Block end
							CheckAttr "flag_IgnorePlayerFear Pattern pt_attack,pt_ignore"
							Pattern pt_attack,pt_prefear,pt_ignore
						Block end
						
						CheckAttr "flag_IgnorePlayerAttack Pattern pt_ignore"
						Pattern pt_attack,pt_ignore
					}
				}
				
				pt_attack_melee
				{
					actions
					{
						IfAttr "target.ea_status != sKILLER Pattern pt_end"
						IfAttr "HasWeapon:ranged == 0 and HasWeapon:melee == 0 Block begin"
							CheckAttr "flag_IgnorePlayerFear Pattern pt_ignore"
							Pattern pt_prefear
						Block end
						CheckAttr "flag_IgnorePlayerAttack Pattern pt_ignore"
						Pattern pt_attack
					}
				}
				
				pt_attack_ranged
				{
					actions
					{
						IfAttr "HasWeapon:ranged == 0 Block begin"
							CheckAttr "flag_IgnorePlayerFear Pattern pt_ignore"
							Pattern pt_prefear
						Block end
						CheckAttr "flag_IngorePlayerAttack Pattern pt_ignore"
						Pattern pt_attack
					}
				}
				
				pt_attack
				{
					actions
					{
						ExecutePattern st_util.xpt_AddTargetToEnemy
						Pattern pt_end
					}
				}
				
				pt_prefear
				{
					actions
					{
						//IfAttr "AngleTo:target < 50 Pattern pt_fear,pt_moveaway"
						Pattern pt_fear
						//Pattern pt_moveaway
					}
				}
				
				pt_moveaway
				{
					actions
					{
						Face true
						//FreeMovement false
						FreeMovementParams area_all,-1,-1,area_group,move_from_target
						FreeMovement walk,reset
						Gesture g_dialogue_point
						Wait 0:1
						Say FEARFUL
						Wait 1.5:1.5
						Pattern pt_fear
					}
				}
				
				pt_fear
				{
					actions
					{
						ExecutePattern st_util.xpt_AddTargetToFear
						SetAttr "NewReaction RE_FEAR"
						Pattern pt_end
					}
				}
				
				pt_ignore
				{
					actions
					{
						IgnoreTarget 5
						ResetTarget 1
						Pattern pt_end
					}
				}
				
				pt_end
				{
					actions
					{
						Face false
						
						IfAttr "reaction <= RE_WEAPON Block begin"
							SetAttr "NewReaction RE_NONE"
							SetAttr "reaction RE_NONE"
						Block end
						
						State st_start
					}
				}
				
				xpt_ReactionChange
				{
					actions
					{
						IfAttr "reaction > RE_WEAPON Pattern pt_end"
					}
				}
			}
		}
		
		st_OnDeath
		{
			Group Alert
			Patterns
			{
				pt_default
				{
					actions
					{
						IfAttr "Object:caller == Object:Player Block begin"
							CheckAttr "flag_bystander Block begin"
								TargetFromMem msGP
								FireEvent PlayerKillBystander
								AreaEvent PlayerKillBystander,16
							Block end
						Block end
							
						
						ExecutePattern bh_base:st_OnDeath.pt_default
					}
				}
			}
		}
		
		st_OnUnconscious
		{
			Group Alert
			Patterns
			{
				pt_default:ignore_ext_events
				{
					actions
					{
						TargetCaller 1
						FireEvent DisabledMe
						
						Pattern bh_base:st_OnUnconscious.pt_default
					}
				}
			}
		}
		
		st_deactivate
		{
			Group Alert
			Patterns
			{
				pt_default
				{
					actions
					{
						IfAttr "Object:caller == Object:player Block begin"
							CheckAttr "flag_PlayerFriendly Block begin"
								TargetCaller 1
								SetAttr "target.NumFF FRIENDLY_FIRE_MAX"
								ExecutePattern st_util.xpt_AddTargetToEnemy
								SetSquadRelation player_squad:enemy:3
								RemoveAttr flag_PlayerFriendly
								ExecutePattern st_util.xpt_OnPlayerFailsFriendship
							Block end
						Block end
						
						ExecutePattern bh_base:st_deactivate.pt_default
					}
				}
			}
		}
		
		st_util
		{
			Group Neutral
			Patterns
			{
				xpt_OnNewReaction
				{
					actions
					{	
						IfAttr "NewReaction == RE_NONE Return 1"
						IfAttr "NewReaction <= ReactionThreshold SetAttr NewReaction RE_NONE"
						
						IfAttr "NewReaction == RE_WEAPON Block begin"
							CheckAttr "flag_IgnoreWeapon Block begin"
								SetAttr "NewReaction RE_NONE"
								Return 1
							Block end
							
							//bystanders do not fear dude, if he is good cop and carries weapon
							IfAttr "Object:caller == Object:player Block begin"
								//CheckAttr "flag_bystander Block begin"
								IfAttr "slot#msGP.PlayerPath == PATH_GOOD Block begin"
									SetAttr "NeedToIgnoreWeapon 1"
									CheckAttr "slot#msGP.PlayerBehaveBad RemoveAttr NeedToIgnoreWeapon"
									CheckAttr "NeedToIgnoreWeapon Block begin"
										RemoveAttr NeedToIgnoreWeapon
										SetAttr "NewReaction RE_NONE"
										Return 1
									Block end
								Block end
								//Block end
								IfAttr "slot#msGP.PlayerPath != PATH_GOOD SetAttr NewReaction RE_WEAPON"
							Block end
						Block end
						
						IfAttr "NewReaction == RE_COMBAT Block begin"
							CheckAttr "flag_IgnoreCombat Block begin"
								SetAttr "NewReaction RE_NONE"
								Return 1
							Block end
						Block end
						
						IfAttr "NewReaction == RE_DANGER Block begin"
							CheckAttr "flag_IgnoreCombat Block begin"
								SetAttr "NewReaction RE_NONE"
								Return 1
							Block end
						Block end
						
						IfAttr "NewReaction > reaction Block begin"
							SetAttr "reaction NewReaction"
							//SetAttr "NewReaction RE_NONE"
						Block end
						//SetAttr "NewReaction RE_NONE"
					}
				}
				
				xpt_OnReactionChange
				{
					actions
					{
						IfAttr "reaction == RE_NONE Return 1"
						//SetAttr "NewReaction RE_NONE"
						
						IfAttr "Object:target != Object:Null TargetToMem msTEMP"
						
						IfAttr "Object:caller != Object:Null Block begin"
							TargetCaller 1
							TargetToMem msTARGET
							IfAttr "Object:slot#msTEMP != Object:Null TargetFromMem msTEMP"
						Block end
						
						ClearMem msTEMP
						
						ExecutePattern xpt_ReactionChange
					}
				}
				
				xpt_ReactionChange
				{
					actions
					{
						State st_start
						//���� ������� �� ��������� �� ��� ����� ��������,
						//�� � ��� ������� ����� �� �� ������ � ������� ��������
					}
				}
				
				xpt_SayHit
				{
					actions
					{
						IfAttr "Timer:tHitSound > 0 Return 1"
						
						IfAttr "Object:caller == Object:player Block begin"
							CheckAttr "flag_PlayerFriendly Block begin"
								IfAttr "RelationTo:player == Relation:neutral Say FRIENDLYFIRE,HIT"
								IfAttr "RelationTo:player == Relation:enemy	Block begin"
									Say HIT
									RemoveAttr flag_PlayerFriendly
								Block end
								Timer tHitSound,3:3
								Return 1
							Block end
						Block end
						
						Say HIT
						Timer tHitSound,3:3
					}
				}
				
				xpt_CheckBump
				{
					actions
					{
						IfAttr "Object:Caller == Object:Player Block begin"
							IfAttr "Timer:tBump <= 0 and reaction < RE_BUMPED SetAttr NewReaction RE_BUMPED"
						Block end
					}
				}
				
				xpt_OnHit
				{
					actions
					{
						//EntFireInput caller,FireFSMScriptEvent:OnFire_HitedMe
						FireEvent HitedMe,caller
						
						CheckAttr "NotAttackedByPlayer Block begin"
							IfAttr "Object:caller == Object:player ExecutePattern st_util.xpt_OnAttackedByPlayer"
						Block end
						
						IfAttr "Object:caller == Object:player and caller.ea_ActiveWeapon == 0 Block begin"
							IfAttr "reaction != RE_KICKED AreaEvent FistFight,6"
							//�������, ����� ����� �������������� ��� ��������, � �� ��� ���������
						Block end
						
						IfAttr "Object:caller == Object:Player Block begin"
							IfAttr "RelationTo:caller == Relation:enemy RemoveAttr flag_PlayerFriendly"
							CheckAttr "flag_PlayerFriendly Block begin"
								TargetToMem msTEMP
								TargetCaller 1
								FireEvent FriendlyFire
								TargetFromMem msTEMP
								IfAttr "caller.NumFF == FRIENDLY_FIRE_MAX Block begin"
									Say FRIENDLYFIREFINAL
									TargetCaller 1
									ExecutePattern st_util.xpt_AddTargetToEnemy
									SetSquadRelation player_squad:enemy:3
									RemoveAttr flag_PlayerFriendly
									ExecutePattern st_util.xpt_OnPlayerFailsFriendship
									Return 1
								Block end
							Block end
						Block end
						
						IfAttr "Object:caller == Object:player Block begin"
							IfAttr "Object:target != Object:player and RelationTo:caller == Relation:enemy Block begin"
								TargetCaller 1
								IfAttr "TaskCombat != TC_NONE SetAttr FailType FAIL_INTERRUPT"
								//���� � ���, �� ����������� ���� � ������������ � �����
								//���� ���, �� ���� ��� ������ �� ����� ������ � ����� �����
							Block end
						Block end
						
						ExecutePattern st_util.xpt_SayHit
					}
				}
				
				xpt_AddTargetToEnemy
				{
					actions
					{
						IfAttr "Object:target == Object:Player ExecutePattern st_util.xpt_AddPlayerToEnemy"
						IfAttr "Object:target != Object:Player Relationship target,enemy,3"
					}
				}
				
				xpt_AddPlayerToEnemy
				{
					actions
					{
						TargetPlayer 1
						Relationship target,enemy,8
						CheckAttr "flag_bystander Timer tForgivePlayer,FORGIVE_TIMER_DEFAULT"
					}
				}
				
				xpt_AddTargetToFear
				{
					actions
					{
						IfAttr "Object:target == Object:Player ExecutePattern st_util.xpt_AddPlayerToFear"
						IfAttr "Object:target != Object:Player Relationship target,fear" 
					}
				}
				
				xpt_AddPlayerToFear
				{
					actions
					{
						TargetPlayer 1
						Relationship target,fear
						//CheckAttr "flag_bystander Timer tForgivePlayer,FORGIVE_TIMER_DEFAULT"
					}
				}
				
				xpt_OnPlayerFailsFriendship
				{
					actions
					{
						//�� ������� �����
					}
				}
				
				xpt_ForgivePlayer
				{
					actions
					{
						TargetToMem msTEMP
						TargetPlayer 1
						Relationship target,neutral
						ResetTarget 1
						TargetFromMem msTEMP
						ClearMem msTEMP
					}
				}
				
				xpt_OnAttackedByPlayer
				{
					actions
					{
						RemoveAttr NotAttackedByPlayer
					}
				}
				
				xpt_OnSeeWeapon
				{
					actions
					{
						IfAttr "Object:caller == Object:player Block begin"
							IfAttr "slot#msGP.PlayerPath != PATH_GOOD SetAttr NewReaction RE_WEAPON"
							IfAttr "slot#msGP.PlayerPath == PATH_GOOD Block begin"
								CheckAttr "PlayerBehaveBad SetAttr NewReaction RE_WEAPON"
							Block end
						Block end
						
						IfAttr "Object:caller != Object:player SetAttr NewReaction RE_WEAPON"
					}
				}
				
				xpt_OnStatusChange
				{
					actions
					{
						
					}
				}
			}
		}
		
	}
	events
	{
		OnFire_SeeCop				"ExecutePattern so_seecop.pt_default"
		OnFire_CopAggro				"ExecutePattern so_seecop.pt_copaggro"
		
		OnBump						"ExecutePattern st_util.xpt_CheckBump"
		OnKicked					"SetAttr NewReaction RE_KICKED"
		OnFallToGround				"IfAttr Object:caller == Object:Player SetAttr NewReaction RE_KICKED"
		OnNasty						"IfAttr Timer:tIgnoreNasty <= 0 SetAttr NewReaction RE_NASTY"
		OnSuperNasty				"IfAttr Timer:tIgnoreNasty <= 0 SetAttr NewReaction RE_NASTY"
		OnApplyCatnip				"IfAttr Timer:tIgnoreNasty <= 0 SetAttr NewReaction RE_NASTY"
		OnSnatched					"SetAttr NewReaction RE_SNATCHED"
		OnIgnite					"SetAttr NewReaction RE_IGNITE"
		OnBeeSting					"SetAttr NewReaction RE_STING"
		OnTasingStart				"SetAttr NewReaction RE_TASING"
		OnTased						"SetAttr NewReaction RE_TASED"
		OnSeeFlame					"SetAttr NewReaction RE_SEEFLAME"
		OnHearDanger 				"SetAttr NewReaction RE_DANGER"
		OnHearCombat 				"SetAttr NewReaction RE_COMBAT"
		OnAE_HasWeapon				"ExecutePattern st_util.xpt_OnSeeWeapon"
		OnAE_FistFight				"SetAttr NewReaction RE_COMBAT"
		OnSprayStunned				"SetAttr NewReaction RE_SPRAYED"
		OnBlinded					"SetAttr NewReaction RE_BLINDED"
		OnBatonShocked				"SetAttr NewReaction RE_STUNNED"
		OnStun						"SetAttr NewReaction RE_STUNNED"
		OnAttrChange_NewReaction	"IfAttr NewReaction != RE_NONE ExecutePattern st_util.xpt_OnNewReaction"
		OnAttrChange_reaction		"IfAttr reaction != RE_NONE ExecutePattern st_util.xpt_OnReactionChange"
		OnAttrChange_ea_status		"ExecutePattern st_util.xpt_OnStatusChange"
		OnHit						"ExecutePattern st_util.xpt_OnHit"
		OnTimer_tForgivePlayer		"ExecutePattern st_util.xpt_ForgivePlayer"
		
		//model-related attributes
		OnImAMan			"SetAttr ImAMan 1"
		OnIHaveCell			"SetAttr IHaveCell 1"
		OnImOld				"SetAttr ImOld 1"
		OnImWalker			"SetAttr ImWalker 1"
		OnICanLean			"SetAttr ICanLean 1"
	}
}




behavior
{
	name bh_civil
	inherited bh_military_new
	
	States
	{
		st_InterestCombat
		{
			Group Alert
			Patterns
			{
				pt_reaction 
				{
					actions 
					{
						Face false
						IfAttr "ea_Faction == target.ea_Faction Block begin"	// � ��� ������ ����- ������� �� ������, ��� ��� ����� ���� ������ �����, � ������������� ��� ��� �������� ���������				
							State ut_assist
						Block end
						IfAttr "ea_Faction != target.ea_Faction Block begin"  // � ��� ������ �������- ������� �� �� �����
							Relationship target,enemy
						Block end
						State st_start
					}
				}
				xpt_ReactionChange
				{
					actions
					{
						IfAttr "reaction >= RE_SNATCHED State st_start"
					}
				}
			}
		}
	}
}




behavior
{
	name bh_police
	inherited bh_civil
	States
	{
		st_init
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern bh_base:st_init.pt_default
						
						SetAttr "flag_IgnorePlayerFear 1"
						SetAttr "ReactionThreshold RE_DANGER"
						
						IfAttr "slot#msGP.PlayerPath == PATH_GOOD Block begin"
							SetAttr "flag_IgnorePlayerAttack 1"
							SetAttr "flag_PlayerFriendly 1"
							SetAttr "ea_takeable 0"
						Block end
						
						SetSquad Police_squad
						
						SetAttr "scolded SCOLD_NONE,on_change_event"
					}
				}
			}
		}
		st_combat_logic
		{
			Group Combat
			Patterns
			{
				xpt_SetTaskDefault
				{
					actions
					{
						SetAttr "combat_rnd 0"
						ChangeAttr "combat_rnd 0:1"
						
						IfAttr "combat_rnd == 0 SetAttr TaskCombat TC_POSITION"
						IfAttr "combat_rnd == 1 SetAttr TaskCombat TC_MOVE"
					}
				}
			}
		}
		so_seehobo
		{
			group Neutral
			patterns
			{
				pt_default
				{
					actions
					{
						//TargetCaller 1
						
						CheckAttr "target.busy Pattern pt_scold"
						pattern pt_end
					}
				}
				
				pt_scold
				{
					actions
					{
						FreeMovement false
						Face true
						Sequence seq.agitate_civil
						Say SEEWRONGACT
						Wait 1:2
						FireEvent SeeCop
						Wait 1:2
						Pattern pt_end
					}
				}
				
				pt_end
				{
					actions
					{
						IgnoreTarget 20
						ResetTarget 1
						
						Face false
						State st_start
					}
				}
				
				xpt_ReactionChange
				{
					actions
					{
						IfAttr "reaction >= RE_NASTY Pattern pt_end"
					}
				}
			}
		}
		
		st_idle
		{
			Group Neutral
			Patterns
			{
				pt_decide
				{
					actions
					{
						SetAttr "busy 1"
						Pattern pt_idle
					}
				}
				
				xpt_OnVisible
				{
					actions
					{
						TargetCaller 1
						
						IfAttr "target.ea_armed == WPN_BADGER and target.ea_status <= sPUNISHER Block begin"
							Say SEEBADGER
							IgnoreTarget 8
							ResetTarget 1
							Return 1
						Block end
						
						IfAttr "Object:target == Object:player and slot#msGP.PlayerPath == PATH_GOOD Block begin"
							CheckAttr "slot#msGP.PlayerBehaveBad StateMatrix faction"
							IgnoreTarget 5
							ResetTarget 1
							Return 1
						Block end
						
						IfAttr "Object:target == Object:slot#msSUSPECTED Block begin"
							ExecutePattern st_util.xpt_AddTargetToEnemy
							State st_start
						Block end
						
						ExecutePattern bh_base:st_idle.xpt_OnVisible
					}
				}
				
				xpt_OnSeeWrongAct
				{
					actions
					{
						IfAttr "scolded >= SCOLD_WRONG Return 1"
						SetAttr "scolded SCOLD_WRONG"
						TargetCaller 1
						State so_scold
					}
				}
				
				xpt_OnSeeBrutalAct
				{
					actions
					{
						IfAttr "scolded >= SCOLD_BRUTAL Return 1"
						SetAttr "scolded SCOLD_BRUTAL"
						TargetCaller 1
						State so_scold
					}
				}
				
				xpt_OnPlayerKillBystander
				{
					actions
					{
						IfAttr "ea_health <= 0 Return 1"
						TargetPlayer 1
						
						IfAttr "slot#msGP.PlayerPath != PATH_GOOD Block begin"
							Say DISOBEYED
							ExecutePattern st_util.xpt_AddTargetToEnemy
							State st_start
						Block end
						
						IfAttr "slot#msGP.PlayerPath == PATH_GOOD Block begin"
							CheckAttr "slot#msGP.PlayerBehaveBad Block begin"
								ExecutePattern st_util.xpt_AddTargetToEnemy
								State st_start
							Block end
							
							IfAttr "scolded >= SCOLD_WARN Return 1"
							SetAttr "scolded SCOLD_WARN"
							State so_scold
						Block end
					}
				}
				
				xpt_OnPlayerKillPoliceman
				{
					actions
					{
						IfAttr "ea_health <= 0 Return 1"
						Face false
						TargetPlayer 1
						Say SEESDEADCOP
						SetSquadRelation player_squad:enemy:3
						ExecutePattern st_util.xpt_AddTargetToEnemy
						State st_start
					}
				}
			}
			events
			{
				OnAE_WrongAct	"ExecutePattern .xpt_OnSeeWrongAct"
				OnAE_BrutalAct	"ExecutePattern .xpt_OnSeeBrutalAct"
				
				OnAE_PlayerKillBystander	"ExecutePattern .xpt_OnPlayerKillBystander"
				OnAE_PlayerKillPoliceman	"ExecutePattern .xpt_OnPlayerKillPoliceman"
			}
		}
		so_scold
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						TargetCaller 1
						
						FreeMovement false
						Pattern pt_face
					}
				}
				
				pt_face
				{
					actions
					{
						IfAttr "AngleTo:target < 30 Pattern pt_scold"
						
						Face true
						Wait 0.3
						Face false
						
						Repeat 0
					}
				}
				
				pt_scold
				{
					actions
					{
						IfAttr "DistTo:target > ED_FAR Pattern pt_end"
						
						ExecutePattern .xpt_SayScold				
						Sequence agitate_common
						WaitForEnd 1
						
						Pattern pt_end
					}
				}
				
				pt_attack
				{
					actions
					{
						Say DISOBEYED
						ExecutePattern st_util.xpt_AddTargetToEnemy
						SetSquadRelation player_squad:enemy:3
						SetAttr "attacking 1"
						Pattern pt_end
					}
				}
				
				pt_end
				{
					actions
					{
						Face false
						
						CheckAttr "attacking Block begin"
							RemoveAttr attacking
							State st_start
						Block end
						
						IgnoreTarget 10
						ResetTarget 1
						
						State st_start
					}
				}
				
				xpt_SayScold
				{
					actions
					{
						IfAttr "scolded == SCOLD_WRONG Say SEEBAD,SEEWRONGACT"
						IfAttr "scolded == SCOLD_WARN Say WARNPLAYER"
						IfAttr "scolded == SCOLD_BRUTAL Block begin"
							IfAttr "slot#msGP.PlayerPath != PATH_GOOD FireEvent Brutality"
							IfAttr "target.Brutality == BRUTALITY_MAX Pattern pt_attack"
							IfAttr "slot#msGP.PlayerPath != PATH_GOOD Say SEEBRUTALACT"
							IfAttr "slot#msGP.PlayerPath == PATH_GOOD Say SEEBRUTALACT,WARNPLAYER"
						Block end
					}
				}
				
				xpt_ReactionChange
				{
					actions
					{
						Pattern pt_end
					}
				}
			}
			events
			{
				OnAE_PlayerKillPoliceman	"ExecutePattern st_idle.xpt_OnPlayerKillPoliceman"
			}
		}
		st_seeweapon
		{
			Group Alert
			Patterns
			{
				pt_default
				{
					actions
					{
						State so_warn
					}
				}
				xpt_precheck
				{
					actions
					{
						IfAttr "slot#msGP.PlayerPath == PATH_GOOD Block begin"
							CheckAttr "slot#msGP.PlayerBehaveBad Pattern pt_check"
							Return 1
						Block end
						
						IfAttr "slot#msGP.PlayerPath != PATH_GOOD Pattern pt_check"
					}
				}
			}
		}
		so_warn
		{
			Group Alert
			Patterns
			{
				pt_default
				{
					actions
					{
						IfAttr "target.ea_Faction == Faction:Police Block begin"
							IfAttr "target.Object:target == Object:Null Pattern pt_end"
							AssistTarget 1
						Block end
						
						SetAttr "NumWarns 0,0,4"
						FreeMovement false
						CheckTarget 1
						Wait 1
						Pattern pt_face
					}
					events
					{
						OnVisible "Pattern pt_prepare"
						OnLost		"Pattern pt_face"
					}
				}
				
				pt_face
				{
					actions
					{
						IfAttr "AngleTo:target < 30 Block begin"
							CheckTarget 1
							Wait 1
							Pattern pt_moveto
						Block end
						
						Face true
						Wait 0.5
						Face false
						
						Repeat 0
					}
					events
					{
						OnVisible	"Pattern pt_prepare"
						OnLost		"Pattern pt_moveto"
					}
				}
				
				pt_moveto
				{
					actions
					{
						MoveToTarget run,0,0
						Timer tWarnMove,15
						Pattern pt_moveloop
					}
				}
				
				pt_moveloop
				{
					actions
					{
						IfAttr "Timer:tWarnMove <= 0 Pattern pt_end"
						CheckTarget 1
						Repeat 1
					}
					events
					{
						OnVisible "Pattern pt_prepare"
					}
				}
				pt_prepare
				{
					actions
					{
						MoveToTarget false
						FreeMovement false
						LookAt true
						Face true
						IfAttr "HasWeapon:ranged == 1 Block begin"
							Weapon select,ranged
							Wait 1
						Block end
						IfAttr "HasWeapon:ranged == 2 Aim true"
						//SetAttr "visible 1"
						//SetAttr "NewReaction RE_WEAPON"
						//��� ��� ����� ������ ���� �����������?
						FreeMovementParams area_all,0,ED_CLOSE,from_target
						FreeMovement true
						Timer tUpdate,2,repeated
						ExecutePattern .xpt_update
						Pattern pt_warn
					}
				}
				pt_warn
				{
					actions
					{
						IfAttr "NumWarns <= 1 Say FREEZE,GETDOWN,SEEWEAPON"
						IfAttr "NumWarns > 1 and NumWarns < 4 Say DROPWEAPON,ARREST,GETDOWN"
						ChangeAttr "NumWarns +1"
						//FireEvent CopAggro
						Repeat 5
					}
				}
				
				pt_attack
				{
					actions
					{
						AvoidProhibitedArea false
						//�� ������ �������� ������
						IfAttr "target.ea_Faction == Faction:Police Block begin"
							IfAttr "target.Object:target == Object:Null Pattern pt_end"
							AssistTarget 1
						Block end
						
						Say DISOBEYED
						ExecutePattern st_util.xpt_AddTargetToEnemy
						
						Pattern pt_end
					}
				}
				
				pt_cancel
				{
					actions
					{
						Face false
						LookAt false
						Aim false
						FreeMovement false
						MoveToTarget false
						Weapon disarm
						Wait 1
						
						Pattern pt_end
					}
				}
				
				pt_end
				{
					actions
					{
						IfAttr "reaction < RE_NASTY Block begin"
							SetAttr "NewReaction RE_NONE"
							SetAttr "reaction RE_NONE"
						Block end
						IfAttr "reaction == RE_WEAPON Block begin"
							SetAttr "NewReaction RE_NONE"
							SetAttr "reaction RE_NONE"
						Block end
						SetAttr "NumWarns 0,0,4"
						//RemoveAttr visible
						IfAttr "RelationTo:target == Relation:enemy State st_start"
						Aim false
						State st_start
					}
				}
				xpt_update
				{
					actions
					{
						IfAttr "target.ea_status == sNEUTRAL Pattern pt_cancel"
						IfAttr "target.ea_status == sKILLER Pattern pt_attack"
						CheckAttr "target.active Return 1"
						Pattern pt_cancel
					}
				}
				
				xpt_ReactionChange
				{
					actions
					{
						IfAttr "reaction >  RE_WEAPON Pattern pt_end"
						IfAttr "reaction == RE_KICKED Pattern pt_end"
					}
				}
			}
			events
			{
				OnTargetReset 		"Pattern pt_cancel"
				OnTargetUnconscious "Pattern pt_cancel"
				OnTargetArrested	"Pattern pt_cancel"
				OnTimer_tUpdate "ExecutePattern .xpt_update"
				OnAttrMax_NumWarns "Pattern pt_attack"
			}
		}
		so_seecorpse
		{
			Group Alert
			Patterns
			{
				pt_default
				{
					actions
					{
						HeadBlob 1,attention
						
						IfAttr "target.Object:target != Object:null Block begin"
							TargetToMem msTEMP
							AssistTarget 1
							ExecutePattern .xpt_CheckJustice
							TargetFromMem msTEMP
						Block end
						
						ExecutePattern bh_base:so_seecorpse.pt_default
					}
				}
				pt_decide
				{
					actions
					{
						Pattern pt_investigate,pt_warn
					}
				}
				
				pt_investigate
				{
					//����������� ����
					actions
					{
						Sequence seq.env_inspect_ground,5
						Wait 1:1
						Say INVESTIGATE
						Wait 1:1
						ResetSequence 1
						
						Pattern pt_search
					}
				}
				
				pt_warn
				{
					//����� ����� � ������ � ������� ��������, ��� �� ��� �� �� ��� ��������
					actions
					{
						ResetTarget 1
						FreeMovementParams area_all,ED_VERY_CLOSE,ED_MIDDLE,from_target
						Timer tSearch,15:10
						Pattern pt_warn_loop
					}
				}
				
				pt_warn_loop
				{
					actions
					{
						FreeMovement walk
						
						IfAttr "Timer:tCanSay <= 0 Block begin"
							Timer tCanSay,5:3
							Say SEARCH
						Block end
						
						Repeat 5
					}
					events
					{
						OnTimer_tSearch "Pattern pt_search"
					}
				}
				
				pt_search
				{
					actions
					{
						SetAttr "TaskCombat TC_SEARCH"
						Pattern pt_end
					}
				}
				
				pt_end
				{
					actions
					{
						IfAttr "target.ea_status == sCORPSE Block begin"
							IgnoreTarget 50
							ResetTarget 1
						Block end
						
						ResetSequence 1
						FreeMovement false
						MoveToTarget false
						LookAt false
						
						State st_start
					}
				}
				
				xpt_OnVisible
				{
					actions
					{
						TargetCaller 1
						
						IfAttr "Object:caller == Object:slot#msSUSPECTED Block begin"
							Relationship target,enemy,3
							SetAttr "TaskCombat TC_NONE"
							Pattern pt_end
						Block end
						
						CheckAttr "target.flag_bystander Block begin"
							IfAttr "Timer:tCanSay <= 0 Block begin"
								Timer tCanSay,5
								Say WARNPEOPLE
							Block end
						Block end
						
						IgnoreTarget 10
						ResetTarget 1
					}
				}
				
				xpt_CheckJustice
				{
					actions
					{
						IfAttr "target.ea_faction == Faction:Police Return 1"
						IfAttr "Object:target == Object:player and slot#msGP.PlayerPath == PATH_GOOD Return 1"
						//���� ����� ����� ���� �����, ��� � ��� KOS
						
						TargetToMem msSUSPECTED
						Timer tForgiveSuspect,COP_TIMER_SUSPECT_DEFAULT
					}
				}
			}
			events
			{
				OnVisible "ExecutePattern .xpt_OnVisible"
			}
		}
		st_war
		{
			group Alert
			patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern st_util.xpt_AddTargetToEnemy
						State st_start
					}
				}
			}
		}
		st_OnDeath
		{
			Group Alert
			Patterns
			{
				pt_default
				{
					actions
					{
						IfAttr "Object:caller == Object:player Block begin"
							TargetFromMem msGP
							FireEvent PlayerKillPoliceman
							AreaEvent PlayerKillPoliceman,16
						Block end
						
						ExecutePattern bh_base:st_OnDeath.pt_default
					}
				}
			}
		}
		st_util
		{
			Group Neutral
			Patterns
			{
				xpt_ResetScold
				{
					actions
					{
						SetAttr "scolded SCOLD_NONE"
					}
				}
			}
		}
		ChangeKarma
		{
			Group Neutral
			Patterns
			{
				NonLethal
				{
					actions
					{
						IfAttr "slot#msGP.PlayerPath == PATH_GOOD Block begin"
							PlayerKarma -KARMA_MED
						Block end
					}
				}
			}
		}
	}
	events
	{
		OnHearCombat "SetAttr NewReaction RE_WEAPON"
		//OnHearDanger "SetAttr NewReaction RE_WEAPON"
		OnTimer_tForgiveSuspect "ClearMem msSUSPECTED"
		OnTimer_tResetScold	"ExecutePattern st_util.xpt_ResetScold"
		OnAttrChange_scolded	"IfAttr scolded != SCOLD_NONE Timer tResetScold,8"
	}
}

behavior
{
	name bh_goodpath_cop
	inherited bh_police
}


behavior
{
	name bh_hub2_civil
	inherited bh_civil
	States
	{
		st_init
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern bh_base:st_init.pt_default
						SetAttr "flag_bystander 1"
						
						SetSquadRelation taliban_squad:fear,local
					}
				}
			}
		}
		
		st_idle
		{
			Group Neutral
			Patterns
			{
				xpt_SetHintGroup
				{
					actions
					{
						CheckAttr "flag_static Return 1"
						
						IfAttr "ea_manner != Manner:LowLife Block begin"
							SetHintGroup wish_fun_idle
							CheckAttr "IHaveCell SetHintGroup wish_fun_idle,wish_fun_phone"
							CheckAttr "ImAMan SetHintGroup wish_fun_idle,wish_fun_phone,wish_fun_man"
						Block end
						
						IfAttr "ea_manner == Manner:LowLife Block begin"
							SetHintGroup wish_fun_hobo
							CheckAttr "ImAMan SetHintGroup wish_fun_hobo,wish_fun_man"
						Block end
					}
				}
				
				xpt_SetHintParams
				{
					actions
					{
						FreeMovementParams hint_all,ED_CLOSE,ED_VERY_FAR,hint_group,hint_face,use_node,once
						CheckAttr "flag_static FreeMovementParams hint_all,-1,-1,hint_group,hint_face,use_node,nearest,once"
					}
				}
				
			}
		}
	}
}

behavior
{
	name bh_hub2_civil_static
	inherited bh_hub2_civil
	States
	{
		st_init
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern bh_base:st_init.pt_default
						SetAttr "flag_static 1"
					}
				}
			}
		}
	}
}