behavior
{
	name bh_mission_dlg
	inherited bh_mission_logic_base
	States
	{
		st_init
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						SetAttr "PlayerPath PATH_GOOD"
					}
				}
			}
		}
		
		st_start
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						PlayerKarma show
						ShowMessage #P3_DLG_MSG1
						MissionLog "add_primary,find,#P3_DLG_PRI1"
						MissionLog "add_secondary,gays,#P3_DLG_SEC1"
					}
				}
			}
		}
		
		st_util
		{
			Group Neutral
			Patterns
			{
				xpt_maze
				{
					actions
					{
						EntFireInput talib_spawner_02,enable
						EntFireInput gay_spawner_02,enable
						EntFireInput mom_spawner_02,enable
					}
				}
				
				xpt_entrance
				{
					actions
					{
						State st_bossfight
					}
				}
				
				xpt_OnGayKilled
				{
					actions
					{
						SetAttr "DudeIsBad 1"
						MissionLog fail,gays
					}
				}
			}
		}
		
		st_bossfight
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						SetAttr "TalibanAttacksPlayer 1"
						PlayVideo dlg_2,1,1
						Wait 0.9
						EntFireInput boss_ron_spawner,enable
						EntFireInput boss_dave_spawner,enable
						EntFireInput boss_osama_spawner,enable
						EntFireInput talib_spawner_03,enable
						SetAttr "BossCount 3,0,3"
						Wait 0.1
						EntFireInput boss_teleport,Teleport
						MissionLog done,find
						MissionLog "add_primary,dave,#P3_DLG_PRI2"
						MissionLog "add_primary,ron,#P3_DLG_PRI3"
						MissionLog "add_primary,osama,#P3_DLG_PRI4"
					}
				}
			}
		}
		
		st_end
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						//MissionLog done,nab
						EntFireInput fade_in,fade
						Wait 1
						EntFireInput "pcc,Command:video_exitcmd dlg_3 p3_end_mission"
					}
				}
			}
		}
		
	}
	events
	{
		OnActivated_Maze			"ExecutePattern st_util.xpt_maze"
		OnActivated_Entrance	"ExecutePattern st_util.xpt_entrance"
		OnFire_BossDead				"ChangeAttr BossCount -1"
		OnAttrMin_BossCount		"State st_end"
		OnDudeEscaped					"ShowMessage #P3_DLG_MSG2"
		
		OnFire_DaveKilled					"MissionLog done,dave"
		OnFire_RonKilled					"MissionLog done,ron"
		OnFire_OsamaKilled				"MissionLog done,osama"
		
		OnFire_DudeKillsGay		"ExecutePattern st_util.xpt_OnGayKilled"
		
		OnNewGame		"ExecutePattern weaponGive.DLG"
	}
	
}



behavior
{
	name bh_mission_dli
	inherited bh_mission_logic_base
	States
	{
		st_init
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						SetAttr "PlayerPath PATH_INSANE"
						SetAttr "DudeIsBad 1"
					}
				}
			}
		}
		
		st_start
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						PlayerKarma show
						ShowMessage #P3_DLI_MSG1
						MissionLog "add_primary,escape,#P3_DLI_PRI1"
					}
				}
			}
		}
		
		st_end
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						EntFireInput lpp,Say:ENDEVENTINSANE
						Wait 1
						EntFireInput muzak.mission,FadeOut:1
						MissionLog done,escape
						//EntFireInput Fade_in,fade
						//Wait 1
						//EntFireInput "pcc,Command:video_exitcmd dli_2 p3_end_mission"
						EndMission 1
					}
				}
			}
		}
		
		st_util
		{
			Group Neutral
			Patterns
			{
				xpt_maze
				{
					actions
					{
						EntFireInput talib_spawner_02,enable
						EntFireInput gay_spawner_02,enable
						EntFireInput mom_spawner_02,enable
					}
				}
				
				xpt_entrance
				{
					actions
					{
						EntFireInput talib_spawner_03,enable
						EntFireInput gay_spawner_03,enable
						EntFireInput mom_spawner_03,enable
					}
				}
			}
		}
		
	}
	events
	{
		OnActivated_Maze		"ExecutePattern st_util.xpt_maze"
		OnActivated_Entrance	"ExecutePattern st_util.xpt_entrance"
		OnDudeEscaped			"State st_end"
		
		OnNewGame				"ExecutePattern weaponGive.DLI"
	}
}



behavior
{
	name bh_dl_civil
	inherited bh_civil
	States
	{
		st_init
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern bh_base:st_init.pt_default
						SetAttr "flag_bystander 1"
					}
				}
			}
		}
		
	}
}


behavior
{
	name bh_dl_military
	inherited bh_civil
	
	States
	{
		st_init
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern bh_base:st_init.pt_default
						
						SetAttr "flag_IgnorePlayerAttack 1"
						SetAttr "flag_IgnorePlayerFear 1"
						SetAttr "flag_IgnoreWeapon 1"
						SetAttr "flag_IgnoreCombat 1"
						SetAttr "flag_Protected 1"
						SetAttr "ReactionThreshold RE_DANGER"
					}
				}
			}
		}
		st_idle
		{
			Group Neutral
			Patterns
			{
				pt_decide
				{
					actions
					{
						Pattern pt_idle
					}
				}
				
				xpt_SelectWeapon
				{
					actions
					{
						//пусто
					}
				}
				
				xpt_OnHearCombat
				{
					actions
					{
						IfAttr "RelationTo:caller == Relation:enemy Block begin"
							TargetCaller 1
							State st_start
						Block end
					}
				}
				
				xpt_OnVisible
				{
					actions
					{
						TargetCaller 1
						IfAttr "target.ea_status == sCORPSE and Object:target != Object:Player Block begin"
							IgnoreTarget 100
							ResetTarget 1
							Return 1
						Block end
						
						IfAttr "RelationTo:target == Relation:enemy State st_start"
						IgnoreTarget 5
						ResetTarget 1
					}
				}
			}
			events
			{
				OnHearCombat "ExecutePattern .xpt_OnHearCombat"
			}
		}
	}
}

behavior
{
	name bh_dl_talib
	inherited bh_dl_military
	
	States
	{
		st_init
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern bh_base:st_init.pt_default
						SetSquad Taliban_Squad
						SetSquadRelation Player_Squad:enemy:3,Mom_Squad:enemy:1,Gay_Squad:enemy:1
						
						SetAttr "flag_VitalEnemy 1"
					}
				}
			}
		}
		
		st_idle
		{
			Group Neutral
			Patterns
			{
				pt_decide
				{
					actions
					{
						CheckAttr "slot#msGP.TalibanAttacksPlayer Pattern pt_runtoplayer"
						ExecutePattern bh_base:st_idle.pt_decide
					}
				}
				
				pt_runtoplayer
				{
					actions
					{
						TargetPlayer 1
						MoveToTarget run,0
						Repeat 5
					}
				}
				
				xpt_OnNewEnemy
				{
					actions
					{
						MoveToTarget false
						ExecutePattern bh_base:st_idle.xpt_OnNewEnemy
					}
				}
				
				xpt_WeaponSelect
				{
					actions
					{
						Weapon select,ranged
					}
				}
			}
		}
		
		st_combat_logic
		{
			Group Combat
			Patterns
			{
				xpt_SayShoot
				{
					actions
					{
						IfAttr "Timer:tCanSay > 0 Return 1"
						Say REBEL
						Timer tCanSay,5:3
					}
				}
			}
		}
	}
	
}

behavior
{
	name bh_dl_mom
	inherited bh_dl_military
	
	States
