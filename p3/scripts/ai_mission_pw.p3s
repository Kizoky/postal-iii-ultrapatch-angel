	events
	{
		OnHearDanger		"SetAttr NewReaction RE_COMBAT"
		OnVisible			"ExecutePattern st_start.xpt_checkmom"
		OnAE_MomShot		"ExecutePattern st_start.xpt_momshot"
		OnFire_IKillU		"SetAttr NewReaction RE_FEAR"
		OnTimer_tCalmdown	"ExecutePattern st_alert.pt_calm"
		OnAE_MomIsHere		"SetAttr NewReaction RE_FEAR"
	}
