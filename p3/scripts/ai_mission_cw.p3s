		st_util
		{
			Group Neutral
			Patterns
			{
				xpt_OnDamaged
				{
					actions
					{
						IfAttr "Object:Caller == Object:Player Relationship caller,enemy,5"
						IfAttr "Name:caller == String:npc_champ Block begin"
							TargetCaller 1
							AreaEvent DogAttack,8
							Relationship caller,enemy,2
						Block end
					}
				}
				
				xpt_OnDogAttack
				{
					actions
					{
						IfAttr "LeadingDog == 1 Block begin"
							TargetToMem msTEMP
						Block end
						
						TargetCaller 1
						AssistTarget 1
						Relationship target,enemy,2
						
						IfAttr "LeadingDog == 1 Block begin"
							TargetFromMem msTEMP
							Return 1
						Block end
						
						State st_start
					}
				}
			}
		}
		
		st_deactivate
		{
			Group Alert
			
			Patterns
			{
				pt_default
				{
					actions
					{
						SetAttr "LeadingDog 0"
						TargetFromMem msGP
						FireEvent SushiDead
						
						IfAttr "Object:caller == Object:Player AreaEvent PlayerKills,ED_MIDDLE"
						
						ExecutePattern bh_base:st_deactivate.pt_default
					}
				}
			}
		}
		
	}
	events
	{
		OnDamaged "ExecutePattern st_util.xpt_OnDamaged"
		OnAE_DogAttack "ExecutePattern st_util.xpt_OnDogAttack"
	}
	
}



behavior
{
	name bh_cw_civil
	inherited bh_civil
	States
	{
		st_init
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern bh_base:st_init.pt_default
						SetAttr "flag_bystander 1"
					}
				}
			}
		}
		st_idle
		{
			Group Neutral
			Patterns
			{
				xpt_SetAreaGroup
				{
					actions
					{
						SetAreaGroup AG_FLOOR1,AG_FLOOR2,AG_DEFAULT
					}
				}
				
				xpt_SetHintGroup
				{
					actions
					{
						SetHintGroup wish_fun_idle
					}
				}
			}
		}
		
	}
}