Constants
{
	Const RE_NONE,0
	Const RE_SEEFLAME,1 // +
	Const RE_BUMPED,2 // +
	Const RE_DANGER,3 // +
	
	Const RE_NASTY,4 // +
	Const RE_COMBAT,5 // +
	Const RE_WEAPON,6 // +
	
	Const RE_PUKE,7 // +
	Const RE_FEAR,8  // +
	Const RE_PAINT,9 // for paparazzis in city hall
	
	Const RE_KICKED,10 // +
	Const RE_SNATCHED,11 // +
	Const RE_SPRAYED,12 // +
	Const RE_STING,13
	Const RE_IGNITE,14 // +
	Const RE_STUNNED,15 //+
	Const RE_TASED,16 // +
	Const RE_TASING,17 // +
	Const RE_BLINDED,18

	Const NPC_PUKE_CHANSE,50
	Const NPC_CALL_CHANSE,7
	
	Const SPRAY_DMG_DEFAULT,50
	Const SPRAY_UNSTUN_TIMER,5
	Const BLINDED_UNSTUN_TIMER,5
	
	Const FORGIVE_TIMER_DEFAULT,30
	Const NASTY_TIMER_DEFAULT,8
	Const NASTY_TIMER_SPREAD_DEFAULT,5
	
	Const COP_TIMER_SUSPECT_DEFAULT,120
	
	Const SCOLD_NONE,0
	Const SCOLD_WRONG,1
	Const SCOLD_WARN,2
	Const SCOLD_BRUTAL,3
	
	Const FRIENDLY_FIRE_MAX,5
	Const FRIENDLY_FIRE_DECREASE_TIMER,10
	Const FRIENDLY_FIRE_BLOCK_TIMER,2
	
	Const BEES_FEAR_TIMER_DEFAULT,8
}


// social:
// + greets
// + sleazy greets
// + chats
// + cellphones
// + see pissing
// + see person in flame
// + see wang
// + see corpse
// + see corpse (cop)
// + see animal
// + see cat
// + pissing
// + waiting (watching clock)
// + see weapon (cop)
// + see wrong/brutal act (cop)
// + cop battle sounds (arrest, miranda etc.)
// + on hit


behavior
{
	name bh_social
	inherited bh_human
	
	States
	{
		st_init
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern bh_base:st_init.pt_default
						
						//AvoidProhibitedArea true
						
						SetAttr "LoveAnimals 0,0,1"
						ChangeAttr "LoveAnimals 0:1"
						
						IfAttr "ea_faction == Faction:Zealots SetAttr LoveAnimals 1"
						
						SetAttr "reaction RE_NONE,0,31,on_change_event"
						SetAttr "NewReaction RE_NONE,0,31,on_change_event"
						SetAttr "ReactionThreshold RE_NONE,0,31"		//npc will never react for reaction with lower leve
						SetAttr "ReactionIgnoreLevel RE_NONE,0,31"	//used in reaction states to determine wich reaction npc
																												//will remember after current is finished
						SetAttr "NotAttackedByPlayer 1"
						SetAttr "FirstRun 1"
						SetAttr "ea_takeable 1"
						SetAttr "NumStartLoops 0"
						SetAttr "ActualNumEnemy 0"
						//SetAttr "NumFF 0,0,FRIENDLY_FIRE_MAX"
						
						//FLAGS
							//SetAttr "flag_IgnoreWeapon 1"  //if set, NPC can't be scared by weapons
							//SetAttr "flag_IgnoreCombat 1"	//if set, NPC will ignore combat and danger it hears
							//SetAttr "flag_IgnorePlayerAttack 1"	//if set, NPC don't attack player after his unapropriate behavior
							//SetAttr "flag_IgnorePlayerFear 1"	//if set, NPC won't fear player after his unapropriate behavior
							//SetAttr "flag_bystander 1"	//if set, NPC counts as innocent bystander and cops will attack if you kill it
							//SetAttr "flag_static 1" //if set, NPC will always go to node with hintgroup, set in Hammer
							//SetAttr "flag_VitalEnemy 1" //do not change karma for this NPC if player is on good path
							//SetAttr "flag_PlayerFriendly 1"	//is friend of player, will reply to hits with FRIENDLYFIRE
																//if hitted too many times, will attack
						//END OF FLAGS
						
						TargetEntByName mission_logic
						IfAttr "Name:target == String:mission_logic TargetToMem msGP"
						ResetTarget 1
						
						SetAttr "SprayDamage SPRAY_DMG_DEFAULT"
						
						Timer tBump,0
						Timer tHitSound,0 //����� ��� ����� �� ��� ����� �����
						Timer tCanSay,3:3
						Timer tIgnoreNasty,0
					}
				}
			}
		}
		
		st_init_static
		{
			Group Neutarl
			Patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern st_init.pt_default
						SetAttr "flag_static 1"
					}
				}
			}
		}
		
		st_init_mavg
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern st_init.pt_default
					}
				}
			}
		}
		
		st_init_favg
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern st_init.pt_default
					}
				}
			}
		}
		
		st_init_mfat
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern st_init.pt_default
					}
				}
			}
		}
		
		st_init_ffat
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern st_init.pt_default
					}
				}
			}
		}
		
		st_init_mold
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern st_init.pt_default
					}
				}
			}
		}
		
		st_init_fold
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern st_init.pt_default
					}
				}
			}
		}
		
		st_init_special
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern st_init.pt_default
					}
				}
			}
		}
		
		st_start
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						CheckAttr "FirstRun ExecutePattern .xpt_firstrun"
						ExecutePattern .xpt_StartLoopUpdate
						
						FreeMovement false
						SetAttr "ReactionIgnoreLevel RE_NONE"
						SetAttr "busy 1"
						
						IfAttr "reaction >= RE_KICKED Pattern pt_react"
						IfAttr "reaction == RE_PUKE Pattern pt_react"
						CheckAttr "flag_bystander Block begin"
							IfAttr "reaction >= RE_FEAR Pattern pt_react"
						Block end
						
						ExecutePattern .xpt_CheckCombat
						
						IfAttr "ea_NumFear > 0 Block begin"
							IfAttr "reaction >= RE_FEAR Pattern pt_react"
							IfAttr "RelationTo:target == Relation:fear and DistTo:target > ED_FAR Relationship target,neutral"
							IfAttr "RelationTo:target == Relation:fear SetAttr NewReaction RE_FEAR"
							IfAttr "ea_NumVisibleFear > 0 SetAttr NewReaction RE_FEAR"
						Block end
						
						IfAttr "reaction != RE_NONE Block begin"
							Pattern pt_react
						Block end
						
						ExecutePattern .xpt_idle
						//ExecutePattern bh_base:st_start.pt_default
					}
				}
				
				pt_react
				{
					actions
					{
						ExecutePattern .xpt_ResetStartLoop
						
						IfAttr "Object:slot#msTARGET != Object:Null Block begin"
							TargetFromMem msTARGET
							ClearMem msTARGET
						Block end
						
						Pattern pt_reaction
					}
				}
				
				pt_reaction
				{
					actions
					{
						IfAttr "reaction == RE_TASING	State st_OnTasing" //tasing by taser
						IfAttr "reaction == RE_TASED	State st_OnTasing" //tased
						IfAttr "reaction == RE_STUNNED	State st_OnTasing" //stunned by something blunt
						IfAttr "reaction == RE_IGNITE	State st_OnIgnite" //is on fire
						IfAttr "reaction == RE_SNATCHED	State st_OnSnatched" //snatched by animal
						IfAttr "reaction == RE_FEAR ExecutePattern .xpt_fear"
						IfAttr "reaction == RE_WEAPON	State st_seeweapon"
						IfAttr "reaction == RE_COMBAT	State st_OnHearCombat"
						IfAttr "reaction == RE_KICKED	State st_OnKicked" //kicked by somebody
						IfAttr "reaction == RE_PUKE		State st_puke" // wants to puke
						IfAttr "reaction == RE_NASTY	State st_OnNasty" //is urinated on or hit by shit/drocha
						//IfAttr "reaction == RE_SEEINFLAME State st_OnSeeInFlame"
						IfAttr "reaction == RE_BUMPED	State st_OnBumped"
						IfAttr "reaction == RE_DANGER	State st_OnHearDanger"
						IfAttr "reaction == RE_SEEFLAME	State st_OnSeeFlame" //when sees flame on ground
						IfAttr "reaction == RE_BLINDED	State st_OnBlinded" // when blinded
						IfAttr "reaction == RE_SPRAYED	State st_OnSprayStunned"
						IfAttr "reaction == RE_STING	State st_OnBeeSting" //bees attack
						
						SetAttr "NewReaction RE_NONE"
						SetAttr "reaction RE_NONE"
						Pattern pt_default
					}
				}
				
				xpt_StartLoopUpdate
				{
					actions
					{
						CheckAttr "InStartCycle ChangeAttr NumStartLoops +1"
						IfAttr "NumStartLoops == 0 SetAttr ActualNumEnemy ea_NumEnemy"
						SetAttr "InStartCycle 1"
					}
				}
				
				xpt_ResetStartLoop
				{
					actions
					{
						CheckAttr "InStartCycle Block begin"
							RemoveAttr InStartCycle
							SetAttr "NumStartLoops 0"
						Block end
					}
				}
				
				xpt_CheckCombat
				{
					actions
					{
						IfAttr "RelationTo:target == Relation:Enemy ExecutePattern .xpt_ChooseEnemy"
						IfAttr "ActualNumEnemy > 0 ExecutePattern .xpt_ChooseEnemy"
						IfAttr "TaskCombat == TC_SEARCH Pattern pt_precombat"
					}
				}
				
				xpt_ChooseEnemy
				{
					actions
					{
						IfAttr "RelationTo:target == Relation:enemy Block begin"
							IfAttr "Object:target == Object:player SetAttr HatesPlayer 1"
							CheckAttr "target.active Pattern pt_precombat"
							Relationship target,neutral
							IgnoreTarget 3
							ResetTarget 1
							ChangeAttr "ActualNumEnemy -1"
						Block end
						TargetEnemy 1
						IfAttr "RelationTo:target == Relation:enemy Pattern pt_default"
						ChangeAttr "ActualNumEnemy -1"
						Pattern pt_default
					}
				}
				
				xpt_firstrun
				{
					actions
					{
						//model defined attributes are set with this thing
						FireUser 1	//if fired to MAvg, it should fire OnImAMan back
												 //if can talk with cell, returns OnIHaveCell back
												 //if NPC is old and can use only basic combat abilities, returns OnImOld
												 //if NPC is male bystander with different walk styles, returns OnImWalker
												 //if NPC is MAvg or FAvg, it will return OnICanLean. useful for combat
						RemoveAttr FirstRun
						Pattern pt_default
					}
				}
				
				xpt_fear
				{
					actions
					{
						ExecutePattern .xpt_ResetStartLoop
						State st_fear
					}
				}
				
				xpt_idle
				{
					actions
					{
						ExecutePattern .xpt_ResetStartLoop
						State st_idle
					}
				}
				
				pt_precombat
				{
					actions
					{
						ExecutePattern .xpt_ResetStartLoop
						ExecutePattern .xpt_SelectWeapon
						
						CheckAttr "WeaponChanged Block begin"
							Wait 0.5
							//WaitForEnd 1
							RemoveAttr WeaponChanged
						Block end
						
						ExecutePattern .xpt_combat
						Pattern pt_default
					}
				}
				
				xpt_SelectWeapon
				{
					actions
					{
						//Weapon Arm
						//Return 1
						
						IfAttr "HasWeapon:Ranged > 0 Block begin"
							IfAttr "HasWeapon:Ranged != 2 SetAttr WeaponChanged 1"
							Weapon select,ranged
							SetAttr "ea_status sMILITANT"
						Block end
						
						IfAttr "HasWeapon:Ranged == 0 and HasWeapon:melee > 0 Block begin"
							IfAttr "HasWeapon:melee != 2 SetAttr WeaponChanged 1"
							Weapon select,melee
							SetAttr "ea_status sPUNISHER"
						Block end
					}
				}
				
				xpt_combat
				{
					actions
					{
						State st_attack_melee
					}
				}
				
				xpt_ReactionChange
				{
					actions
					{
						Repeat 0
					}
				}
			}
			events
			{
				OnAttrChange_ea_NumEnemy "ExecutePattern .xpt_ResetStartLoop"
			}
		}
		
		st_attack_melee
		{
			Group Combat
			Patterns
			{
				pt_runloop
				{
					actions
					{
						CheckAttr "flag_bystander Block begin"
							IfAttr "Timer:tForgivePlayer <= 0 Pattern pt_end"
						Block end
						
						//��������� �� bh_human:st_attack_melee, � �� ��-�� �� �������� ����� ��-�������
						MoveToTarget run,1
						Repeat 3
					}
					events
					{ 
						OnTargetReach "Pattern pt_face"
						OnInvalidRoute "Pattern pt_end"
					}
				}
			}
		}
		
		st_idle
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						ResetTarget 1
						RemoveAttr "busy"
						AvoidProhibitedArea true
						CheckAttr "flag_static SetAttr busy 1" //������� ������ ������
						ExecutePattern .xpt_ResetParams
						ExecutePattern .xpt_SelectWeapon
						CheckAttr "ImWalker ExecutePattern .xpt_SetWalkPack"
						Pattern pt_decide
					}
				}
				
				pt_decide
				{
					actions
					{
						CheckAttr "flag_static Pattern pt_gotohint" //������� ������ ���� � ����
						Pattern pt_idle,pt_gotohint
					}
				}
				
				pt_idle
				{
					actions
					{
						ExecutePattern .xpt_SetAreaGroup
						ExecutePattern .xpt_SetIdleParams
						FreeMovement walk
						Wait 10:10
						ExecutePattern .xpt_CheckPhone
					}
					events
					{
						OnInvalidRoute "State st_start"
						OnTargetReach "State st_start"
					}
				}
				
				pt_gotohint
				{
					actions
					{
						ExecutePattern .xpt_SetHintGroup
						ExecutePattern .xpt_SetHintParams
						FreeMovement walk,reset
					}
					events
					{
						OnInvalidRoute "Pattern pt_idle"
					}
				}
				
				xpt_ResetParams
				{
					actions
					{
						FreeMovement false
						Aim false
						Crouch false
						Face false
					}
				}
				
				xpt_SelectWeapon
				{
					actions
					{
						Weapon disarm
						SetAttr "ea_status sNEUTRAL"
					}
				}
				
				xpt_SetIdleParams
				{
					actions
					{
						FreeMovementParams area_all,ED_MIDDLE,ED_VERY_FAR,area_group
						CheckAttr "flag_static FreeMovementParams area_all,ED_CLOSE,ED_MIDDLE,area_group"
					}
				}
				
				xpt_SetHintParams
				{
					actions
					{
						FreeMovementParams hint_all,ED_CLOSE,ED_FAR,hint_group,hint_face,use_node,once
						CheckAttr "flag_static FreeMovementParams hint_all,-1,-1,hint_group,hint_face,use_node,nearest,once"
					}
				}
				
				xpt_SetWalkPack
				{
					actions
					{
						IfAttr "Timer:tChangeWalkPack > 0 Return 1"
						TImer tChangeWalkPack,60:60
						
						SetAttr "walk_rnd 0"
						ChangeAttr "walk_rnd 0:5"
						
						IfAttr "walk_rnd <= 1 SetActPack ACT_WALK,walk_neutral"
						IfAttr "walk_rnd == 2 SetActPack ACT_WALK,walk_joggy"
						IfAttr "walk_rnd == 3 SetActPack ACT_WALK,walk_fast"
						IfAttr "walk_rnd == 4 SetActPack ACT_WALK,walk_slow"
						IfAttr "walk_rnd == 5 SetActPack ACT_WALK,walk_heavy"
						IfAttr "walk_rnd == 5 and ea_manner == Manner:LameWanker SetActPack ACT_WALK,walk_funny"
						
						RemoveAttr walk_rnd
					}
				}
				
				xpt_SetAreaGroup
				{
					actions
					{
					}
				}
				
				xpt_SetHintGroup
				{
					actions
					{
						CheckAttr "flag_static Return 1"
						SetHintGroup wish_fun_idle
					}
				}
				
				xpt_CheckPhone
				{
					actions
					{
						CheckAttr "flag_static Return 1" //������� �� ������ �� ��������
						IfAttr "self.ea_faction != Faction:Citizens Return 1"
						
						CheckAttr "IHaveCell Block begin"
							SetAttr "rnd 0,0,100"
							ChangeAttr "rnd 0:100"
							IfAttr "rnd < NPC_CALL_CHANSE Block begin"
								RemoveAttr rnd
								State so_phonecall
							Block end
							RemoveAttr rnd
						Block end
					}
				}
				
				xpt_OnVisible
				{
					actions
					{
						TargetCaller 1
						
						IfAttr "RelationTo:target == Relation:enemy State st_start"
						IfAttr "RelationTo:target == Relation:fear  State st_start"
						
						CheckAttr "flag_static Block begin"
							IgnoreTarget 10
							ResetTarget 1
							Return 1
						Block end
						
						StateMatrix faction
						StateMatrix social
						
						IgnoreTarget 10
						ResetTarget 1
					}
				}
				
				xpt_SeeOnFire
				{
					actions
					{
						ExecutePattern .xpt_OnVisible
					}
				}
				
				xpt_OnNewEnemy
				{
					actions
					{
						TargetCaller 1
						State st_start
					}
				}
				
				xpt_OnNewFear
				{
					actions
					{
						TargetCaller 1
						State st_start
					}
				}
				
				xpt_ReactionChange
				{
					actions
					{
						State st_start
					}
				}
				
				xpt_OnHit
				{
					actions
					{
						ExecutePattern st_util.xpt_OnHit
						IfAttr "RelationTo:caller == Relation:enemy Block begin"
							TargetCaller 1
							State st_start
						Block end
						
						IfAttr "Object:target != Object:caller Block begin"
							TargetCaller 1
							State st_start
						Block end
						
						CheckAttr "flag_IgnoreWeapon Return 1"
						TargetCaller 1
						ExecutePattern st_seeweapon.xpt_precheck
					}
				}
				
				xpt_OnWrongAct
				{
					actions
					{
						IfAttr "Object:caller != Object:player Return 1"
						IfAttr "slot#msGP.PlayerPath != PATH_GOOD Return 1"
						
						CheckAttr "flag_bystander Block begin"
							IfAttr "Visible:caller == 1 Block begin"
								IfAttr "Timer:tCanSay > 0 Return 1"
								IfAttr "VoicePrefix:self != String:WHR Say MADCOP"
								IfAttr "VoicePrefix:self == String:WHR Say WF_MADCOP"
								Timer tCanSay,5:3
							Block end
						Block end
					}
				}
				
				xpt_OnBrutalAct
				{
					actions
					{
						CheckAttr "flag_bystander Block begin"
							IfAttr "Visible:caller == 1 Block begin"
								TargetCaller 1
								ExecutePattern st_util.xpt_AddTargetToFear
							Block end
						Block end
					}
				}
			}
			events
			{
				OnVisible			"ExecutePattern .xpt_OnVisible"
				OnFire_SGreet		"Pattern so_greet.pt_wait"
				//OnHearDanger "SetAttr NewReaction RE_DANGER"
				//OnHearCombat "SetAttr NewReaction RE_FEAR"
				OnAE_OnFire			"ExecutePattern .xpt_SeeOnFire"
				OnSawEnemy			"ExecutePattern .xpt_OnNewEnemy"
				OnSawFear			"ExecutePattern .xpt_OnNewFear"
				OnNewEnemy			"ExecutePattern .xpt_OnNewEnemy"
				OnNewFear			"ExecutePattern .xpt_OnNewFear"
				OnHit				"ExecutePattern .xpt_OnHit"
				
				OnAE_WrongAct		"ExecutePattern .xpt_OnWrongAct"
				OnAE_BrutalAct		"ExecutePattern .xpt_OnBrutalAct"
			}
		}
		
		st_OnTasing
		{
			Group Alert
			Patterns
			{
				pt_default
				{
					actions
					{
						CheckAttr "NotAttackedByPlayer Block begin"
							IfAttr "Object:target == Object:player ExecutePattern st_util.xpt_OnAttackedByPlayer"
						Block end
						
						SetAttr "OldStatus ea_status"
						SetAttr "ea_status sVICTIM"
						SetAttr "ea_tased 1"
						Senses false
						Face false
						FreeMovement false
						
						//���� �� ������� ����� ���������� ������, ��������� ��� ����� �����
						IfAttr "reaction == RE_STUNNED	Pattern pt_stunout"
						IfAttr "reaction == RE_TASED	Pattern pt_tased"
						IfAttr "reaction == RE_TASING	Pattern pt_tasing"
					}
				}
				
				pt_tased:ignore_ext_events // ��� ���������
				{
					actions
					{
						Effect 4,Tazer_Hit_Smoke_Fx,pelvis,0,0,0,-1,true
						SetAttr "NewReaction RE_TASED"
						Sequence seq.g_reaction_tased
						Wait 1.5:1.5
						Pattern pt_stunout
					}
					events
					{
						OnHostaged "Pattern pt_hostaged"
						OnUnstunned "Pattern pt_unstunned"
						OnStandUpEnd	"Pattern pt_unstunned"
						OnArrested "Pattern pt_arrested"
						OnDeath "ExecutePattern st_OnDeath.pt_default"
						OnTasingStart "Pattern pt_tasing"
						OnExtinguish	"ExecutePattern .xpt_OnExtinguish"
						OnIgnite		"ExecutePattern .xpt_OnIgnite"
					}
				}
				
				pt_tasing:ignore_ext_events //��� ���������
				{
					actions
					{
						Effect 4,Tazer_Hit_Smoke_Fx,pelvis,0,0,0,-1,true
						SetAttr "NewReaction RE_TASING"
						Wait 20
						Pattern pt_stunout
					}
					events
					{
						OnUnconscious "Pattern pt_unconscious"
						OnTasingFinish "Pattern pt_stunout"
						OnDeath "ExecutePattern st_OnDeath.pt_default"
						OnUnstunned "Pattern pt_unstunned" //���� ������ ���������� �� ����� � �������
						OnExtinguish	"ExecutePattern .xpt_OnExtinguish"
						OnIgnite		"ExecutePattern .xpt_OnIgnite"
					}
				}
				
				pt_stunout:ignore_ext_events
				{
					actions
					{
						Sequence seq.reaction_stun,9000
						Wait 20
						Pattern pt_unstunned
					}
					events
					{
						OnHostaged "Pattern pt_hostaged"
						OnUnstunned "Pattern pt_unstunned"
						OnStandUpEnd	"Pattern pt_unstunned"
						OnArrested "Pattern pt_arrested"
						OnTasingStart	"Pattern pt_tasing"
						OnTased		"Pattern pt_tased"
						OnDeath "ExecutePattern st_OnDeath.pt_default"
						OnExtinguish	"ExecutePattern .xpt_OnExtinguish"
						OnIgnite		"ExecutePattern .xpt_OnIgnite"
					}
				}
				
				pt_unconscious:ignore_ext_events
				{
					actions
					{
						IfAttr "reaction >= RE_TASED Effect 4,Tazer_Hit_Smoke_Fx,pelvis,0,0,-12,-1,true"
						State st_OnUnconscious
					}
					events
					{
						OnDeath "ExecutePattern st_OnDeath.pt_default"
					}
				}
				
				pt_unstunned
				{
					actions
					{
						Senses true
						RemoveAttr "ea_tased"
						SetAttr "ea_status sNEUTRAL"
						Effect 4,reset
						Pattern pt_end
					}
				}
				
				pt_hostaged
				{
					actions
					{
						IfAttr "reaction <= RE_TASING Block begin"
							SetAttr "reaction RE_NONE"
							SetAttr "NewReaction RE_NONE"
						Block end
						
						RemoveAttr "ea_tased"
						State st_OnHostaged
					}
				}
				
				pt_arrested:ignore_ext_events
				{
					actions
					{
						SetAttr "ea_status sNEUTRAL"
						State st_OnArrested
					}
				}
				
				pt_end
				{
					actions
					{
						ResetSequence 1
						SetAttr "ea_status OldStatus"
						RemoveAttr OldStatus
						
						IfAttr "reaction <= RE_TASING and reaction != RE_IGNITE Block begin"
							SetAttr "NewReaction RE_NONE"
							SetAttr "reaction RE_NONE"
						Block end
						
						IfAttr "ea_status == sIGNITED SetAttr NewReaction RE_IGNITE"
						
						State st_start
					}
				}
				
				xpt_OnExtinguish
				{
					actions
					{
						IfAttr "OldStatus == sIGNITED SetAttr OldStatus sNEUTRAL"
					}
				}
				
				xpt_OnIgnite
				{
					actions
					{
						SetAttr "OldStatus sIGNITED"
					}
				}
				
				xpt_ReactionChange
				{
					actions
					{
						//SetAttr "NewReaction RE_NONE"
						//SetAttr "reaction RE_NONE"
					}
				}
			}
			events
			{
				OnExtinguish	"ExecutePattern .xpt_OnExtinguish"
				OnIgnite		"ExecutePattern .xpt_OnIgnite"
			}
		}

		st_OnBlinded // Kizoky
		{	
			Group Alert
			Patterns
			{
				pt_default
				{
					actions
					{
						//ExecutePattern .xpt_DecreaseConsciousness
						Senses false
						SetAttr	"ea_tased 1"
						//SetAttr "ea_takeable 1"
						Pattern pt_stunned
					}
				}
				
				pt_stunned
				{
					actions
					{
						Sequence seq.reaction_spray,9000
						ExecutePattern .xpt_scream
						Timer tScream,5,repeated
						Timer tUnstun,BLINDED_UNSTUN_TIMER
						Pattern pt_stunloop
					}
				}
				
				pt_stunloop
				{
					actions
					{
						IfAttr "Timer:tUnstun <= 0 Pattern pt_end"
						Repeat 3
						//Wait 20
						//Pattern pt_end
					}
					events
					{
						OnDeath "ExecutePattern st_OnDeath.pt_default"
						OnTimer_tUnstun	"Pattern pt_end"
						OnUnconscious "Pattern pt_unconscious"
						OnHostaged "Pattern pt_hostaged"
						//OnSprayStunned "Timer tUnstun,SPRAY_UNSTUN_TIMER"
						OnBlinded "Timer tUnstun, BLINDED_UNSTUN_TIMER"
						OnTimer_tScream "ExecutePattern .xpt_scream"
						OnUnstunned "Pattern pt_end"
						OnStandUpEnd	"Pattern pt_end"
						//OnTimer_tStopAction "Pattern pt_end"
					}
				}
				
				pt_hostaged
				{
					actions
					{
						SetAttr "hostaged 1"
						Pattern pt_end
					}
				}
				
				pt_unconscious:ignore_ext_events
				{
					actions
					{
						SetAttr "ea_takeable 0"
						RemoveAttr ea_tased
						State st_OnUnconscious
					}
					events
					{
						OnDeath "ExecutePattern st_OnDeath.pt_default"
					}
				}
				
				pt_end
				{
					actions
					{
						Senses true
						//SetAttr "ea_takeable 0"
						RemoveAttr ea_tased
						Timer tScream,0
						
						IfAttr "reaction <= RE_BLINDED Block begin"
							SetAttr "reaction RE_NONE"
							SetAttr "NewReaction RE_NONE"
						Block end
						
						CheckAttr "hostaged State st_OnHostaged"
						
						ResetSequence 1
						//CheckAttr "flag_bystander ExecutePattern st_util.xpt_AddTargetToFear"
						TargetPlayer 1
						Relationship target,enemy,8
						CheckAttr "flag_bystander Timer tForgivePlayer,FORGIVE_TIMER_DEFAULT"
						MoveToTarget true
						State st_start
					}
				}
				
				xpt_scream
				{
					actions
					{
						Say SCREAM
					}
				}
				
				xpt_ReactionChange
				{
					actions
					{
						IfAttr "reaction > RE_BLINDED Pattern pt_end"
					}
				}
			}
		}

		
