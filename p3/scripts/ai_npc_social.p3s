						Wait 1.5:0.5
						WaitForEnd 1
						FireEvent SChatLeadOutEnd
						Pattern pt_end
					}
				}
				
				pt_end
				{
					actions
					{
						RemoveAttr "greet_sleazy"
						RemoveAttr "greet_normal"
						RemoveAttr "leader"
						Face false
						LookAt false
						ResetTarget 1
						IgnoreTarget 30
						State st_start
					}
				}
				
				xpt_ReactionChange
				{
					actions
					{
						FireEvent Cancel
						Pattern pt_end
					}
				}
			}
			events
			{
				OnFire_Cancel "Pattern pt_end"
			}
		}
		
