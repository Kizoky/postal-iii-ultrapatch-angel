Constants
{
	Const PA_HOBO_MAX,3
	Const TC_MOVETO_PLAYER,67
	Const PA_HELPERS_NUM,4
	
	Const PA_ENDING_BAD,0
	Const PA_ENDING_GOOD,1
}

behavior
{
	name bh_mission_police
	inherited bh_mission_logic_base
	
	States
	{
		st_empty
		{
			Group Neutral
			
			Patterns
			{
				pt_default
				{
					actions
					{
					}
				}
			}
		}
		
		st_init
		{
			Group Neutral
			
			Patterns
			{
				pt_default
				{
					actions
					{
						SetAttr "PlayerNotAttackHobo 1"
						SetAttr "PlayerAgressive 0"
						SetAttr "PlayerKillCop 0"
						SetAttr "HoboArrested 0,0,PA_HOBO_MAX"
						SetAttr "CopsSaved 0,0,4"
						
						SetAttr "HelpersShown 0,0,PA_HELPERS_NUM"
						SetAttr "PlayerPath PATH_GOOD"
					}
				}
			}
		}
		
		st_start
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						//Wait 1
						PlayerKarma show
						PlayerKarma =100
						ExecutePattern st_util.xpt_ShowKarmaTutorial
						EntFireInput muzak.mission,Volume:0
						
						Wait 0.1
						
						//EntFireInput "lpp,DisableWeaponSwitching"
						EntFireInput "lpp,GiveWeapon:p3_weapon_taser"
						EntFireInput "lpp,GiveWeapon:p3_weapon_cop_baton"
						EntFireInput "pcc,Command:use p3_weapon_taser"
						
						Wait 0.5
						
						MissionLog "add_primary,ArrestHobos,#P3_PA_PRI1"
						MissionLog "add_primary,DouchSurvive,#P3_PA_PRI3"
						MissionLog "add_secondary,Mess,#P3_PA_SEC1"
						ShowMessage #P3_PA_MSG1
						
						ExecutePattern st_util.xpt_RefreshHelper
						
						Pattern pt_loop
					}
				}
				
				pt_loop
				{
					actions
					{
						CheckAttr "HobosDone Block begin"
							MissionLog done,ArrestHobos
							state st_runaway
						Block end
						
						Repeat 1
					}
				}
			}
			events
			{
				OnFire_HoboNeutralized "ExecutePattern st_util.xpt_OnHoboNeutralized"
				OnFail_BattleA "SetAttr BAFailedEarly 1"
			}
		}
		
		st_runaway
		{
			Group Neutral
			
			Patterns
			{
				pt_default
				{
					actions
					{
						Timer tHoboAggro,10
						Wait 1
						RemoveAttr "HobosDone"
						EntFireInput "lpp,EnableWeaponSwitching"
						TargetEntByName "npc_douchebag"
						FireEvent "TrainingDone"
						//ShowMessage "[All Done!],$P3Karma"
						
						PlayVideo pa_2,1.0,1.0
						
						Wait 0.9
						ExecutePattern .xpt_activateBA
						
						//Wait 0.1
						EntFireInput "muzak.lobby,Kill"
						EntFireInput "muzak.mission,FadeIn:1"
						
						Wait 0.3
						//EntFireInput pdoor01a,unlock
						//EntFireInput pdoor01b,unlock
						EntFireInput door_05,unlock
						EntFireInput tg_pdoor01,enable
						//EntFireInput hobo_spawner_01,enable
						
						ShowMessage #P3_PA_MSG2
						MissionLog "add_primary,Escape,#P3_PA_PRI2"
						Wait 5
						CheckAttr "active_battleA IfAttr PlayerKillCop != 1 ShowMessage #P3_PA_SEC2_MSG1"
						
						Pattern pt_loop
					}
				}
				
				pt_loop
				{
					actions
					{
					}
					events
					{
						OnTimer_tHoboAggro "ExecutePattern st_util.xpt_PlayerAttackHobo"
					}
				}
				
				xpt_activate01
				{
					actions
					{
						EntFireInput hobo_spawner_01,enable
						//ShowMessage "[Spawner 01 active],$P3Mission"
					}
				}
				
				xpt_activate02
				{
					actions
					{
						EntFireInput hobo_spawner_02,enable
						//ShowMessage "[Spawner 02 active],$P3Mission"
					}
				}
				
				xpt_activateBA
				{
					actions
					{
						//EntFireInput cop_spawner_battleA,enable
						
						EntFireInput hobo_spawner_battleA,enable
						//ExecutePattern st_util.xpt_UpdateCopsInfo
						MissionLog "add_secondary,taskBA,#P3_PA_SEC2_LOG1"
						SetAttr "active_battleA 1"
						
						CheckAttr "BAFailedEarly Block begin"
							ExecutePattern .xpt_failBA
							RemoveAttr BAFailedEarly
						Block end
					}
				}
				
				xpt_doneBA
				{
					actions
					{
						CheckAttr "active_battleA Block begin"
							RemoveAttr "active_battleA"
							ChangeAttr "CopsSaved +1"
							MissionLog done,taskBA
						Block end
						
						CheckAttr "PlayerNotAttackHobo ExecutePattern st_util.xpt_PlayerAttackHobo"
					}
				}
				
				xpt_failBA
				{
					actions
					{
						RemoveAttr "active_battleA"
						MissionLog fail,taskBA
						PlayerKarma -KARMA_HIGH
						
						CheckAttr "PlayerNotAttackHobo ExecutePattern st_util.xpt_PlayerAttackHobo"
					}
				}
				
				xpt_activate03
				{
					actions
					{
						EntFireInput hobo_spawner_03,enable
						//ShowMessage "[Spawner 03 active],$P3Mission"
					}
				}
				
				xpt_activateBB
				{
					actions
					{
						EntFireInput cop_spawner_battleB,enable
						EntFireInput hobo_spawner_battleB,enable
						//ShowMessage "[Let the battle B begin!],$P3Mission"
						MissionLog add_secondary,taskBB,#P3_PA_SEC2_LOG2
						IfAttr "PlayerKillCop != 1 ShowMessage #P3_PA_SEC2_MSG2"
						SetAttr "active_battleB 1"
					}
				}
				
				xpt_doneBB
				{
					actions
					{
						CheckAttr "active_battleB Block begin"
							RemoveAttr "active_battleB"
							ChangeAttr "CopsSaved +1"
							MissionLog done,taskBB
						Block end
					}
				}
				
				xpt_failBB
				{
					actions
					{
						RemoveAttr "active_battleB"
						MissionLog fail,taskBB
						PlayerKarma -KARMA_HIGH
					}
				}
				
				xpt_activate04
				{
					actions
					{
						EntFireInput hobo_spawner_04,enable
						//ShowMessage "[Spawner 04 active],$P3Mission"
					}
				}
				 
				xpt_activate05
				{
					actions
					{
						EntFireInput hobo_spawner_05,enable
						//ShowMessage "[Spawner 05 active],$P3Mission"
					}
				}
				
				xpt_activateBC
				{
					actions
					{
						CheckAttr "active_battleC Return 1"
						IfAttr "PlayerKillCop != 1 ShowMessage #P3_PA_SEC2_MSG3"
						EntFireInput cop_spawner_battleC,enable
						EntFireInput hobo_spawner_battleC,enable
						MissionLog add_secondary,taskBC,#P3_PA_SEC2_LOG3
						//ShowMessage "[Let the battle C begin!],$P3Mission"
						
						SetAttr "active_battleC 1"
					}
				}
				
				xpt_doneBC
				{
					actions
					{
						CheckAttr "active_battleC Block begin"
							RemoveAttr "active_battleC"
							ChangeAttr "CopsSaved +1"
							MissionLog done,taskBC
						Block end
					}
				}
				
				xpt_failBC
				{
					actions
					{
						RemoveAttr "active_battleC"
						MissionLog fail,taskBC
						PlayerKarma -KARMA_HIGH
					}
				}
				
				xpt_activate06
				{
					actions
					{
						EntFireInput hobo_spawner_06,enable
						//ShowMessage "[Spawner 06 active],$P3Mission"
					}
				}
				
				xpt_activate07
				{
					actions
					{
						EntFireInput hobo_spawner_07,enable
						//ShowMessage "[Spawner 07 active],$P3Mission"
					}
				}
				
				xpt_activateBD
				{
					actions
					{
						CheckAttr "active_battleD Return 1"
						
						EntFireInput cop_spawner_battleD,enable
						EntFireInput hobo_spawner_battleD,enable
						//ShowMessage "[Let the battle D begin!],$P3Mission"
						MissionLog add_secondary,taskBD,#P3_PA_SEC2_LOG4
						IfAttr "PlayerKillCop != 1 ShowMessage #P3_PA_SEC2_MSG4"
						SetAttr "active_battleD 1"
					}
				}
				
				xpt_doneBD
				{
					actions
					{
						CheckAttr "active_battleD Block begin"
							RemoveAttr "active_battleD"
							ChangeAttr "CopsSaved +1"
							MissionLog done,taskBD
							//EntFireInput tg_escape,enable
						Block end
					}
				}
				
				xpt_failBD
				{
					actions
					{
						RemoveAttr "active_battleD"
						MissionLog fail,taskBD
						PlayerKarma -KARMA_HIGH
						//EntFireInput tg_escape,enable
					}
				}
				
				xpt_CheckExit
				{
					actions
					{
						State st_end
					}
				}
				
			}
			
			events
			{
				OnActivated_01 "ExecutePattern .xpt_activate01"
				OnActivated_02 "ExecutePattern .xpt_activate02"
				
				//Battle at the infirmary
				OnActivated_BattleA "ExecutePattern .xpt_activateBA"
				OnDone_BattleA "ExecutePattern .xpt_doneBA"
				OnFail_BattleA "ExecutePattern .xpt_failBA"
				
				OnActivated_03 "ExecutePattern .xpt_activate03"
				
				//Battle at the armory
				OnActivated_BattleB "ExecutePattern .xpt_activateBB"
				OnDone_BattleB "ExecutePattern .xpt_doneBB"
				OnFail_BattleB "ExecutePattern .xpt_failBB"
				
				OnActivated_04 "ExecutePattern .xpt_activate04"
				OnActivated_05 "ExecutePattern .xpt_activate05"
				
				//Battle at the yard
				OnActivated_BattleC "ExecutePattern .xpt_activateBC"
				OnDone_BattleC "ExecutePattern .xpt_doneBC"
				OnFail_BattleC "ExecutePattern .xpt_failBC"
				
				OnActivated_06 "ExecutePattern .xpt_activate06"
				OnActivated_07 "ExecutePattern .xpt_activate07"
				
				//Battle at the lobby
				OnActivated_BattleD "ExecutePattern .xpt_activateBD"
				OnFail_BattleD "ExecutePattern .xpt_failBD"
				OnDone_BattleD "ExecutePattern .xpt_doneBD"
				
				OnPlayerEscaped "ExecutePattern .xpt_CheckExit"
				
				//OnAttrChange_CopsSaved "ExecutePattern st_util.xpt_UpdateCopsInfo"
			}
		}
		
		st_end
		{
			Group Neutral
			
			Patterns
			{
				pt_default
				{
					actions
					{
						CheckAttr "active_battleA MissionLog fail,taskBA"
						CheckAttr "active_battleB MissionLog fail,taskBB"
						CheckAttr "active_battleC MissionLog fail,taskBC"
						CheckAttr "active_battleD MissionLog fail,taskBD"
						
						MissionLog done,Escape
						MissionLog done,Survive
						
						TargetPlayer 1
						SetAttr "ending PA_ENDING_GOOD"
						IfAttr	"PlayerAgressive == 1	SetAttr ending PA_ENDING_BAD"
						IfAttr	"Karma:target == 0		SetAttr ending PA_ENDING_BAD"
						
						EntFireInput fade_in,Fade
						Wait 1
						IfAttr "CopsSaved == 4 Block begin"
							TargetPlayer 1
							SetAttr "target.ach_Robocop 1"
						Block end
						IfAttr "ending == PA_ENDING_BAD		EntFireInput pcc,Command:video_exitcmd pa_3 p3_end_mission"
						IfAttr "ending == PA_ENDING_GOOD	EntFireInput pcc,Command:video_exitcmd pa_4 p3_end_mission"
						
						Wait 3
						EndMission 1
					}
				}
			}
		}
		
		st_fail
		{
			Group Neutral
			
			Patterns
			{
				pt_default
				{
					actions
					{
						EntFireInput "lpp,Say:ALKILL"
						ShowMessage #P3_PA_FAIL1
						MissionLog fail,DouchSurvive
						Wait 4
						EntFireInput fade_in,Fade
						Wait 1
						EntFireInput "pcc,Command:reload"
					}
				}
			}
		}
		
		st_util
		{
			Group Neutral
			
			Patterns
			{
				xpt_RefreshHelper
				{
					actions
					{
						Timer tRefreshHelper,10
						ChangeAttr "HelpersShown 1"
						
						IfAttr "HelpersShown ==  1 ShowMessage #P3_PA_HELPER01"
						IfAttr "HelpersShown ==  2 ShowMessage #P3_PA_HELPER02"
						IfAttr "HelpersShown ==  3 ShowMessage #P3_PA_HELPER03"
						IfAttr "HelpersShown ==  4 ShowMessage #P3_PA_HELPER04"
					}
				}
				
				xpt_OnHoboNeutralized
				{
					actions
					{
						ChangeAttr "HoboArrested 1"
						MissionLog "add_primary,ArrestHobos,#P3_PA_PRI1"
						//ShowMessage "[You have neutralized {0:v} of 3 hobos],$P3Mission,HoboArrested"
						
						IfAttr "HoboArrested == PA_HOBO_MAX Block begin"
							SetAttr "HobosDone 1"
						Block end
					}
				}
				
				xpt_OnPlayerAgressive
				{
					actions
					{
						IfAttr "PlayerAgressive == 1 Return 1"
						SetAttr "PlayerAgressive 1"
						//ShowMessage "[Now you have no chanse to become a cop, Dude],$P3Mission"
						MissionLog fail,Mess
					}
				}
				
				xpt_OnPlayerKillCop
				{
					actions
					{
						IfAttr "PlayerKillCop == 1 Return 1"
						SetAttr "PlayerKillCop 1"
						MissionLog fail,SaveCops
						MissionLog fail,Mess
						ExecutePattern st_util.xpt_OnPlayerAgressive
						
						CheckAttr "active_battleA ExecutePattern st_runaway.xpt_failBA"
						CheckAttr "active_battleB ExecutePattern st_runaway.xpt_failBB"
						CheckAttr "active_battleC ExecutePattern st_runaway.xpt_failBC"
						CheckAttr "active_battleD ExecutePattern st_runaway.xpt_failBD"
					}
				}
				
				xpt_UpdateCopsInfo
				{
					actions
					{
						MissionLog add_secondary,SaveCops,#P3_PA_SEC2
						IfAttr "PlayerKillCop == 1 MissionLog fail,SaveCops"
						IfAttr "CopsSaved == 4 MissionLog done,SaveCops"
					}
				}
				
				xpt_PlayerAttackHobo
				{
					actions
					{
						RemoveAttr PlayerNotAttackHobo
						AreaEvent PlayerAttackHobo,1000,Hobos
					}
				}
			}
			
		}
		
	}
	events
	{
		OnFire_PlayerAgressive	"ExecutePattern st_util.xpt_OnPlayerAgressive"
		OnFire_PlayerKillCop		"ExecutePattern st_util.xpt_OnPlayerKillCop"
		OnFire_DouchebagDead		"State st_fail"
		
		OnTimer_tRefreshHelper "ExecutePattern st_util.xpt_RefreshHelper"
		OnAttrMax_HelpersShown	"Timer tRefreshHelper,0"
		
		OnNewGame "ExecutePattern weaponGive.PA"
	}
}


behavior
{
	name bh_pa_hobo
	inherited bh_social
	
	States
	{
		st_init
		{
			Group Neutral
			
			Patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern bh_base:st_init.pt_default
						
						SetAttr "TaserDamage 20"
						SetAttr "flag_IgnorePlayerAttack 1"
						SetAreaGroup AG_BATTLEA
					}
				}
			}
		}
		
		st_fear
		{
			Group Alert
			Patterns
			{
				xpt_InitRunAway
				{
					actions
					{
						//пусто
					}
				}
				
				xpt_SetParams
				{
					actions
					{
						FreeMovementParams area_all,ED_MIDDLE,ED_VERY_FAR,area_group
					}
				}
			}
		}
		
		st_OnTasing
		{
			Group Alert
			Patterns
			{
				pt_default
				{
					actions
					{
						AreaEvent DudeIsBad,32
						Timer tCheckConsciousness,0.5,repeated
						ExecutePattern bh_base:st_OnTasing.pt_default
					}
				}
				pt_end
				{
					actions
					{
						ExecutePattern st_util.xpt_AddTargetToFear
						ExecutePattern bh_base:st_OnTasing.pt_end
					}
				}
			}
		}
		
		st_idle
		{
			Group Neutral
			
			Patterns
			{
				pt_default
				{
					actions
					{
						FreeMovementParams area_all,0,512,area_group
						SetAreaGroup AG_BATTLEA
						FreeMovement walk
						Pattern pt_moving
					}
				}
				
				pt_moving
				{
					actions
					{
						Wait 5:10
						Repeat 0
					}
					events
					{
						OnTargetReach "State st_start"
					}
				}
			}
		}
		
		st_util
		{
			Group Neutral
			Patterns
			{
				xpt_OnDudeIsBad
				{
					actions
					{
						TargetPlayer 1
						Relationship target,fear
						SetAttr "NewReaction RE_FEAR"
						State st_start
					}
				}
			}
		}
		st_deactivate
		{
			Group Alert
			Patterns
			{
				pt_default
				{
					actions
					{
						TargetFromMem msGP
						//FireEvent PlayerAgressive
						FireEvent HoboNeutralized
						
						ResetTarget 1
						AreaEvent DudeIsBad,32
						
						ExecutePattern bh_base:st_deactivate.pt_default
					}
				}
			}
		}
		ChangeKarma
		{
			Group Alert
			Patterns
			{
				lethal
				{
					actions
					{
						PlayerKarma -KARMA_MED
					}
				}
			}
		}
	}
	
	events
	{
		OnAE_DudeIsBad "ExecutePattern st_util.xpt_OnDudeIsBad"
	}
}


behavior
{
	name bh_pa_military
	inherited bh_military_new
	
	States
	{
		st_init
		{
			Group Neutral
			
			Patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern bh_base:st_init.pt_default
						SetAreaGroup AG_DEFAULT
						AvoidProhibitedArea true
						SetAttr "ReactionThreshold RE_DANGER"
						
						SetAttr "flag_IgnorePlayerFear 1"
						SetAttr "flag_IgnorePlayerAttack 1"
						SetAttr "flag_IgnoreWeapon 1"
						SetAttr "flag_IgnoreCombat 1" 
					}
				}
			}
		}
		
		st_start
		{
			Group Neutral
			
			Patterns
			{
				pt_default
				{
					actions
					{
						CheckAttr "SpawnedInLobby Block begin"
							SetAreaGroup AG_BATTLEA
							SetAttr "flag_CombatUsesAG 1"
						Block end
						CheckAttr "SpawnedAtYard Block begin"
							SetAreaGroup AG_BATTLEB
							SetAttr "flag_CombatUsesAG 1"
						Block end
						CheckAttr "SpawnedInArmory Block begin"
							SetAreaGroup AG_BATTLEC
							SetAttr "flag_CombatUsesAG 1"
						Block end
						CheckAttr "SpawnedInInfirmary Block begin"
							SetAreaGroup AG_BATTLED
							SetAttr "flag_CombatUsesAG 1"
						Block end
						
						Pattern bh_base:st_start.pt_default
					}
				}
				
				xpt_ChooseEnemy
				{
					actions
					{
						IfAttr "RelationTo:target == Relation:enemy and DistTo:target >= 2048 Relationship target,neutral"
						ExecutePattern bh_base:st_start.xpt_ChooseEnemy
					}
				}
			}
		}
		
		st_idle
		{
			Group Neutral
			
			Patterns
			{
				pt_decide
				{
					actions
					{
						Pattern pt_idle
					}
				}
				
				xpt_OnHit
				{
					actions
					{
						ExecutePattern st_util.xpt_OnHit
						TargetCaller 1
						State st_start
					}
				}
				
				xpt_OnHearCombat
				{
					actions
					{
						IfAttr "RelationTo:caller == Relation:enemy TargetCaller 1"
						State st_start
					}
				}
				
				xpt_OnVisible
				{
					actions
					{
						//пусто
						TargetCaller 1
						IfAttr "target.ea_status == sCORPSE Block begin"
							IgnoreTarget 100
							ResetTarget 1
							Return 1
						Block end
						
						IfAttr "RelationTo:target == Relation:enemy State st_start"
						ResetTarget 1
					}
				}
			}
			events
			{
				OnAE_AllyUnderFire "ExecutePattern st_util.xpt_OnAllyUnderFire"
				OnHit "ExecutePattern .xpt_OnHit"
				OnHearCombat "ExecutePattern .xpt_OnHearCombat"
			}
		}
		
		st_RunToAG
		{
			//нигде не исплользуется вроде
			Group Alert
			
			Patterns
			{
				pt_default
				{
					actions
					{
						FreeMovementParams area_all,-1,-1,area_group,once
						FreeMovement run,reset
						
						Wait 2:2
						
						Pattern pt_done
					}
					events
					{
						OnInvalidRoute "Pattern pt_default"
						//OnTargetReach "Pattern pt_done"
						//OnNewEnemy "Pattern pt_react"
					}
				}
				
				pt_react
				{
					actions
					{
						//ShowMessage "[douchebag detected],$P3Mission"
						SetAttr "TargetReached 1"
						TargetEnemy 1
						Wait 0.6:1.4
						State st_start
					}
					events
					{
						OnTargetReach "State st_start"
					}
				}
				
				pt_done
				{
					actions
					{
						SetAttr "TargetReached 1"
						State st_start
					}
				}
				
			}
		}
		
		st_combat_move
		{
			Group Combat
			Patterns
			{
				xpt_SetMoveParams
				{
					actions
					{
						IfAttr "DistTo:target > ED_MIDDLE FreeMovementParams area_all,ED_CLOSE,ED_MIDDLE,area_group"
						IfAttr "DistTo:target <= ED_MIDDLE FreeMovementParams area_all,ED_CLOSE,ED_MIDDLE,from_target,area_group"
					}
				}
			}
		}
	
		st_util
		{
			Group Neutral
			Patterns
			{
				xpt_InfirmarySpawn
				{
					actions
					{
						SetAttr "SpawnedInInfirmary 1"
						//ShowMessage "[NPC Spawned at infirmary!],$P3Mission"
						//SetAreaGroup AG_INFIRMARY
					}
				}
				
				xpt_SpawnOutsideInfirmary
				{
					actions
					{
						SetAttr "SpawnedOutsideInfirmary 1"
						SetAttr "TargetReached 0"
					}
				}
				
				xpt_ArmorySpawn
				{
					actions
					{
						SetAttr "SpawnedInArmory 1"
						SetAttr "flag_CombatUsesAG 1"
						//SetAreaGroup AG_ARMORY
					}
				}
				
				xpt_SpawnOutsideArmory
				{
					actions
					{
						SetAttr "SpawnedOutsideArmory 1"
						SetAttr "TargetReached 0"
					}
				}
				
				xpt_YardSpawn
				{
					actions
					{
						SetAttr "SpawnedAtYard 1"
					}
				}
				
				xpt_LobbySpawn 
				{
					actions
					{
						SetAttr "SpawnedInLobby 1"
						//SetAreaGroup AG_LOBBY
					}
				}
				
				xpt_SpawnOutsideLobby
				{
					actions
					{
						SetAttr "SpawnedOutsideLobby 1"
						SetAttr "TargetReached 0"
					}
				}
				
				xpt_OnAllyUnderFire
				{
					actions
					{
						IfAttr "self.ea_faction != caller.ea_faction Return 1"
						
						//Face true
						//Wait 0.5:1
						CheckTarget 1
						
						MoveToTarget run,1,0,to_target
					}
					events
					{
						OnLost "Return 1"
						OnNewEnemy "State st_start"
					}
				}
				
				xpt_OnHit
				{
					actions
					{
						AreaEvent AllyUnderFire,ED_CLOSE
						ExecutePattern bh_base:st_util.xpt_OnHit
					}
				}
		 	}
		}
	}
	
	events
	{
		OnInfirmarySpawn "ExecutePattern st_util.xpt_InfirmarySpawn"
		OnArmorySpawn "ExecutePattern st_util.xpt_ArmorySpawn"
		OnYardSpawn "ExecutePattern st_util.xpt_YardSpawn"
		OnLobbySpawn "ExecutePattern st_util.xpt_LobbySpawn"
		OnSpawnOutsideLobby "ExecutePattern st_util.xpt_SpawnOutsideLobby"
		OnSpawnOutsideArmory "ExecutePattern st_util.xpt_SpawnOutsideArmory"
		OnSpawnOutsideInfirmary "ExecutePattern st_util.xpt_SpawnOutsideInfirmary"
	}
}


behavior
{
	name bh_hobo_attacker
	inherited  bh_pa_military
	
	States
	{
		st_init
		{
			Group Neutral
			
			Patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern bh_base:st_init.pt_default
						
						//TargetPlayer 1
						//Relationship target,enemy
						//ResetTarget 1
						
						SetAreaGroup AG_DEFAULT
						
						SetAttr "GrenadeType GRND_TYPE_MOLOTOV"
						SetAttr "GrenadesNum 2:3"
						SetAttr "BombardChanse 50"
						
						SetAttr "flag_VitalEnemy 1"
					}
				}
			}
		}
		
		st_idle
		{
			Group Neutral
			Patterns
			{
				xpt_SelectWeapon
				{
					actions
					{
						IfAttr "HasWeapon:Ranged > 0 Block begin"
							Weapon select,ranged
							Aim true
						Block end
						
						IfAttr "HasWeapon:Ranged == 0 and HasWeapon:melee > 0 Weapon select,melee"
					}
				}
			}
		}
		
		st_util
		{
			Group Neutral
			
			Patterns
			{
				xpt_OnAttackedByPlayer
				{
					actions
					{
						ExecutePattern st_util.xpt_CheckPlayerAgression
						ExecutePattern bh_base:st_util.xpt_OnAttackedByPlayer
					}
				}
				
				xpt_CheckPlayerAgression
				{
					actions
					{
						IfAttr "Object:caller == Object:Player Block begin"
							CheckAttr "slot#msGP.PlayerNotAttackHobo Block begin"
								RemoveAttr slot#msGP.PlayerNotAttackHobo
								SetSquadRelation Player_squad:enemy:5
							Block end
						Block end
					}
				}
				
				xpt_OnF1Spawn1
				{
					actions
					{
						SetSquad hobo_squad_F1
						SetSquadRelation Player_squad:enemy:5,douchebag_squad:enemy:2,cops_squad_lobby:enemy:1
					}
				}
				xpt_OnF1Spawn2
				{
					actions
					{
						SetAttr "F1Spawn1 2"
						SetSquad hobo_squad_F2
						SetSquadRelation Player_squad:enemy:5,douchebag_squad:enemy:2,cops_squad_yard:enemy:1
					}
				}
				xpt_OnF1Spawn3
				{
					actions
					{
						SetSquad hobo_squad_F3
						SetSquadRelation Player_squad:enemy:5,douchebag_squad:enemy:2
					}
				}
				xpt_OnB1Spawn1
				{
					actions
					{
						SetSquad hobo_squad_B1
						SetSquadRelation player_squad:enemy:5,douchebag_squad:enemy:2
					}
				}
				
				xpt_OnB1Spawn2
				{
					actions
					{
						SetSquad hobo_squad_B2
						SetSquadRelation player_squad:enemy:5,douchebag_squad:enemy:2,cops_squad_infirmary:enemy:1
					}
				}
				
				xpt_OnB1Spawn3
				{
					actions
					{
						SetSquad hobo_squad_B3
						SetSquadRelation player_squad:enemy:5,douchebag_squad:enemy:2
					}
				}
				
				xpt_InfirmarySpawn
				{
					actions
					{
						SetSquad hobo_squad_infirmary
						SetSquadRelation cops_squad_infirmary:enemy:2,player_squad:enemy:1,douchebag_squad:enemy:2
						ExecutePattern bh_base:st_util.xpt_InfirmarySpawn
					}
				}
				
				xpt_ArmorySpawn
				{
					actions
					{
						SetSquad hobo_squad_armory
						SetSquadRelation cops_squad_armory:enemy:2,player_squad:enemy:1,douchebag_squad:enemy:2
						ExecutePattern bh_base:st_util.xpt_ArmorySpawn
					}
				}
				
				xpt_YardSpawn
				{
					actions
					{
						SetSquad hobo_squad_yard
						SetSquadRelation cops_squad_yard:enemy:2,player_squad:enemy:1,douchebag_squad:enemy:2
						ExecutePattern bh_base:st_util.xpt_YardSpawn
					}
				}
				
				xpt_LobbySpawn 
				{
					actions
					{
						SetAttr "flag_CombatUsesAG 1"
						SetSquad hobo_squad_lobby
						SetSquadRelation cops_squad_lobby:enemy:2,douchebag_squad:enemy:2
						ExecutePattern bh_base:st_util.xpt_LobbySpawn
					}
				}
			}
		}
		
		st_deactivate
		{
			Group Alert
			Patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern st_util.xpt_CheckPlayerAgression
						ExecutePattern bh_base:st_deactivate.pt_default
					}
				}
			}
		}
				
	}
	events
	{
		OnAE_PlayerAttackHobo "SetSquadRelation Player_squad:enemy:5"
		OnF1Spawn1			"ExecutePattern st_util.xpt_OnF1Spawn1"
		OnF1Spawn2			"ExecutePattern st_util.xpt_OnF1Spawn2"
		OnF1Spawn3			"ExecutePattern st_util.xpt_OnF1Spawn3"
		OnB1Spawn1			"ExecutePattern st_util.xpt_OnB1Spawn1"
		OnB1Spawn2			"ExecutePattern st_util.xpt_OnB1Spawn2"
		OnB1Spawn3			"ExecutePattern st_util.xpt_OnB1Spawn3"
	}
}

behavior
{
	name bh_cop_defender
	inherited bh_pa_military
	
	States
	{
		st_init
		{
			Group Neutral
			
			Patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern bh_base:st_init.pt_default
						
						//SetSquad Cops_squad
						//SetSquadRelation Player_squad:neutral,Hobo_squad:enemy:1
						
						TargetEntByName "mission_logic"
						IfAttr "target.PlayerKillCop == 1 SetSquadRelation Player_squad:enemy:8"
						ResetTarget 1
						
						SetAttr "ea_bulletdmg_absorb RESIST_MED"
						SetAttr "ea_clubdmg_absorb RESIST_MED"
						
						//TargetPlayer 1
						//Relationship target,enemy
						//ResetTarget 1
						
						SetAreaGroup AG_DEFAULT
						
						SetAttr "ea_takeable 0"
						
						SetAttr "GrenadeType GRND_TYPE_FRAG"
						SetAttr "flag_ThrowSafe 1"
						SetAttr "flag_PlayerFriendly 1"
					}
				}
			}
		}
		
		st_start
		{
			Group Neutral
			
			Patterns
			{
				xpt_targetarrested
				{
					actions
					{
						SetAttr "rnd 0"
						ChangeAttr "rnd 0:2"
						
						IfAttr "rnd > 0 Block begin"
							Relationship target,Neutral
							ResetTarget 1
						Block end
						
						RemoveAttr rnd
					}
				}
			}
		}
		
		st_idle
		{
			Group Neutral
			Patterns
			{
				xpt_SelectWeapon
				{
					actions
					{
						//пусто
					}
				}
			}
		}
		
		st_seeweapon
		{
			Group Alert
			Patterns
			{
				pt_default
				{
					actions
					{
						IfAttr "slot#msGP.PlayerAgressive == 0 Block begin"
							IfAttr "reaction == RE_SEEWEAPON Block begin"
								SetAttr "reaction RE_NONE"
								SetAttr "NewReaction RE_NONE"
							Block end
							
							IgnoreTarget 3
							ResetTarget 1
							
							Pattern pt_end
						Block end
						
						ExecutePattern bh_base:st_seeweapon.pt_default
					}
				}
			}
		}
		
		st_OnDeath
		{
			Group Alert
			Patterns
			{
				pt_default
				{
					actions
					{
						IfAttr "Object:caller == Object:player Block begin"
							TargetFromMem msGP
							FireEvent PlayerKillCop
						Block end
						ExecutePattern bh_base:st_OnDeath.pt_default
					}
				}
			}
		}
		
		st_deactivate
		{
			Group Alert
			Patterns
			{
				pt_default
				{	
					actions
					{
						TargetCaller 1
						
						IfAttr "Object:caller != Object:player Block begin"
							AreaEvent CopDown,4
						Block end
						
						IfAttr "Object:Caller == Object:Player and slot#msGP.PlayerKillCop == 0 Block begin"
							AreaEvent PlayerKillCop,128
							TargetEntByName "npc_cop"
							FireEvent PlayerKilledMe
							TargetPlayer 1
						Block end
						
						ExecutePattern bh_base:st_deactivate.pt_default
					}
				}
			}
		}
		
		st_util
		{
			Group Neutral
			
			Patterns
			{
				xpt_OnPlayerKillCop
				{
					actions
					{
						TargetToMem msTEMP
						ExecutePattern st_util.xpt_AddPlayerToEnemy
						
						SetAttr "rnd 0,0,100"
						ChangeAttr "rnd 0:100"
						IfAttr "RelationTo:slot#msTEMP == Relation:enemy and rnd <= 30 TargetFromMem msTEMP"
						
						RemoveAttr "rnd"
						
						State st_start
					}
				}
				
				xpt_OnPlayerFailsFriendship
				{
					actions
					{
						//по дефолту пусто
					}
				}
				
				xpt_OnFFFinal
				{
					actions
					{
						Say FRIENDLYFIREFINAL
					}
				}
				
				xpt_InfirmarySpawn
				{
					actions
					{
						SetSquad cops_squad_infirmary
						SetSquadRelation hobo_squad_infirmary:enemy:2
						ExecutePattern bh_base:st_util.xpt_InfirmarySpawn
					}
				}
				
				xpt_ArmorySpawn
				{
					actions
					{
						SetSquad cops_squad_armory
						SetSquadRelation hobo_squad_armory:enemy:2
						ExecutePattern bh_base:st_util.xpt_ArmorySpawn
					}
				}
				
				xpt_YardSpawn
				{
					actions
					{
						SetSquad cops_squad_yard
						SetSquadRelation hobo_squad_yard:enemy:2
						ExecutePattern bh_base:st_util.xpt_YardSpawn
					}
				}
				
				xpt_LobbySpawn 
				{
					actions
					{
						SetSquad cops_squad_lobby
						SetSquadRelation hobo_squad_lobby:enemy:2
						ExecutePattern bh_base:st_util.xpt_LobbySpawn
					}
				}
			}
		}
	}
	
	events
	{
		OnAE_PlayerKillCop  "ExecutePattern st_util.xpt_OnPlayerKillCop"
		OnAE_HasWeapon	"IfAttr slot#msGP.PlayerAgressive == 1 SetAttr NewReaction RE_WEAPON"
		OnFire_PlayerKilledMe	"ExecutePattern st_util.xpt_OnFFFinal"
	}
}


behavior
{
	name bh_douchebag
	inherited bh_pa_military
	
	States
	{
		st_init
		{
			Group Neutral
			
			Patterns
			{
				
				pt_default
				{
					actions
					{
						ExecutePattern bh_base:st_init.pt_default
						
						SetSquad Douchebag_squad
						//SetSquadRelation Hobo_squad_F:enemy:2,Hobo_squad_B:enemy:2
						
						TargetPlayer 1
						TargetToMem msLEADER
						ResetTarget 1
						
						AvoidProhibitedArea true
						
						SetAttr "ea_bulletdmg_absorb 90"
						SetAttr "ea_clubdmg_absorb 90"
						SetAttr "ea_blastdmg_absorb 50"
						SetAttr "ea_flamedmg_absorb 90"
						SetAttr "ea_crit_disabled 1"
						SetAttr "ea_takeable 0"
						SetAttr "TaserDamage 20"
						SetAttr "SprayDamage 20"
						SetAttr "TrainingInProgress 1"
						SetAttr "voice_pitch 1"
						
						SetAreaGroup AG_DEFAULT,AG_BATTLEA,AG_BATTLEB,AG_BATTLEC,AG_BATTLED
						SetHintGroup hg_douchebag_f1
						
						Timer tCheckWang,3,repeated
						Timer tSayWang,0
						Timer tRegen,5,repeated
					}
				}
			}
		}
		
		st_start
		{
			Group Neutral
			
			Patterns
			{
				pt_default
				{
					actions
					{
						CheckAttr "TrainingInProgress State st_douchebag"
						
						SetActPack ACT_IDLE,idle
						AttributeProgressBar "DouchebagHealthPanel,show,ea_health"
						
						Pattern bh_base:st_start.pt_default
					}
				}
				
				xpt_combat
				{
					actions
					{
						IfAttr "DistTo:slot#msLEADER > ED_FAR SetAttr TaskCombat TC_MOVETO_PLAYER"
						
						IfAttr "TaskCombat == TC_MOVETO_PLAYER State st_combat_moveto"
						ExecutePattern bh_base:st_start.xpt_combat
					}
				}
				
				xpt_targetarrested
				{
					actions
					{
						Relationship target,Neutral
						IgnoreTarget 20
						ResetTarget 1
					}
				}
			}
		}
		
		st_combat_logic
		{
			Group Combat
			Patterns
			{
				xpt_setTaskDefault
				{
					actions 
					{
						SetAttr "TaskCombat TC_POSITION"
						Timer tTaskCombat,15
						State st_start
					}
				}
				
				xpt_SetTimer
				{
					actions
					{
						IfAttr "TaskCombat == TC_MOVETO_PLAYER Timer tTaskCombat,8"
						ExecutePattern bh_base:st_combat_logic.xpt_SetTimer
						IfAttr "TaskCombat == TC_SEARCH Timer tTaskCombat,5"
					}
				}
			}
		}
		
		st_combat_search
		{
			Group Alert
			Patterns
			{
				pt_search_loop
				{
					actions
					{
						IfAttr "DistTo:slot#msLEADER > ED_FAR SetAttr TaskCombat TC_MOVETO_PLAYER"
						Pattern bh_base:st_combat_search.pt_search_loop
					}
				}
			}
		}
		
		st_combat_moveto
		{
			Group Combat
			Patterns
			{
				pt_default
				{
					actions
					{
						FreeMovement false
						Face false
						Crouch false
						//WaitForEnd 1
						Aim false
						WaitForEnd 1
						
						TargetToMem msENEMY
						TargetPlayer 1
						
						MoveToTarget run,2
						
						Pattern pt_loop
					}
				}
				
				pt_loop
				{
					actions
					{
						IfAttr "DistTo:target <= ED_VERY_CLOSE SetAttr TaskStatus TASK_ST_DONE"
						Repeat 1
					}
					events
					{
						OnInvalidRoute "SetAttr FailType FAIL_INV_ROUTE"
						OnTargetReach "SetAttr TaskStatus TASK_ST_DONE"
					}
				}
				
				pt_end
				{
					actions
					{
						TargetFromMem msENEMY
						
						IfAttr "TaskStatus == TASK_ST_DONE ExecutePattern .xpt_OnTaskComplete"
						IfAttr "TaskStatus == TASK_ST_FAIL ExecutePattern .xpt_onTaskFail"
						IfAttr "TaskStatus == TASK_ST_TIME ExecutePattern .xpt_onTaskTimer"
					}
				}
				
				xpt_onTaskComplete
				{
					actions
					{
						SetAttr "TaskCombat TC_POSITION"
					}
				}
				
				xpt_onTaskFail
				{
					actions
					{
						IfAttr "FailType == FAIL_INTERRUPT SetAttr TaskCombat TC_NONE"
						IfAttr "FailType == FAIL_INV_ROUTE SetAttr TaskCombat TC_NONE"
					}
				}
				
				xpt_OnTaskTimer
				{
					actions
					{
						SetAttr "TaskCombat TC_MOVE"
					}
				}
				
				xpt_ReactionChange
				{
					actions
					{
						IfAttr "reaction >= RE_KICKED SetAttr FailType FAIL_INTERRUPT"
					}
				}
			}
			events
			{
				OnTargetClose "SetAttr TaskStatus TASK_ST_DONE"
				OnTimer_tTaskCombat "SetAttr TaskStatus TASK_ST_TIME"
				
				OnAttrChange_TaskStatus "IfAttr TaskStatus != TASK_ST_NONE Pattern pt_end"
				OnAttrChange_FailType 	"IfAttr FailType != FAIL_NONE SetAttr TaskStatus TASK_ST_FAIL"
				OnAttrChange_TaskCombat "ExecutePattern st_combat_logic.xpt_ResetTaskStatus"
			}
		}
		
		st_idle
		{
			Group Neutral
			
			Patterns
			{
				pt_default
				{
					actions
					{
						Crouch false
						Aim false
						
						//SetHintGroup hint_douchebag_b1
						//FreeMovementParams hint_all,0,512,hint_group,once,nearest
						
						SetAttr "MoveFailNum 0"
						
						//IfAttr "DistTo:Player > 64 Pattern pt_move_to_hint"
						Pattern pt_move_to_hint
						//Pattern pt_follow_player
						
						//TargetPlayer 1
						//MoveToTarget true,2,to_target
						//Wait 1.5
						//IfAttr "ea_health < 100 ChangeAttr ea_health 1"
						//State st_start
					}
				}
				
				pt_move_to_hint
				{
					actions
					{
						TargetPlayer 1
						FreeMovementParams hint_all,0,-1,hint_group,once,nearest,from_target
						FreeMovement run,reset
						Face false
						Pattern pt_run_loop
					}
				}
				
				pt_run_loop
				{
					actions
					{
						Wait 10
						Pattern pt_move_to_hint
					}
					events
					{
						OnTargetReach "Pattern pt_call_player"
						OnInvalidRoute "Pattern pt_move_failed"
					}
				}
				
				pt_move_failed
				{
					actions
					{
						ChangeAttr "MoveFailNum 1"
						IfAttr "MoveFailNum < 3 Pattern pt_move_to_hint"
						Pattern pt_start_follow_player
					}
				}
				
				pt_start_follow_player
				{
					actions
					{
						Timer tFollowPlayer,5
						Pattern pt_follow_player
					}
				}
				
				pt_follow_player
				{
					actions
					{
						TargetPlayer 1
						MoveToTarget true,2,to_target
						Repeat 1
					}
					events
					{
						OnTimer_tFollowPlayer "Pattern pt_default"
						OnTargetReach "Pattern pt_default"
						//OnInvalidRoute "Pattern pt_default"
					}
				}
				
				pt_call_player
				{
					actions
					{
						//EntFireInput "hint_douchebag,DisableHint"
						TargetPlayer 1
						Face true
						
						Timer tCheckDistance,0.5,repeated
						Timer tCallPlayer,5:10
						Wait 0.5
						Pattern pt_wait_for_player
					}
				}
				
				pt_wait_for_player
				{
					actions
					{
						Say CALLDUDE
						Sequence seq.emotions_greet,seq.emotions_hey
						//Say something
						WaitForEnd 1
						Wait 4:2
						Repeat 0
					}
					events
					{
						OnTimer_tCheckDistance "ExecutePattern .xpt_check_distance"
						OnTimer_tCallPlayer	"State st_start"
					}
				}
				
				xpt_check_distance
				{
					actions
					{
						TargetPlayer 1
						IfAttr "DistTo:Player < ED_CLOSE Pattern pt_start_follow_player"
						IfAttr "DistTo:Player > ED_FAR Pattern pt_start_follow_player"
					}
				}
				
				xpt_CheckWang
				{
					actions
					{
						IfAttr "Timer:tSayWang > 0 Return 1"
						
						TargetPlayer 1
						IfAttr "DistTo:target < ED_CLOSE and target.ea_armed == 33 Block begin"
							Say SEEWANG,1
							Timer tSayWang,8:4
						Block end
					}
				}
				
			}
			
			events
			{
				OnNewEnemy "State st_start"
				OnNewVisibleEnemy "State st_start"
				OnPlayerPass "Pattern pt_default"
				OnTimer_tCheckWang "ExecutePattern .xpt_CheckWang"
			}
		}
		
		st_douchebag
		{
			Group Neutral
			
			Patterns
			{
				pt_default
				{
					actions
					{
						SetActPack ACT_IDLE,idle_handsback
						ResetSequence 1
						TargetPlayer 1
						//Face true
						LookAt true
						
						//Repeat 1
					}
					events
					{
						OnFire_TrainingDone "Pattern pt_stop"
						OnTimer_tCheckWang "ExecutePattern .xpt_CheckWang"
					}
				}
				
				pt_stop
				{
					actions
					{
						RemoveAttr "TrainingInProgress"
						Pattern pt_end
					}
				}
				
				pt_end
				{
					actions
					{
						LookAt false
						
						IfAttr "reaction < RE_SNATCHED Block begin"
							SetAttr "NewReaction RE_NONE"
							SetAttr "reaction RE_NONE"
						Block end
						
						State st_start
					}
				}
				
				xpt_ReactionChange
				{
					actions
					{
						IfAttr "reaction >= RE_SNATCHED Pattern pt_end"
					}
				}
				
				xpt_CheckWang
				{
					actions
					{
						IfAttr "Visible:player == true ExecutePattern st_idle.xpt_CheckWang"
					}
				}
			}
		}
		
		st_OnIgnite
		{
			Group Alert
			Patterns
			{
				xpt_SelectWeapon
				{
					actions
					{
						//пусто
					}
				}
			}
		}
		
		st_deactivate
		{
			Group Alert
			Patterns
			{
				pt_default
				{
					actions
					{
						TargetFromMem msGP
						FireEvent DouchebagDead
						ExecutePattern bh_base:st_deactivate.pt_default
					}
				}
			}
		}
		
		st_util
		{
			Group Neutral
			
			Patterns
			{
				xpt_OnCopDown
				{
					actions
					{
						Say SEESDEADCOP,2
					}
				}
				
				xpt_SayHit
				{
					actions
					{
						IfAttr "Timer:tHitSound > 0 Return 1"
						IfAttr "Object:caller == Object:player Block begin"
							Say FRIENDLYFIRE
							Timer tHitSound,5:5
							Return 1
						Block end
						
						ExecutePattern bh_base:st_util.xpt_SayHit
					}
				}
			}
		}
		
	}
	
	events
	{
		OnChangeFloor "SetHintGroup hg_douchebag_b1"
		OnAE_CopDown				"ExecutePattern st_util.xpt_OnCopDown"
		OnAE_PlayerKillCop	"ExecutePattern st_util.xpt_OnCopDown"
		OnTimer_tRegen "IfAttr ea_health < 100 ChangeAttr ea_health 1"
	}
}
