Constants
{
	Const JEN_BREED,0
	Const JEN_STAY,1
	Const JEN_CHANGE_PLACE,2
	Const JEN_CALL_PLAYER,3
	
	Const JEN_DAMAGE_THRESHOLD,12
	Const JEN_HITNUM_THRESHOLD,5
}

behavior
{
	name bh_jwb_jen
	inherited bh_mall_military
	states
	{
		st_init
		{
			group Neutral
			patterns 
			{
				pt_default
				{
					actions
					{
						ExecutePattern bh_base:st_init.pt_default

						//SetAttr "ea_dmg_absorb 90"
						SetAttr "ea_bulletdmg_absorb 95"
						SetAttr "ea_clubdmg_absorb 95"
						SetAttr "TaserDamage 10"
						SetAttr "SprayDamage 20"
						SetAttr "voice_pitch 1"
//						SetAttr "ea_noknockout 1"
						
						ExecutePattern st_combat.xpt_Aggro
						SetAttr "IdleTask JEN_CHANGE_PLACE"
						SetAttr "EnemyContacted 0"
						SetAttr "push_chance 100"
						SetAttr "ea_takeable 0"
						//SetAttr "has_shovel 0"
						SetAreaGroup AG_DEFAULT:walkable,AG_BATTLE
						
						Timer tCheckHealth,0
						Timer tSyncHealth,2,repeated
						Timer tIgnoreAngry,0
						SetAttr "hp_loss 0"
						SetAttr "JenIsAngry 0"
						
						SetAttr "flag_IgnorePlayerAttack 1"
						
						Timer tCanSay,3:3
						
						// Play kill escort line if killed by the Player
						SetAttr "ea_escort 1"
					}
				}
			}
		}
		
		st_start
		{
			Group Neutral
			patterns
			{
				pt_default
				{
					actions
					{
						AttributeProgressBar "JenHealthPanel,show,ea_health"
						Timer tChangeTarget,20
                        //CheckAttr "slot#7.onfire Item drop"
						ExecutePattern bh_base:st_start.pt_default
						Repeat 1
					}
				}
				
				xpt_FirstRun
				{
					actions
					{
						//SpawnItem "spawner_melee_weapon_jen,owner,hand_right"
						//TargetItem 1
						//FireEvent ImOwner
						//TargetToMem 7
						
						// Spawn a REAL shovel for Jen
						// TODO: make this non-lethal as it's not very lore friendly lol
						AngelScript "Object:self NPCUtils GiveWeapon p3_weapon_shovel"
						
						ResetTarget 1
						ExecutePattern bh_base:st_start.xpt_FirstRun
					}
				}
				
				xpt_combat
				{
					actions
					{
						ExecutePattern bh_social:st_start.xpt_combat
					}
				}
			}
		}
        
		st_idle
		{
			Group Neutral
			patterns
			{
				pt_default
				{
					actions
					{
						
						ResetTarget 1
						IfAttr "IdleTask == JEN_BREED Pattern .pt_runByArea"
						IfAttr "IdleTask == JEN_STAY Pattern .pt_stay"
						IfAttr "Idletask == JEN_CHANGE_PLACE Pattern .pt_runByArea"
						//IfAttr "IdleTask == JEN_CALL_PLAYER Pattern .pt_CallPlayer"
					}
				}
				pt_runByArea
				{
					actions
					{
						Face false
						SetAreaGroup AG_BATTLE,AG_DEFAULT:walkable
						FreeMovementParams area_all,256,768,area_group //,once
						FreeMovement run
					}
					events
					{
						OnInvalidRoute "State st_start"
						OnTargetReach "Pattern .pt_OnReach"
					}
				}
				pt_OnReach
				{
					actions
					{
						IfAttr "IdleTask == JEN_CHANGE_PLACE Block begin"
							SetAttr "IdleTask JEN_STAY"
							State st_start
						Block end
						
						SetAttr "IdleTask JEN_STAY"
						State st_start
					}
				}
				pt_CallPlayer
				{
					actions
					{
						TargetPlayer 1
						Face True
						Wait 0.3
						Face false
						Sequence seq.emotions_greet
						WaitForEnd 1
						ExecutePattern st_combat.xpt_Aggro
						SetAttr "IdleTask JEN_STAY"
						State st_start
					}
				}
				pt_stay
				{
					actions
					{
						Sequence seq.idle
						IfAttr "EnemyContacted == 1 Block begin"
							ExecutePattern st_combat.xpt_Aggro
							SetAttr "IdleTask JEN_BREED"
						Block end
						Wait 1:1
						IfAttr "EnemyContacted == 0 SetAttr IdleTask JEN_CHANGE_PLACE"
						IfAttr "EnemyContacted == 1 SetAttr IdleTask JEN_BREED"
						State st_start
					}
				}
				xpt_OnNewEnemy
				{
					actions
					{
						SetAttr "EnemyContacted 1"
						Say FIGHT
						ExecutePattern bh_base:st_idle.xpt_OnNewEnemy
					}
				}
			
			}
		}
		
		st_OnKicked
		{
			Group Alert
			Patterns
			{
				pt_decide
				{
					actions
					{
						Pattern pt_blame
					}
				}
			}
		}
		
		st_OnNasty
		{
			Group Alert
			
			Patterns
			{
				pt_react
				{
					actions
					{
						Pattern pt_comment,pt_puke
					}
				}
				
				pt_attack
				{
					actions
					{
						Pattern pt_puke,pt_end
					}
				}
			}
		}
		
		st_combat
		{
			Group Neutral
			patterns
			{
				xpt_Aggro
				{
					actions
					{
						SetAttr "aggro 1"
						SetAttr "attackUntilHP ea_health"
						ChangeAttr "attackUntilHP -15"
						SetSquadRelation SoccerMom:enemy
					}
				}
				xpt_fear
				{
					actions
					{
						SetAttr "aggro 0"
						SetAttr "IdleTask JEN_CHANGE_PLACE"
						SetSquadRelation SoccerMom:neutral
					}
				}
			}
		}
		st_attack_melee
		{
			Group Combat
			Patterns
			{
				
				pt_default  // снимаем с себя ограничение на перемещения, наводимся на цель, и бежим к ней
				{
					actions 
					{
						Pattern bh_base:st_attack_melee.pt_default
					}
				}
				pt_decide
				{
					actions
					{
						Pattern pt_attack
					}
				}
				pt_attack  // дубасим цель и возвращаемся к старт стейту
				{
					actions 
					{
						ExecutePattern .xpt_SayFight
						//AreaEvent HitSound,4
						//Pattern bh_base:st_attack_melee.pt_attack
						Hit 1
						Wait 1
						State st_start
					}
				}
				
				pt_change_target
				{
					actions
					{
						IgnoreTarget 3
						ResetTarget 1
						TargetEnemy 1
						state st_start
					}
				}
				
				xpt_SayFight
				{
					actions
					{	
						IfAttr "Timer:tCanSay > 0 Return 1"
						Say FIGHT
						Timer tCanSay,3:5
					}
				}
				
				xpt_ReactionChange
				{
					actions
					{
						IfAttr "reaction == RE_NASTY Pattern pt_end"
						ExecutePattern bh_base:st_attack_melee.xpt_ReactionChange
					}
				}
			}
			events
			{
				OnEnemiesDead "state st_start"
				OnTargetReset "state st_start"
				OnInvalidRoute	"Pattern pt_change_target"
				OnTimer_tChangeTarget "pattern pt_change_target"
			}
		}

		ut_reactions
		{
			Group Neutral
			Patterns
			{
				xpt_Angry
				{
					actions
					{
						State st_angry
					}
				}
				
			}
		}
		
		st_angry
		{
			Group Alert
			
			Patterns
			{
				pt_default
				{
					actions
					{
						TargetPlayer 1
						Face true
						LookAt true
						Wait 0.3
						
						IfAttr "JenIsAngry == 0 Block begin"
							EmitSound female_blame
							Sequence "seq.confusion_active,seq.confusion_agressive"
							WaitForEnd 1
						Block end
						
						IfAttr "JenIsAngry == 1 Block begin"
							Timer tCheckHealth,0
							
							EmitSound female_scream
							Sequence "seq.reaction_shocked,seq.reaction_shocked_2,seq.reaction_afraid"
							WaitForEnd 1
							
							SetAttr "JenIsAngry 0"
						Block end
						
						Timer tIgnoreAngry,2
						
						State st_start
					}
				}
			}
		}

		st_deactivate	
		{
			Group Alert
			Patterns
			{
				pt_default
				{
					actions 
					{
						TargetEntByName "mission_logic"
						FireEvent "JenDead"
						ExecutePattern bh_base:st_deactivate.pt_default
					}
				}
			}
		}
		
		st_util
		{
			Group Neutral
			
			Patterns
			{
				xpt_CheckHealth
				{
					actions
					{
						SetAttr "hp ea_health"
					}
				}
				
				xpt_OnHit
				{
					actions 
					{
						ExecutePattern bh_base:st_util.xpt_OnHit
						
						//CheckAttr "JenReactAngry Block begin"
							IfAttr "Object:Caller == Object:Player and JenIsAngry == 0 and Timer:tIgnoreAngry <= 0 Block begin"
						
								IfAttr "Timer:tCheckHealth <= 0 Block begin"
									Timer tCheckHealth,5
									SetAttr "hp_loss 0"
									SetAttr "num_hits 0"
								Block end
							
								SetAttr "hp_diff hp"
								ChangeAttr "hp_diff -ea_health"
								ChangeAttr "hp_loss hp_diff"
								ChangeAttr "num_hits 1"
							
								IfAttr "hp_loss  >= JEN_DAMAGE_THRESHOLD SetAttr JenIsAngry 1"
								IfAttr "num_hits >= JEN_HITNUM_THRESHOLD SetAttr JenIsAngry 1"
							Block end
						//Block end
						
						//IfAttr "aggro == 1 Block begin"
						//	IfAttr "ea_health <= attackUntilHP ExecutePattern st_combat.xpt_Fear"
						//Block end
					}
				}
				
				xpt_OnHitConciousness
				{
					actions
					{
						//Placeholder till we can fine tune consciousness damage
						//Currently does the same amount of health damage as the banner damages consciousness
						ChangeAttr "ea_health -5"
						ExecutePattern "st_idle.xpt_OnHit"
					}
				}
			}
		}
		
	}
	events
	{
		//OnUnconscious	"State st_OnUnconscious"
		OnTimer_tSyncHealth "ExecutePattern st_util.xpt_CheckHealth"
		//OnTimer_tCheckHealth "ExecutePattern ut_reactions.xpt_Angry"
		OnHit "ExecutePattern st_idle.xpt_OnHit"
		OnConsciousChanged "ExecutePattern st_util.xpt_OnHitConciousness"
	}
}


behavior
{
	name bh_jen_cop
	inherited bh_mall_military
	states
	{
		st_init
		{
			group Neutral
			patterns 
			{
				pt_default
				{
					actions
					{
						ExecutePattern bh_base:st_init.pt_default
						
						TargetEntByName "mission_logic"
						TargetToMem msGP
						FireEvent CopSpawned
						SetSquad cop_squad
						SetSquadRelation Player_squad:enemy:3,SoccerMom:enemy:1
						SetAttr "IdleTask 0"
						SetAreaGroup AG_DEFAULT,AG_BATTLE,AG_SHOP
					}
				}
			}
		}		
		st_idle
		{
			group Neutral
			patterns
			{
				pt_default
				{
					actions
					{
						IfAttr "Object:Anchor != Object:Null Pattern pt_anchor"
						Pattern pt_breed
					}
				}
				pt_anchor
				{
					actions
					{
						TargetAnchor 1
						MoveToTarget run
						WaitForEnd 1
						Anchor false
					}
					events
					{
						OnInvalidRoute "Pattern .pt_breed"
					}
				}
				pt_breed
				{
					actions
					{
						FreeMovementParams area_all,ED_CLOSE,ED_FAR,area_group
						FreeMovement run
					}
					events
					{
						OnTargetReach "State st_start"
						OnInvalidRoute "Pattern .pt_agitate"
					}
				}
				pt_agitate
				{
					actions
					{
						FreeMovementParams area_all,0,256,once
						FreeMovement walk
					}
					events
					{
						OnTargetReach "State st_start"
						OnInvalidRoute "State st_start"
					}
				}
				xpt_OnHit
				{
					actions 
					{
						Anchor true,caller
						ExecutePattern bh_base:st_idle.xpt_OnHit
					}
				}
				xpt_OnHearCombat
				{
					actions 
					{
						//Anchor true,caller
						ExecutePattern bh_base:st_idle.xpt_OnHearCombat
					}
				}
				xpt_OnHearDanger
				{
					actions 
					{
						//Anchor true,caller
						ExecutePattern bh_base:st_idle.xpt_OnHearDanger
					}
				}
			}
		}
		st_deactivate
		{
			Group Alert
			Patterns
			{
				pt_default
				{
					actions 
					{
						TargetFromMem msGP
						FireEvent CopDead
						ExecutePattern bh_base:st_deactivate.pt_default
					}
				}
			}
		}
	}

}
