Constants
{
	Const PM2_ROBBERS_NUM,2
	Const PM2_MONKEYS_NUM,10
	Const PM2_ZEALOTS_NUM,8
	Const PM2_SNIPERS_NUM,3
	Const PM2_FIGHTER_NUM,5 //с каждой стороны
	Const PM2_CHANSE_TO_THROW,15
}

behavior
{
	name bh_mission_pm2
	inherited bh_mission_logic_base
	
	States
	{
		st_init
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						SetAttr "Crime01NotDone 1" //грабители
						SetAttr "Crime02NotDone 1" //макаки
						SetAttr "Crime03NotDone 1" //бабка
						SetAttr "Crime04NotDone 1" //снайперэ
						SetAttr "Crime05NotDone 1" //драка
						SetAttr "Crime06NotDone 1" //зилоты
						SetAttr "Crime06LogNotAdded 1"
						
						SetAttr "FirstRun 1"
						SetAttr "DoNotPlayMusicOnStart 1"
						
						SetAttr "PlayerPath PATH_GOOD"
					}
				}
			}
		}
		
		st_start
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						CheckAttr "FirstRun Pattern pt_OnFirstRun"
						ExecutePattern .xpt_CheckProgress
						ExecutePattern st_util.xpt_StopCrimeMusic
					}
				}
				
				pt_OnFirstRun
				{
					actions
					{
						EntFireInput muzak.crime,Volume:0
						//EntFireInput "pcc,Command:p3_player_skin cop"
						PlayerKarma show
						ExecutePattern st_crime01.xpt_set
						ExecutePattern st_crime02.xpt_set
						ExecutePattern st_crime05.xpt_set
						ExecutePattern st_crime06.xpt_set
						//MissionBriefing "#P3_PM2_BRIEF"
						Wait 1
						
						MissionLog add_primary,Crime01,#P3_PM2_CRIME01_PRE
						MissionLog add_primary,Crime02,#P3_PM2_CRIME02_PRE
						MissionLog add_primary,Crime03,#P3_PM2_CRIME03_PRE
						MissionLog add_primary,Crime04,#P3_PM2_CRIME04_PRE
						MissionLog add_primary,Crime05,#P3_PM2_CRIME05_PRE
						
						RemoveAttr FirstRun
						State st_start
					}
				}
				
				xpt_CheckProgress
				{
					actions
					{
						CheckAttr "Crime01NotDone Return 1"
						CheckAttr "Crime02NotDone Return 1"
						CheckAttr "Crime03NotDone Return 1"
						CheckAttr "Crime04NotDone Return 1"
						CheckAttr "Crime05NotDone Return 1"
						CheckAttr "Crime06LogNotAdded Block begin"
							MissionLog add_primary,Crime06,#P3_PM2_CRIME06_PRE
							RemoveAttr Crime06LogNotAdded
						Block end
						CheckAttr "Crime06NotDone Return 1"
						State st_end
					}
				}
				
				xpt_CheckCrime06
				{
					actions
					{
						CheckAttr "Crime01NotDone Return 1"
						CheckAttr "Crime02NotDone Return 1"
						CheckAttr "Crime03NotDone Return 1"
						CheckAttr "Crime04NotDone Return 1"
						CheckAttr "Crime05NotDone Return 1"
						CheckAttr "Crime06NotDone State st_crime06"
					}
				}
			}
			events
			{
				OnCrime01_Begin "CheckAttr Crime01NotDone State st_crime01"
				OnCrime02_Begin "CheckAttr Crime02NotDone State st_crime02"
				OnCrime03_Begin "CheckAttr Crime03NotDone State st_crime03"
				OnCrime04_Begin "CheckAttr Crime04NotDone State st_crime04"
				OnCrime05_Begin "CheckAttr Crime05NotDone State st_crime05"
				OnCrime06_Begin "ExecutePattern .xpt_CheckCrime06"
			}
		}
		
		st_crime01 //Robbers
		{
			Group Neutral
			Patterns
			{
				xpt_set
				{
					actions
					{
						SetAttr "RobbersLeft PM2_ROBBERS_NUM,0,PM2_ROBBERS_NUM,on_change_event"
					}
				}
				
				pt_default
				{
					actions
					{
						PlayVideo pm_2_2,1.0,1.0
						Wait 0.9
						
						//EntFireInput "robber_spawner,AddMaxChildren:PM2_ROBBERS_NUM"
						EntFireInput "robber_spawner_01,Enable"
						EntFireInput "robber_spawner_02,Enable"
						
						Wait 0.1
						ExecutePattern st_util.xpt_StartCrimeMusic
						ExecutePattern .xpt_UpdateRobbersInfo
						
						Wait 0.5
						ShowMessage #P3_PM2_CRIME01_MSG
					}
					events
					{
						OnFire_RobberDone "ChangeAttr RobbersLeft -1"
						OnAttrChange_RobbersLeft "ExecutePattern .xpt_UpdateRobbersInfo"
						OnAttrMin_RobbersLeft "Pattern pt_done"
						OnRobbersEscaped "Pattern pt_fail"
					}
				}
				
				pt_done
				{
					actions
					{
						ExecutePattern .xpt_UpdateRobbersInfo
						MissionLog done,Crime01
						Pattern pt_exit
					}
				}
				
				pt_fail
				{
					actions
					{
						ExecutePattern .xpt_UpdateRobbersInfo
						MissionLog fail,Crime01
						PlayerKarma -KARMA_HIGH
						AreaEvent RobbersAreFree,1024
						Pattern pt_exit
					}
				}
				
				pt_exit
				{
					actions
					{
						RemoveAttr RobbersLeft
						RemoveAttr Crime01NotDone
						EntFireInput "robber_spawner,KillHierarhy"
						State st_start
					}
				}
				
				
				xpt_UpdateRobbersInfo
				{
					actions
					{
						MissionLog add_primary,Crime01,#P3_PM2_CRIME01_LOG
					}
				}
			}
			events
			{
				OnFire_PlayerLeftCrime01	"Pattern pt_fail"
				OnFire_Crime05StartsEarly	"Pattern pt_fail"
			}
		}
		
		st_crime02 //Monkeys
		{
			Group Neutral
			Patterns
			{
				xpt_set
				{
					actions
					{
						SetAttr "MonkeysNum PM2_MONKEYS_NUM,0,PM2_MONKEYS_NUM,on_change_event"
					}
				}
				
				pt_default
				{
					actions
					{
						PlayVideo pm_2_3,1.0,1.0
						Wait 0.9
						EntFireInput "monkey_spawner,AddMaxChildren:PM2_MONKEYS_NUM"
						EntFireInput "monkey_spawner,Enable"
						Wait 0.1
						ExecutePattern st_util.xpt_StartCrimeMusic
						ExecutePattern .xpt_UpdateMonkeysInfo
						Wait 0.5
						ShowMessage #P3_PM2_CRIME02_MSG
					}
					events
					{
						OnFire_MonkeyDead "ChangeAttr MonkeysNum -1"
						OnAttrChange_MonkeysNum "ExecutePattern .xpt_UpdateMonkeysInfo"
						OnAttrMin_MonkeysNum "Pattern pt_done"
					}
				}
				
				pt_done
				{
					actions
					{
						ExecutePattern .xpt_UpdateMonkeysInfo
						MissionLog done,Crime02
						Pattern pt_exit
					}
				}
				
				pt_fail
				{
					actions
					{
						MissionLog fail,Crime02
						PlayerKarma -KARMA_HIGH
						Pattern pt_exit
					}
				}
				
				pt_exit
				{
					actions
					{
						RemoveAttr Crime02NotDone
						RemoveAttr MonkeyNum
						State st_start
					}
				}
				
				xpt_UpdateMonkeysInfo
				{
					actions
					{
						MissionLog add_primary,Crime02,#P3_PM2_CRIME02_LOG
					}
				}
			}
			events
			{
				OnFire_PlayerLeftCrime02	"Pattern pt_fail"
				OnFire_Crime05StartsEarly	"Pattern pt_fail"
			}
		}
		
		st_crime03 //Granny
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						PlayVideo pm_2_4,1.0,1.0
						Wait 0.9
						EntFireInput "victim_spawner,enable"
						EntFireInput "granny_spawner,enable"
						Wait 0.1
						SetAttr "Crime03Active 1"
						ExecutePattern st_util.xpt_StartCrimeMusic
						Wait 0.5
						
						MissionLog add_primary,Crime03,#P3_PM2_CRIME03_LOG
						ShowMessage #P3_PM2_CRIME03_MSG
					}
					events
					{
						OnFire_BabuskaDead "Pattern pt_done"
						OnFire_VictimDead "Pattern pt_fail"
					}
				}
				
				pt_done
				{
					actions
					{
						MissionLog done,Crime03
						Pattern pt_exit
					}
				}
				
				pt_fail
				{
					actions
					{
						PlayerKarma -KARMA_HIGH
						MissionLog fail,Crime03
						Pattern pt_exit
					}
				}
				
				pt_exit
				{
					actions
					{
						RemoveAttr Crime03NotDone
						RemoveAttr Crime03Active
						State st_start
					}
				}
				
				xpt_FailEarly
				{
					actions
					{
						CheckAttr "Crime03NotDone Block begin"
							MissionLog add_primary,Crime03,#P3_PM2_CRIME03_LOG
							MissionLog fail,Crime03
							PlayerKarma -KARMA_HIGH
							RemoveAttr Crime03NotDone
						Block end
					}
				}
				
				xpt_DoneEarly
				{
					actions
					{
						CheckAttr "Crime03NotDone Block begin"
							MissionLog add_primary,Crime03,#P3_PM2_CRIME03_LOG
							MissionLog done,Crime03
							RemoveAttr Crime03NotDone
						Block end
					}
				}
			}
			events
			{
				OnFire_Crime05StartsEarly	"Pattern pt_fail"
			}
		}
		
		st_crime04 //Snipers
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						PlayVideo pm_2_5,1.0,1.0
						Wait 0.9
						//EntFireInput "corpse_spawner,enable"
						EntFireInput "crime04_teleport,Teleport"
						EntFireInput "sniper1_spawner,enable"
						EntFireInput "sniper2_spawner,enable"
						EntFireInput "sniper3_spawner,enable"
						SetAttr "SnipersLeft PM2_SNIPERS_NUM,0,PM2_SNIPERS_NUM,on_change_event"
						Wait 0.1
						ExecutePattern st_util.xpt_StartCrimeMusic
						EntFireInput tg_apartments_01,Enable
						EntFireInput tg_apartments_02,Enable
						EntFireInput tg_apartments_03,Enable
						Wait 0.5
						ShowMessage #P3_PM2_CRIME04_MSG
						MissionLog add_primary,Crime04,#P3_PM2_CRIME04_LOG
					}
					events
					{
						OnFire_SniperDead "ChangeAttr SnipersLeft -1"
						OnAttrChange_SnipersLeft "MissionLog add_primary,Crime04,#P3_PM2_CRIME04_LOG"
						OnAttrMin_SnipersLeft "Pattern pt_done"
						OnApartmentsLeft	"Pattern pt_fail"
					}
				}
				
				pt_done
				{
					actions
					{
						MissionLog add_primary,Crime04,#P3_PM2_CRIME04_LOG
						MissionLog done,Crime04
						Pattern pt_exit
					}
				}
				
				pt_fail
				{
					actions
					{
						MissionLog fail,Crime04
						EntFireInput npc_sniper1,Kill
						EntFireInput npc_sniper2,Kill
						EntFireInput npc_sniper3,Kill
						PlayerKarma -KARMA_HIGH
						Pattern pt_exit
					}
				}
				
				pt_exit
				{
					actions
					{
						RemoveAttr Crime04NotDone
						State st_start
					}
				}
			}
		}
		
		st_crime05 //Fighting!
		{
			Group Neutral
			Patterns
			{
				xpt_set
				{
					actions
					{
						SetAttr "FightersMax PM2_FIGHTER_NUM"
						ChangeAttr "FightersMax *2"
						SetAttr "FightersNum FightersMax,0,FightersMax,on_change_event"
						SetAttr "FightersDead 0,0,FightersMax"
					}
				}
				
				pt_default
				{
					actions
					{
						PlayVideo pm_2_6,1.0,1.0
						Wait 1
						ExecutePattern st_util.xpt_StartCrimeMusic
						SetAttr "Crime05Active 1"
						
						Wait 0.5
						ShowMessage #P3_PM2_CRIME05_MSG
						ExecutePattern .xpt_UpdateFightersInfo
					}
					events
					{
						OnFire_FighterDead	"ExecutePattern .xpt_OnFighterDead"
						OnFire_FighterDone	"ChangeAttr FightersNum -1"
						OnAttrMax_FightersDead "Pattern pt_fail"
						OnAttrMin_FightersNum "Pattern pt_done"
						OnAttrChange_FightersNum "ExecutePattern .xpt_UpdateFightersInfo"
					}
				}
				
				pt_done
				{
					actions
					{
						ExecutePattern .xpt_UpdateFightersInfo
						MissionLog done,Crime05
						Pattern pt_exit
					}
				}
				
				pt_fail
				{
					actions
					{
						ExecutePattern .xpt_UpdateFightersInfo
						MissionLog fail,Crime05
						PlayerKarma -KARMA_HIGH
						Pattern pt_exit
					}
				}
				
				pt_exit
				{
					actions
					{
						RemoveAttr FightersNum
						RemoveAttr FightersDead
						RemoveAttr FightersMax
						RemoveAttr Crime05NotDone
						RemoveAttr Crime05Active
						State st_start
					}
				}
				
				xpt_OnFighterDead
				{
					actions
					{
						ChangeAttr "FightersNum -1"
						ChangeAttr "FightersDead +1"
					}
				}
				
				xpt_UpdateFightersInfo
				{
					actions
					{
						MissionLog add_primary,Crime05,#P3_PM2_CRIME05_LOG
					}
				}
			}
		}
		
		st_crime06 //Zealots
		{
			Group Neutral
			Patterns
			{
				xpt_set
				{
					actions
					{
						SetAttr "ZealotsMax PM2_ZEALOTS_NUM"
						ChangeAttr "ZealotsMax +1"
						SetAttr "ZealotsLeft ZealotsMax,0,ZealotsMax,on_change_event"
					}
				}
				
				pt_default
				{
					actions
					{
						PlayVideo pm_2_7,1.0,1.0
						Wait 0.9
						EntFireInput "zealot_spawner,AddMaxChildren:PM2_ZEALOTS_NUM"
						EntFireInput "fastfooder_spawner,enable"
						EntFireInput "zealot_spawner,enable"
						EntFireInput "wolverine_spawner,enable"
						
						Wait 0.1
						ExecutePattern st_util.xpt_StartCrimeMusic
						
						Wait 0.5
						ShowMessage #P3_PM2_CRIME06_MSG
						
						//MissionLog add_primary,Crime06,#P3_PM2_CRIME06_LOG
						
						SetAttr "ZealotsHere 1"
					}
					events
					{
						OnAllFastFoodersDead "Pattern pt_fail"
						OnFire_ZealotDead "ChangeAttr ZealotsLeft -1"
						OnAttrChange_ZealotsLeft "ExecutePattern .xpt_UpdateZealotsInfo"
						OnAttrMin_ZealotsLeft "Pattern pt_done"
					}
				}
				
				pt_done
				{
					actions
					{
						ExecutePattern .xpt_UpdateZealotsInfo
						MissionLog done,Crime06
						Pattern pt_exit
					}
				}
				
				pt_fail
				{
					actions
					{
						ExecutePattern .xpt_UpdateZealotsInfo
						MissionLog fail,Crime06
						PlayerKarma -KARMA_HIGH
						Pattern pt_exit
					}
				}
				
				pt_exit
				{
					actions
					{
						RemoveAttr ZealotsLeft
						RemoveAttr ZealotsMax
						RemoveAttr Crime06NotDone
						State st_start
					}
				}
				
				xpt_UpdateZealotsInfo
				{
					actions
					{
						MissionLog add_primary,Crime06,#P3_PM2_CRIME06_LOG
					}
				}
			}
		}
		
		st_end
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						EntFireInput fade_in,fade
						Wait 1
						TargetPlayer 1
						IfAttr "Karma:target == 0 Pattern pt_bad"
						Pattern pt_good
					}
				}
				
				pt_good
				{
					actions
					{
						EntFireInput "pcc,Command:video_exitcmd pm_2_8 p3_end_mission"
					}
				}
				
				pt_bad
				{
					actions
					{
						EntFireInput "pcc,Command:video_exitcmd pm_2_9 p3_end_mission"
					}
				}
			}
		}
		
		st_util
		{
			Group Neutral
			Patterns
			{
				xpt_StartCrimeMusic
				{
					actions
					{
						//Disable ambient here
						EntFireUser muzak.ambient,1
						//Start crime music
						EntFireInput "muzak.crime,FadeIn:1"
						//EntFireInput "muzak.crime,PlaySound"
					}
				}
				
				xpt_StopCrimeMusic
				{
					actions
					{
						CheckAttr "DoNotPlayMusicOnStart Block begin" //чтобы музыка не фейдилась на старте миссии
							RemoveAttr DoNotPlayMusicOnStart
							Return 1
						Block end
						
						//Enable ambient
						EntFireUser muzak.ambient,2
						//Stop crime music
						EntFireInput "muzak.crime,FadeOut:2"
					}
				}
			}
		}
	}
	events
	{
		OnFire_BabuskaDead "ExecutePattern st_crime03.xpt_DoneEarly"
		OnFire_VictimDead "ExecutePattern st_crime03.xpt_FailEarly"
		OnFire_Crime05StartsEarly	"State st_crime05"
		OnFire_FighterDead	"ExecutePattern st_crime05.xpt_OnFighterDead"
		OnFire_FighterDone	"ChangeAttr FightersNum -1"
		
		OnNewGame	"ExecutePattern weaponGive.PM2"
	}
}


behavior
{
	name bh_pm2_robber
	inherited bh_civil
	States
	{
		st_init
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern bh_base:st_init.pt_default
						
						SetAttr "ea_status sMILITANT"
						SetSquad Robbers_squad
						SetAttr "ReactionThreshold RE_FEAR"
						SetAttr "IgnorePlayerFear 1"
						SetAttr "IgnoreWeapon 1"
						
						Timer tCheckDistance,5,repeated
					}
				}
				
			}
		}
		
		st_start
		{
			Group Neutral
			Patterns
			{
				xpt_CheckCombat
				{
					actions
					{
						IfAttr "RelationTo:Player == Relation:Enemy TargetPlayer 1"
						CheckAttr "NeedToRunAway State st_runaway"
						ExecutePattern bh_base:st_start.xpt_CheckCombat
					}
				}
				
				xpt_FirstRun
				{
					actions
					{
						SpawnItem bag_spawner,owner,hand_left
						ExecutePattern bh_base:st_start.xpt_FirstRun
					}
				}
				
				xpt_combat
				{
					actions
					{
						Item drop
						ExecutePattern bh_base:st_start.xpt_combat
					}
				}
				
			}
		}
		
		st_combat_logic
		{
			Group Combat
			Patterns
			{
				xpt_SetTaskDefault
				{
					actions
					{
						SetAttr "combat_rnd 0"
						ChangeAttr "combat_rnd 0:1"
						IfAttr "combat_rnd == 0 SetAttr TaskCombat TC_POSITION"
						IfAttr "combat_rnd == 1 SetAttr TaskCombat TC_MOVE"
						RemoveAttr combat_rnd
					}
				}
			}
		}
		
		st_idle
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						//SetHintGroup "hg_robbers"
						FreeMovementParams hint_all,ED_CLOSE,ED_VERY_FAR,hint_group,nearest
						//FreeMovementParams area_all,-1,-1
						FreeMovement run
						Repeat 5
					}
					events
					{
						OnTargetReach "State st_start"
					}
				}
				
				xpt_OnHit
				{
					actions
					{
						IfAttr "Object:caller == Object:Player Block begin"
							ExecutePattern st_util.xpt_AttackedByPlayer
							ExecutePattern st_util.xpt_AddPlayerToEnemy
						Block end
						ExecutePattern st_util.xpt_OnHit
						State st_start
					}
				}
				
				xpt_OnVisible
				{
					actions
					{
						ResetTarget 1
						Return 1
						
						IfAttr "Object:caller != Object:player ResetTarget 1"
						IfAttr "Object:caller == Object:player Block begin"
							ExecutePattern st_util.xpt_AddPlayerToEnemy
							State st_start
						Block end
					}
				}
			}
			events
			{
				OnAE_PlayerBad "ExecutePattern st_util.xpt_OnPlayerBad"
			}
		}
		
		st_runaway
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						Aim false
						Crouch false
						Face false
						LookAt false
						Lean false
					
						TargetPlayer 1
						FreeMovementParams area_all,ED_FAR,-1,from_target,move_from_target
						FreeMovement run
						Timer tKill,3
						Pattern pt_loop
					}
				}
				
				pt_loop
				{
					actions
					{
						IfAttr "Timer:tKill <= 0 Npc kill"
						CheckLOS 1
						Repeat 1
					}
					events
					{
						OnLOS "Timer tKill,3"
					}
				}
				
				pt_end
				{
					actions
					{
						State st_start
					}
				}
				
				xpt_ReactionChange
				{
					actions
					{
						IfAttr "reaction >= RE_KICKED Pattern pt_end"
					}
				}
			}
		}
		
		st_OnTasing
		{
			Group Alert
			Patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern st_util.xpt_AttackedByPlayer
						Pattern bh_base:st_OnTasing.pt_default
					}
				}
			}
		}
		
		st_OnTased
		{
			Group Alert
			Patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern st_util.xpt_AttackedByPlayer
						Pattern bh_base:st_OnTased.pt_default
					}
				}
			}
		}
		
		st_deactivate
		{
			Group Alert
			Patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern st_util.xpt_AttackedByPlayer
						TargetFromMem msGP
						FireEvent RobberDone
						ExecutePattern bh_base:st_deactivate.pt_default
					}
				}
			}
		}
		
		st_util
		{
			Group Neutral
			Patterns
			{
				xpt_AddPlayerToEnemy
				{
					actions
					{
						IfAttr "RelationTo:Player == Relation:Enemy Return 1"
						
						TargetPlayer 1
						Relationship target,enemy,5
						Headblob 2,Attention
						Timer tResetHeadblob,3
						Say 2COP
						//SetSquadRelation Player_squad:enemy:5
						//AreaEvent PlayerBad,128
					}
				}
				
				xpt_AttackedByPlayer
				{
					actions
					{
						ExecutePattern st_util.xpt_AddPlayerToEnemy
						AreaEvent PlayerBad,16
					}
				}
				
				xpt_OnPlayerBad
				{
					actions
					{
						ExecutePattern st_util.xpt_AddPlayerToEnemy
						TargetPlayer 1
						State st_start
					}
				}
				
				xpt_OnStartRunaway
				{
					actions
					{
						SetAttr "NeedToRunAway 1"
						State st_start
					}
				}
				
				xpt_CheckDistance
				{
					actions
					{
						IfAttr "DistTo:Player < ED_VERY_FAR Return 1"
						TargetFromMem msGP
						FireEvent PlayerLeftCrime01
					}
				}
			}
		}
		
	}
	events
	{
		OnAE_RobbersAreFree		"ExecutePattern st_util.xpt_OnStartRunaway"
		OnTimer_tResetHeadblob	"Headblob 2,false"
		OnTimer_tCheckDistance	"ExecutePattern st_util.xpt_CheckDistance"
	}
}

