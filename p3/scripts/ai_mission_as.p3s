behavior
{
	name bh_arcade_civil
	inherited bh_civil
	
	States
	{
		st_init
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						//SetAttr "tolerance 0,0,10"
						//ChangeAttr "tolerance 5:5"
						ExecutePattern bh_base:st_init.pt_default
						SetAttr "flag_bystander 1"
					}
				}
			}
		}
		
		st_idle
		{
			Group Neutral
			Patterns
			{
				xpt_SetAreaGroup
				{
					actions
					{
						SetAreaGroup AG_DEFAULT
					}
				}
				
				xpt_SetHintGroup
				{
					actions
					{
						SetHintGroup "wish_fun_idle"
					}
				}
			}
		}
		
		ev_arcade
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						//Sequence ev_video
						//WaitForEnd 1
						FreeMovement false
						Face false
						FireInput self,InputHeadTurningOff
						
						Pattern pt_play
					}
				}
				
				pt_play
				{
					actions
					{
						Sequence ev_arcade,900
						Wait 30:60
						//WaitForEnd 1
						Pattern pt_gameover
					}
				}
				
				pt_gameover
				{
					actions
					{
						Sequence ev_reaction_arcade
						WaitForEnd 1
						Pattern pt_end
					}
				}
				
				pt_end
				{
					actions
					{
						ResetSequence 1
						FireInput self,InputHeadTurningOn
						
						IfAttr "reaction < RE_DANGER Block begin"
							SetAttr "reaction RE_NONE"
							SetAttr "NewReaction RE_NONE"
						Block end
						
						State st_start
					}
				}
				
				xpt_ReactionChange
				{
					actions
					{
						IfAttr "reaction >= RE_DANGER	Pattern pt_end"
					}
				}
			}
		}
		
	}
	
}