		ev_watchStrip
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions 
					{
						FreeMovement false
						TargetEntByName stripgirl
						LookAt true
						Face true
						Wait 1:1
						Sequence idle_common,idle_2,5:15
						WaitForEnd 1
						Wait 1:2
						Say CHEER
						Sequence emote_aggro,5:15
						WaitForEnd 1
						Wait 1:1
						Pattern pt_end
					}
				}

				pt_end
				{
					actions
					{
						ResetTarget 1
						LookAt false
						Face false
						ResetSequence 1
						SetHintGroup wish_fun_idle
						
						State st_start
					}
				}

				xpt_ReactionChange
				{
					actions
					{
						Pattern pt_end
					}
				}
			}
		}

		ev_drocher
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions 
					{
						Timer sayBusy,0.2,repeated
						FreeMovement false
						Wait 0:3
						Sequence seq.droch_med,5:15
						Wait 5:10
						SpawnItem drocha_spwn,owner,hand_right
						Item drop
						Sequence seq.idle_ScratchHair2
						WaitForEnd 1
						Sequence idle_common,idle_2,0:3
						WaitForEnd 1
						Pattern pt_end
					}
					events
					{
						OnTimer_sayBusy "AreaEvent ViewBUSY,5"
					}
				}

