Constants
{
	Const GRI_POOPS_NUM,10
	Const GRI_RHINO_TIMER,60
	Const RHINO_DAMAGE,-20
}

behavior
{
	name bh_rhino
	inherited bh_npc
	states
	{
		st_init
		{
			group Neutral
			patterns
			{
				pt_default
				{
					actions
					{
						SetAttr "TaserDamage 0"
						SetAttr "SprayDamage 0"
						SetAttr "playeragg 0"
						SetAttr "ea_autokill 0"
						SetAttr "ea_dmg_absorb 100"
						SetAttr "ea_crit_disabled 1"
						SetAttr "Crazy 0"
						SetAttr "flag_zombie 1"
						SetAttr "flag_boss 1"
						AvoidProhibitedArea true
					}
				}
			}
		}
		st_moveout
		{
			group Neutral
			patterns
			{
				pt_default
				{
					actions
					{
						TargetEntByName target_rhino
						TravelByPathTrack pt_rhino1
						IfAttr "DistTo:target < ED_CLOSE State st_start"
						Repeat 1
					}
				}
			}
			events
			{
				OnRunOut "State st_start"
				OnUser1 "Pattern st_start.pt_goberserk"
			}
		}
		st_start
		{
			group Neutral
			patterns
			{
				pt_default
				{
					actions
					{
                      //  Targetplayer 1
//                        Face true
  //                      Repeat 10
                    
                    
						IfAttr "Crazy == 1 State st_berserk"
						SetAreaGroup AG_DEFAULT:walkable,AG_rhino
						FreeMovementParams area_all,-1,-1,area_group
						FreeMovement run
						ExecutePattern pt_gallop
					}
				}
				pt_gallop
				{
					actions
					{
						TargetEntByName Randy
						FireEvent gallop
					}
				}
				pt_goberserk
				{
					actions
					{
						SetAreaGroup AG_DEFAULT,AG_battle
						State st_berserk
					}
				}
			}
			events
			{
				OnUser1 "Pattern st_start.pt_goberserk"
			}
		}
		st_berserk
		{
			group Neutral
			patterns
			{
				pt_default
				{
					actions
					{
                    
                      //  Targetplayer 1
                      //  Face true
                     //   Repeat 10
						
						Headblob 1,false
						SetAttr "Crazy 1"
						AttributeProgressBar "RhinoHealthPanel,show,ea_health"
						Timer tCraze,25:5
						Pattern pt_freerun
					}
				}
				pt_freerun
				{
					actions
					{
						ResetTarget 1
						SetAttr "got_caller 0"
						AvoidProhibitedArea true
						FreeMovementParams area_all,0,ED_FAR,area_group
						FreeMovement run
					}
					events
					{
						OnVisible "Pattern pt_gotenemy"
						OnTasingStart "Pattern pt_hateplayer"
						OnHit "Pattern pt_hateplayer"
						OnNasty "Pattern pt_hateplayer"
						OnSuperNasty "Pattern pt_hateplayer"
					}
				}
								
				pt_hateplayer
				{
					actions
					{
						Anchor true,self
						Timer tResetAnchor,8
						IfAttr "Object:Caller != Object:Player State st_berserk"
						SetAttr "playeragg 1"
						FreeMovement false
						TargetPlayer 1
                        
                        Sequence seq.unspit,5
						WaitForEnd 1
                        
                        //Face true
                        
                        Pattern pt_runloop
					}
					events
					{
						OnInvalidRoute "Pattern pt_freerun"
					}
				}
                
                pt_prepare_angry_attack:ignore_ext_events
                {
					actions
					{
						IfAttr "AngleTo:target > 3 Repeat 1"
                        
                        Sequence seq.angry
                        WaitForEnd 1
						Pattern pt_runloop
					}
				}

                
				pt_gotenemy
				{
					actions
					{
                        IfAttr "got_caller != 1 Block begin"
                            TargetCaller 1
                            IgnoreTarget 2
                            IfAttr "target.ea_Faction == Faction:Items Pattern pt_ignore"
                            IfAttr "target.ea_status == sCORPSE Pattern pt_ignore"
                            IfAttr "target.Conscious == 0 Pattern pt_ignore"
                            IfAttr "target.ea_Faction == Faction:LaserDot Pattern pt_ignore"
                            IfAttr "target.ea_Manner == Manner:Player and playeragg == 0 Pattern pt_ignore"
                            SetAttr "got_caller 1"
                        Block end
                     
                        FireEvent RhinoTarget
						
                        
						FreeMovement false
						MoveToTarget run,0.5
                        
                        IfAttr "DistTo:target <= ED_CLOSE Pattern pt_attack"
                        
                        Repeat 1
					}
					events
					{
                        OnTargetReach "Pattern pt_attack"
						OnTargetClose "Pattern pt_attack"
						OnInvalidRoute "Pattern pt_freerun"	
						OnTasingStart "Pattern pt_hateplayer"
						OnHit "Pattern pt_hateplayer"
						OnNasty "Pattern pt_hateplayer"
						OnSuperNasty "Pattern pt_hateplayer"
					}
				}
				pt_ignore
				{
					actions
					{
						IgnoreTarget 5
						ResetTarget 1
						SetAttr "got_caller 0"
						Pattern pt_default
					}
				}
				pt_runloop
				{
					actions
					{
						IfAttr "Timer:tResetAnchor <= 0 Anchor false"
						
                        IfAttr "DistTo:target <= 96 Block begin"
                            Hit 1
                            Repeat 2
                        Block end
                            
                        
						IfAttr "DistTo:target <= ED_CLOSE Block begin"
                            Move run
                            Pattern pt_moveblind
                        Block end
						
                        
                        
                        Face true
						MoveToTargetLKP run
						Repeat 1
					}
					events
					{
						//OnTargetReach "Pattern pt_attack"
                        //OnTargetClose "Pattern pt_attack"
						OnStunned "ExecutePattern st_util.xpt_CheckStun"
					}
				}
                
                pt_moveblind
                {
                	actions
					{
                        IfAttr "DistTo:target <= ED_CLOSE and AngleTo:target < 30 Pattern pt_runloop"
                        Move run
						Repeat 2
					}
					events
					{
						//OnTargetReach "Move run"
						OnStunned "ExecutePattern st_util.xpt_CheckStun"
					}
                }
                
				pt_attack
				{
					actions
					{
						TargetCaller 1
						IfAttr "Object:caller == Object:player Block begin"
							IfAttr "playeragg == 0 Pattern pt_default"
							Pattern pt_runloop
						Block end
						IfAttr "target.ea_Faction == Faction:Items Pattern pt_default"
						IfAttr "target.ea_Faction == Faction:LaserDot Pattern pt_default"
						IfAttr "target.Conscious == 0 Pattern pt_default"
						FreeMovement false
						Face true
						Hit 1
						Wait 1
						MoveToTarget run
						Repeat 1
					}
					events
					{
						OnTargetReset "Pattern pt_freerun"								
						OnTasingStart "Pattern pt_hateplayer"
						OnHit "Pattern pt_hateplayer"
						OnNasty "Pattern pt_hateplayer"
						OnSuperNasty "Pattern pt_hateplayer"
					}
				}
				pt_craze
				{
					actions
					{
						FreeMovement false
						TargetEntByName Randy
						FireEvent craze
						ResetTarget 1
						Sequence seq.unspit,5
						WaitForEnd 1
						Pattern pt_default
					}
				}
			}
			events
			{
				OnTimer_tCraze "Pattern pt_craze"
			}
		}
		st_stunned
		{
			group Alert
			patterns
			{
				pt_default:ignore_ext_events
				{
					actions
					{		
//						EntFireInput aq,SetBodyGroup:1,100
//						EntFireInput aqg,SetBodyGroup:1,100
//						EntFireInput aqp,SetBodyGroup:1,100
//						EntFireInput aqua_01,kill,100
						Face false
						ChangeAttr "ea_health RHINO_DAMAGE"
						IfAttr "ea_health <= 0 Block begin"
							EntFireUser gri_logic,4
							EntFireUser mission_logic,4
						Block end
						Sequence seq.Smashed,1
						WaitForEnd 1
						HeadBlob 1,Stars
						Sequence seq.Stuned,3
						WaitForEnd 1
						Sequence seq.stunned_in
						WaitForEnd 1
						Sequence seq.stunned_loop,2:1
                        WaitForEnd 1
						//Wait 2:1
						Headblob 1,false
						Sequence seq.stunned_out
						WaitForEnd 1
						SetAttr "playeragg 0"
						State st_berserk
					}
				}
			}
		}
		st_util
		{
			Group Neutral
			Patterns
			{
				xpt_CheckStun
				{
					actions
					{
						IfAttr "DistTo:anchor <= ED_CLOSE Return 1"
						State st_stunned
					}
				}
			}
		}
	}
	events
	{
		OnDeath "EntFireUser gri_logic,4"
	}
}
behavior
{
	name bh_rodeo_logic
	inherited bh_mission_logic_base
	states
	{
		st_init
		{
			group Neutral
			patterns
			{
				pt_default
				{
					actions
					{
						SetAttr "PlayerSide SIDE_NONE,0,10,on_change_event"
						SetAttr "Poopcollected 0"
						SetAttr "RonDead 0"
						Timer tTip,20
						SetAttr "tip 0"
						SetAttr "PlayerPath PATH_INSANE"
						SetAttr "outside 0"
					}
				}
			}
		}
		st_start
		{
			group Neutral
			patterns
			{
				pt_default
				{
					actions
					{
						PlayerKarma show
						
						EntFireInput npc_rhino,SetRider:Randy
						MissionLog add_primary,main,#P3_RODEO_MISSION1_OBJ
					}
					events
					{
						OnUser3 "ExecutePattern .xpt_poopcounter"
					}
				}
				xpt_poopcounter
				{
					actions
					{
						ChangeAttr "Poopcollected +1"
						IfAttr "Poopcollected == GRI_POOPS_NUM Pattern pt_policefight"
					}
				}
				xpt_ShowTip
				{
					actions
					{
						IfAttr "tip == 0 ShowMessage #P3_GRI_HELPER01"
						IfAttr "tip == 1 ShowMessage #P3_GRI_HELPER02"
						ChangeAttr "tip +1"
						Timer tTip,20
					}
					events
					{
						OnUser3 "ExecutePattern .xpt_poopcounter" //ниче что события в экзекьютах не обрабатываются в принципе?
					}
				}
				pt_policefight
				{
					actions
					{
						playvideo gri_2,1,1
						EntFireUser spawner_police,1
						EntFireUser spawner_zealot,1
						Wait 0.9
						EntFireUser muzak.ambient,1
						EntFireInput muzak.battle,PlaySound
						Wait 1
						MissionLog done,main
						MissionLog add_primary,main2,#P3_RODEO_MISSION12_OBJ
					}
					events
					{
						OnAttrChange_PlayerSide "ExecutePattern st_start.xpt_sidechange"
					}
				}
				xpt_sidechange
				{
					actions
					{
						AreaEvent PlayerTookSide,5000
						IfAttr "PlayerSide != SIDE_NONE Timer tRhino,GRI_RHINO_TIMER"
						MissionLog done,main2
						IfAttr "PlayerSide == SIDE_GOOD Block begin"
							ShowMessage #P3_GRI_MISSION13_MSG
							MissionLog add_primary,main3,#P3_RODEO_MISSION13_OBJ
						Block end
						IfAttr "PlayerSide == SIDE_BAD Block begin"
							ShowMessage #P3_GRI_MISSION14_MSG
							MissionLog add_primary,main3,#P3_RODEO_MISSION14_OBJ
						Block end
						IfAttr "PlayerSide == SIDE_INSANE Block begin"
							MissionLog fail,main3
							ShowMessage #P3_RODEO_MISSION15_MSG
							MissionLog add_primary,main4,#P3_RODEO_MISSION15_OBJ
						Block end
					}
				}
				pt_rhino
				{
					actions
					{
						EntFireInput muzak.battle,FadeOut:2
						playvideo gri_3,1,1
						EntFireUser npc_rhino,1
						Wait 1
						EntFireInput muzak.RhinoBattle,PlaySound
						Wait 1
						ShowMessage "#P3_RODEO_MISSION2"
						IfAttr "PlayerSide == SIDE_GOOD MissionLog done,main3"
						IfAttr "PlayerSide == SIDE_BAD MissionLog done,main3"
						IfAttr "PlayerSide == SIDE_INSANE MissionLog done,main4"
						MissionLog add_primary,main5,#P3_RODEO_MISSION2_OBJ
						MissionLog add_secondary,boss,#P3_RODEO_MISSION3_OBJ
						IfAttr "RonDead == 1 MissionLog fail,boss"
						Pattern pt_teleport
					}
				}
				pt_teleport
				{
					actions
					{
						TargetEntByName npc_rhino
						IfAttr "target.ea_health < 50 Block begin"
							IfAttr "outside == 0 Block begin"
								playvideo gri_4,1,1
								Wait 0.9
								EntFireInput rhino_teleport,Teleport
								EntFireInput npc_rhino,SetState:st_berserk
								EntFireInput player_teleport,Teleport
							Block end
							Pattern pt_empty
						Block end
						Repeat 5
					}
				}
				pt_empty
				{
					actions
					{
					}
				}
				pt_done
				{
					actions
					{
						//Mission complete
						EntFireInput proxy,Say:TASKFINISH
						Wait 2
						MissionLog done,main5
						EntFireInput fade_out,Fade
						Wait 1
						IfAttr "RonDead == 1 EntFireInput pcc,Command:video_exitcmd gri_6 p3_end_mission"
						IfAttr "RonDead == 0 Block begin"
							TargetPlayer 1
							IfAttr "Karma:target == 100 EntFireInput pcc,Command:video_exitcmd gri_5a p3_end_mission"
							IfAttr "Karma:target != 100 EntFireInput pcc,Command:video_exitcmd gri_5b p3_end_mission"
						Block end
					}
				}
				pt_rondead
				{
					actions
					{
						SetAttr "RonDead 1"
						MissionLog fail,boss
						PlayerKarma -KARMA_HALF
					}
				}
			}
			events
			{
				OnTimer_tRhino "Pattern pt_rhino"
			}
		}
	}
	events
	{
		OnRunIn "SetAttr outside 1"
		OnRunOut "SetAttr outside 0"
		OnTimer_tTip "ExecutePattern st_start.xpt_ShowTip"
		OnUser2 "ExecutePattern st_start.pt_rondead"
		OnUser4 "Pattern st_start.pt_done"
		
		OnNewGame	"ExecutePattern weaponGive.GRI"
	}
}
behavior
{
	name bh_rodeo_citizen
	inherited bh_civil
	states
	{
		st_init
		{
			group Neutral
			patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern bh_base:st_init.pt_default
						SetAttr "flag_bystander 1"
						SetAttr "goodpath 1"
						SetAttr "Conscious 1"
					}
				}
			}
		}
		st_init_gri
		{
			group Neutral
			patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern st_init.pt_default
						SetAttr "goodpath 0"
						Timer tKrotchy,1:60
						
						TargetEntByName gri_logic
						TargetToMem msGP
						ResetTarget 1
					}
				}
			}
		}
		st_idle
		{
			Group Neutral
			Patterns
			{
				xpt_ResetParams
				{
					actions
					{
						AvoidProhibitedArea false
						ExecutePattern bh_base:st_idle.xpt_ResetParams
					}
				}
			}
		}
		st_fear
		{
			group Alert
			patterns
			{
				pt_beg
				{
					actions
					{
						FreeMovement false
						Sequence seq.env_crouch,9000 
						Gesture g_emote_afraid,2:2
						SetAttr "rnd 0"
						ChangeAttr "rnd 0:10"
						IfAttr "Object:target == Object:player and rnd > 7 Say CRY,DONTKILLME"
						IfAttr "Object:target != Object:player Say CRY"
						Wait 4:4
						Pattern pt_decide
					}
				}
			}
		}
		st_jerkoff
		{
			group Neutral
			patterns
			{
				pt_default
				{
					actions
					{
						Sequence seq.weemote_droch_med,9000
						Wait 9000
						State st_start
					}
				}
				xpt_ReactionChange
				{
					actions
					{
						IfAttr "reaction >= RE_SEEFLAME State st_start"
					}
				}
			}
		}
		st_foodcustomer
		{
			group Neutral
			patterns
			{
				pt_default
				{
					actions
					{
						FreeMovement false
						TargetEntByName fastfood
						Face true
						FireEvent Customer
						Wait 5:5
						Face false
						State st_start
					}
					events
					{
						OnFire_FastFood "Pattern pt_hello"
					}
				}
				pt_hello
				{
					actions
					{
						Sequence seq.emotions_hibaby
						Say SLEEZ
						Wait 2:2
						FireEvent Response
						Wait 2:5
						Face false
						State st_start
					}
				}
				xpt_ReactionChange
				{
					actions
					{
						IfAttr "reaction >= RE_SEEFLAME State st_start"
					}
				}
			}
		}
		st_idle
		{
			group Neutral
			patterns
			{
				xpt_SetHintParams
				{
					actions
					{
						FreeMovementParams hint_all,ED_MIDDLE,ED_VERY_FAR,hint_group,hint_face,use_node,once
						CheckAttr "flag_static FreeMovementParams hint_all,-1,-1,hint_group,hint_face,use_node,once"
					}
				}
			}
		}
		st_fastfood
		{
			group Neutral
			patterns
			{
				pt_default
				{
					actions
					{
						ResetSequence 1
						FreeMovement false
						Timer tFoodIdle,1:10
					}
					events
					{
						OnTimer_tFoodIdle "Pattern pt_idle"
						OnFire_Customer "Pattern pt_customer"
					}
				}
				pt_customer
				{
					actions
					{
						TargetCaller 1
						IgnoreTarget 30
						Sequence seq.dialogue_phrase1
						Say GREET
						Wait 1:1
						FireEvent FastFood
						Wait 10
						State st_fastfood
					}
					events
					{
						OnTargetReset "State st_fastfood"
						OnFire_Response "Pattern pt_leadout"
						OnFire_Customer "Pattern pt_customer"
					}
				}
				pt_leadout
				{
					actions
					{
						Sequence seq.dialogue_no
						Say DISINTEREST,NEGATIVE
						Wait 2
						State st_fastfood
					}
					events
					{
						OnFire_Customer "Pattern pt_customer"
					}
				}
				pt_idle
				{
					actions
					{
						Sequence seq.idle_ScratchAss,seq.idle_ScratchNose1
						WaitForEnd 1
						State st_fastfood
					}
					events
					{
						OnFire_Customer "Pattern pt_customer"
					}
				}
				xpt_ReactionChange
				{
					actions
					{
						IfAttr "reaction >= RE_SEEFLAME State st_start"
					}
				}
			}
		}
		ev_chair
		{
			group Neutral
			patterns
			{
				pt_default:ignore_ext_events
				{
					actions
					{
						Timer tSitIdle,20:10
						Sequence ev_chair,9000
						Wait 5000:4000
						Repeat 0
					}
					events
					{
						OnHearCombat "Pattern pt_out"
						OnHearDanger "Pattern pt_out"
						OnHit "Pattern pt_out"
						OnTimer_tSitIdle "ExecutePattern pt_idle"
					}
				}
				pt_idle
				{
					actions
					{
						Gesture g_idle_sitting,5
						Timer tSitIdle,10:20
					}
				}
				pt_out:ignore_ext_events
				{
					actions
					{
						ResetSequence 1
						Wait 1:1
						State st_start	
					}
				}
				xpt_ReactionChange
				{
					actions
					{
						IfAttr "reaction >= RE_SEEFLAME State st_start"
					}
				}
			}
		}
		st_start
		{
			group Neutral
			patterns
			{
				pt_seerhino
				{
					actions
					{
						Say SEESRHINO
					}
				}
				pt_seekrotchy
				{
					actions
					{
						IfAttr "DistTo:player < ED_MIDDLE Block begin"
							TargetPlayer 1
							Say SEESKROTCHY
						Block end
						Timer tKrotchy,1:60
					}
				}
			}
		}
		st_util
		{
			Group Neutral
			Patterns
			{
				xpt_OnHit
				{
					actions
					{
						IfAttr "Object:caller == Object:player and goodpath == 1 EntFireInput proxy,Say:INJUREBYSTANDER"
						ExecutePattern bh_base:st_util.xpt_OnHit
					}
				}
			}
		}
		st_OnDeath
		{
			Group Alert
			Patterns
			{
				pt_default
				{
					actions
					{
						IfAttr "Object:caller == Object:player Block begin"
							//TargetPlayer 1
							IfAttr "goodpath == 1 EntFireInput proxy,Say:KILLBYSTANDER"
							IfAttr "slot#msGP.poopcollected >= 5 Block begin"
								IfAttr "slot#msGP.PlayerSide == SIDE_NONE SetAttr slot#msGP.PlayerSide SIDE_BAD"
								IfAttr "slot#msGP.PlayerSide == SIDE_GOOD SetAttr slot#msGP.PlayerSide SIDE_INSANE"
								//ChangeAttr "target.ea_karma +5"
							Block end
						Block end
						ExecutePattern bh_base:st_OnDeath.pt_default
					}
				}
			}
		}
	}
	events
	{
		OnTimer_tKrotchy "ExecutePattern st_start.pt_seekrotchy"
		OnFire_RhinoTarget "ExecutePattern st_start.pt_seerhino"
	}
}
behavior
{
	name bh_gri_military
	inherited bh_civil
	States
	{
		st_init
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern bh_base:st_init.pt_default
						
						TargetEntByName gri_logic
						TargetToMem msGP
						ResetTarget 1
						
						SetAttr "flag_IgnorePlayerFear 1"
						SetAttr "flag_IgnoreCombat 1"
						SetAttr "flag_IngoreWeapon 1"
						
						SetAttr "flag_protected 1"
						SetAttr "rnd 0"
						ChangeAttr "rnd 0:9"
						IfAttr "rnd == 0 RemoveAttr flag_protected"
						RemoveAttr rnd
						
						SetAttr "OurSide SIDE_NONE"		//наша сторона
						SetAttr "EnemySide SIDE_NONE"	//сторона врагов
					}
				}
			}
		}
		st_idle
		{
			group Neutral
			patterns
			{
				pt_default
				{
					actions
					{
						FreeMovementParams area_all,-1,-1,area_group
						FreeMovement run
						TargetEnemy 1
						Wait 10
						State st_start
					}
					events
					{
						OnTargetReach "State st_start"
						OnInvalidRoute "State st_start"
					}
				}
			}
		}
		st_util
		{
			Group Neutral
			Patterns
			{
				xpt_OnAttackedByPlayer
				{
					actions
					{
						IfAttr "slot#msGP.PlayerSide == SIDE_NONE SetAttr slot#msGP.PlayerSide EnemySide"
						
						ExecutePattern bh_base:st_util.xpt_OnAttackedByPlayer
					}
				}
				
				xpt_OnPlayerSideChange
				{
					actions
					{
						IfAttr "slot#msGP.PlayerSide == OurSide Block begin"
							SetAttr "flag_PlayerFriendly 1"
							SetAttr "flag_IgnorePlayerAttack 1"
						Block end
						IfAttr "slot#msGP.PlayerSide != OurSide Block begin"
							RemoveAttr flag_PlayerFriendly
							RemoveAttr flag_IgnorePlayerAttack
						Block end
						
						IfAttr "slot#msGP.PlayerSide == EnemySide	ExecutePattern st_util.xpt_AddPlayerToEnemy"
						IfAttr "slot#msGP.PlayerSide == SIDE_INSANE ExecutePattern st_util.xpt_AddPlayerToEnemy"
					}
				}
			}
		}
		st_deactivate
		{
			Group Alert
			Patterns
			{
				pt_default
				{
					actions
					{
						IfAttr "Object:caller == Object:player Block begin"
							IfAttr "slot#msGP.PlayerSide == SIDE_NONE SetAttr slot#msGP.PlayerSide EnemySide"
							IfAttr "slot#msGP.PlayerSide == OurSide SetAttr slot#msGP.PlayerSide SIDE_INSANE"
						Block end
						ExecutePattern bh_base:st_deactivate.pt_default
					}
				}
			}
		}
	}
	events
	{
		OnAE_PlayerTookSide "ExecutePattern st_util.xpt_OnPlayerSideChange"
	}
}
behavior
{
	name bh_rodeo_police
	inherited bh_gri_military
	states
	{
		st_init
		{
			group Neutral
			patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern bh_base:st_init.pt_default
						
						SetAreaGroup AG_DEFAULT:walkable,AG_battle
						SetSquad sq_police
						SetSquadRelation sq_zea:enemy:3
						
						SetAttr "TaskCombat TC_SEARCH"
						
						SetAttr "OurSide	SIDE_GOOD"
						SetAttr "EnemySide	SIDE_BAD"
						
						Timer tComment,5:10
					}
				}
			}
		}
		st_util
		{
			Group Neutral
			Patterns
			{
				xpt_CommentAttack
				{
					actions
					{
						IfAttr "target.ea_Faction == Faction:Zealots Say SHOOTECO"
						IfAttr "target.ea_Manner == Manner:player and slot#msGP.PlayerSide != SIDE_GOOD EntFireInput proxy,Say:KCOPATTAC"
						Timer tComment,5:10
					}
				}
			}
		}
	}
	events
	{
		OnTimer_tComment "ExecutePattern st_util.xpt_CommentAttack"
	}
}

