UnlitGeneric
{
    $basetexture "vgui/hud/save_icon"

    $translucent 1

    $vertexcolor 1
    $vertexalpha 1
    $ignorez 1

    $nomip 1

    Proxies
    {
        AnimatedTexture
        {
            animatedTextureVar $basetexture
            animatedTextureFrameNumVar $frame
            animatedTextureFrameRate 10
        }
    }
}