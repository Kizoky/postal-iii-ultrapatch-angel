behavior
{
	name bh_prop_aidkit
	inherited bh_prop_interactable_core
	States
	{
		prop_init
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern bh_base:prop_init.pt_default
						
						AngelScript "Object:self Interactable_AidKit Setup"
					}
				}
			}
		}
		
		prop_start
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern bh_base:prop_start.pt_default
					}
				}
			}
			events
			{
				OnUseCommand "State prop_open"
			}
		}
		
		prop_open
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						AngelScript "Object:self Interactable_AidKit OnUseCommand"
					}
				}
			}
		}
	}	
}