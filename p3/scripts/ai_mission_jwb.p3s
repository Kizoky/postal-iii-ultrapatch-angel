	}
	
}

behavior
{
	name bh_jwb_civil
	inherited bh_jwb_bridge
	states
	{
		st_init
		{
			group Neutral
			patterns 
			{
				pt_default
				{
					actions
					{
						ExecutePattern bh_base:st_init.pt_default
						
						IfAttr "Name:self == String:npc_shopper SetAttr shopping 1"
						SetSquadRelation SoccerMom:fear
						
						SetAttr "flag_bystander 1"
					}
				}
			}
		}
		st_init_static
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern bh_base:st_init.pt_default
						SetAttr "flag_static 1"
					}
				}
			}
		}
		st_idle
		{
			group Neutral
			patterns
			{
				xpt_SetAreaGroup
				{
					actions
					{
						SetAreaGroup AG_DEFAULT,AG_BATTLE
						CheckAttr "shopping SetAreaGroup AG_SHOP"
					}
				}
				xpt_SetHintGroup
				{
					actions
					{
						CheckAttr "flag_static Return 1"
						SetHintGroup wish_fun_idle
						CheckAttr "shopping SetHintGroup wish_fun_shop"
					}
				}
				
				xpt_OnHit
				{
					actions 
					{
						IfAttr "caller.ea_ActiveWeapon >= 6 AreaEvent NPCUnderFire,384"
						ExecutePattern bh_base:st_idle.xpt_OnHit
					}
				}
				xpt_OnHearCombat
				{
					actions 
					{
						//ExecutePattern .xpt_callForPolice
						//ExecutePattern bh_base:st_idle.xpt_OnHearCombat
					}
				}
				xpt_OnHearDanger
				{
					actions 
					{
						//ExecutePattern .xpt_callForPolice
						//ExecutePattern bh_base:st_idle.xpt_OnHearDanger
					}
				}
				xpt_callForPolice
				{
					actions
					{
						TargetToMem msTEMP
						TargetFromMem msGP
						FireEvent HearWar
						TargetFromMem msTEMP
					}
				}
				
			}
		}
		
	}
	
	events
	{
		OnHit "ExecutePattern st_idle.xpt_OnHit"
		OnAE_NPCUnderFire "ExecutePattern st_idle.xpt_CallForPolice"
		//OnShopSpawn "SetAttr shopping 1"    
	}
}

