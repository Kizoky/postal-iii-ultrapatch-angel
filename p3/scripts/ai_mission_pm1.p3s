						IfAttr "Object:caller == Object:player Block begin"
							SetSquadRelation player_squad:enemy
							Headblob 2,false
							State st_start
						Block end
					}
				}
			}
		}
	}
	events
	{
		OnTimer_tSay "ExecutePattern st_start.pt_say"
		OnHit "ExecutePattern st_mission.pt_hit"
		OnTargetReset "Pattern st_mission.pt_runaway"
	}
}
behavior
{
	name bh_patrol_bum
	inherited bh_civil
	states
	{
		st_init
		{
			group Neutral
			patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern bh_base:st_init.pt_default
						SetAttr "running 0"
						//SetAttr "ea_dmg_absorb 100"
						//SetAttr "TaserDamage 0"
						//SetAttr "ea_crit_disabled 1"
						SetAttr "ignoreplayer 1"
						
						SetAttr "flag_IgnoreCombat 1"
						SetAttr "flag_IgnoreWeapon 1"
						SetAttr "flag_IgnorePlayerAttack 1"
						SetAttr "flag_IgnorePlayerFear 1"
						SetAttr "ReactionThreshold RE_DANGER"
					}
				}
			}
		}
		st_idle
		{
			group Neutral
			patterns
			{
				pt_default
				{
					actions
					{
						IfAttr "running == 1 Pattern pt_run"
						Senses false
						Weapon disarm
						Sequence seq.weemote_idle,10:20
						Wait 1:5
						CheckAttr "slot#msGP.Crime02Active Block begin"
							IfAttr "DistTo:player > ED_MIDDLE Repeat 0"
							Timer tRun,5:5
							Say 2COP
							Wait 5:5
						Block end
						Repeat 1
					}
					events
					{
						OnTimer_tRun "Pattern st_idle.pt_run"
					}
				}
				pt_run
				{
					actions
					{
						SetAttr "running 1"
						Headblob 2,Attention
						IfAttr "Conscious == 0 and DistTo:player > ED_FAR npc kill"
						FreeMovementParams area_all,ED_FAR,5000,area_group
						FreeMovement run
						IfAttr "DistTo:player > ED_VERY_FAR Block begin"
							ExecutePattern .xpt_fail
							Headblob 2,false
							npc kill
						Block end
						Repeat 2
					}
				}
				xpt_aggro
				{
					actions
					{
						IfAttr "ignoreplayer == 1 Return 1"
						IfAttr "Object:caller == Object:Player Block begin"
							TargetPlayer 1
							SetSquadRelation player_squad:enemy
							Weapon arm
							SetAttr "TaskCombat TC_POSITION"
							Headblob 2,false
							State st_start
						Block end
					}
				}
				xpt_fail
				{
					actions
					{
						EntFireInput mission_logic,FireFSMScriptEvent:OnFailedObj2
					}
				}
			}
		}
		st_OnIgnite
		{
			Group Alert
			Patterns
			{
				pt_default
				{
					actions
					{
						CheckAttr "NotAttackedByPlayer ExecutePattern st_util.xpt_OnAttackedByPlayer"
						Pattern bh_base:st_OnIgnite.pt_default
					}
				}
			}
		}
		st_util
		{
			Group Neutral
			Patterns
			{
				xpt_OnAttackedByPlayer
				{
					actions
					{
						TargetFromMem msGP
						FireEvent Crime02StartsEarly
						SetAttr "running 1"
						ExecutePattern bh_base:st_util.xpt_OnAttackedByPlayer
					}
				}
			}
		}
		st_deactivate
		{
			Group Alert
			Patterns
			{
				pt_default
				{
					actions
					{
						Headblob 2,false
						EntFireInput mission_logic,FireFSMScriptEvent:OnAccomplish2
						ExecutePattern bh_base:st_deactivate.pt_default
					}
				}
			}
		}
	}
}

behavior
{
	name bh_robber 
	inherited bh_citizen 
	states
	{
		st_init
		{
			group Neutral
			patterns
			{
				pt_default
				{
					actions 
					{
						ExecutePattern bh_base:st_init.pt_default
						FreeMovementParams area_all,ED_FAR,5000,area_group
						SetAttr "active 1"
							
						TargetEntByName mission_logic
						TargetToMem msGP
						ResetTarget 1
						SetAttr "ea_status sKILLER"
						SetAttr "flag_VitalEnemy 1"
						//пока считаю, что за убийство этих вооруженных чуваков в масках не надо снимать карму, но это обсуждаемо
						//имхо, таск должен фейлиться, если они куда-нибудь свалили или дюд свалил от них
					}
				}
			}
		}
		st_runaway
		{
			group Alert
			patterns
			{
				pt_default
				{
					actions
					{
						Senses false	
						Headblob 2,Attention
						FreeMovement run
						SetAttr "rnd 0"
						ChangeAttr "rnd 0:3"
						IfAttr "rnd > 1 Pattern pt_hateplayer"
						IfAttr "DistTo:player > 1200 Block begin"
							EntFireInput mission_logic,FireFSMScriptEvent:OnFailedObj6
							Headblob 2,false
							npc kill
						Block end
						Repeat 2
					}
				}
				pt_death
				{
					actions
					{
						IfAttr "Conscious == 1 EntFireInput mission_logic,FireFSMScriptEvent:OnGotRobber"
					}
				}
				pt_hateplayer
				{
					actions
					{
						TargetPlayer 1
						Relationship target,enemy
						MoveToTarget run,ED_MIDDLE
						Headblob 2,Attention
						State st_start
					}
				}
			}
		}
		st_idle
		{
			group neutral
			patterns
			{
				pt_default
				{
					actions
					{
						Pattern st_runaway.pt_default
					}
				}
			}
		}
		st_deactivate
		{
			Group Alert
			Patterns
			{
				pt_default:ignore_ext_events
				{
					actions
					{
						SetAttr "Conscious 0"
						Headblob 2,false
						SetAttr "ea_status sVICTIM"
						EntFireInput mission_logic,FireFSMScriptEvent:OnGotRobber
						
						ExecutePattern bh_base:st_deactivate.pt_default
					}
				}
			}
		}
	}
	events
	{
		OnDeath "ExecutePattern st_runaway.pt_death"
		OnHit "ExecutePattern st_runaway.pt_hateplayer"
		//OnTased "ExecutePattern st_stage1.xpt_GotHit"
		OnKicked "ExecutePattern st_runaway.pt_hateplayer"
		OnArrested "State st_deactivate"
		OnUnconscious "State st_deactivate"
		OnHearDanger "Wait 0"
		OnHearCombat "Wait 0"
	}
}

behavior
{
	name bh_patrol_logic
	inherited bh_mission_logic_base
	states
	{
		st_init
		{
			group Neutral
			patterns
			{
				pt_default
				{
					actions
					{
						SetAttr "PlayerPath PATH_GOOD"
						SetAttr "TasksDone 0"
						
						SetAttr "Crime01NotDone 1"
						SetAttr "Crime02NotDone 1"
						SetAttr "Crime03NotDone 1"
						SetAttr "Crime04NotDone 1"
						SetAttr "Crime05NotDone 1"
						SetAttr "Crime06NotDone 1"
					}
				}
			}
		}
		st_start
		{
			group Neutral
			patterns
			{
				pt_default
				{
					actions
					{
						PlayerKarma show
						EntFireInput muzak.crime,Volume:0
						MissionLog add_primary,obj1,#P3_PM1_OBJ_01
						MissionLog add_primary,obj2,#P3_PM1_OBJ_02
						MissionLog add_primary,obj3,#P3_PM1_OBJ_03
						MissionLog add_primary,obj4,#P3_PM1_OBJ_04
						MissionLog add_primary,obj5,#P3_PM1_OBJ_05
						MissionLog add_primary,obj6,#P3_PM1_OBJ_06
						EntFireInput bum_creator,Enable
					}
				}
				pt_checktasks
				{
					actions
					{
						ChangeAttr "TasksDone +1"
						IfAttr "TasksDone == 6 State st_aq"
					}
				}
				xpt_StartCrime02
				{
					actions
					{
						EntFireInput trigger_hobo,Kill
						State st_hobo
					}
				}
			}
			events
			{
				OnFire_Crime02StartsEarly "ExecutePattern .xpt_StartCrime02"
			}
		}
		st_vandal
		{
			group Neutral
			patterns
			{
				pt_default
				{
					actions
					{
						EntFireInput trigger_pawnshop,Disable
						EntFireInput trigger_mugger,Disable
						EntFireInput trigger_hobo,Disable
						EntFireInput trigger_brawl,Disable
						EntFireInput trigger_cat,Disable
						playvideo pm_1_6,1,1
						Wait 0.5
						ExecutePattern st_util.xpt_StartCrimeMusic
						//Wait 0.3
						EntFireInput vandal_creator,Spawn
						MissionLog add_primary,obj1,#P3_PM1_OBJ_1
					}
				}
				pt_done
				{
					actions
					{
						MissionLog done,obj1
						Pattern pt_end
					}
				}
				pt_fail
				{
					actions
					{
						PlayerKarma -KARMA_HIGH
						MissionLog fail,obj1
						Pattern pt_end
					}
				}
				
				pt_end
				{
					actions
					{
						RemoveAttr Crime01NotDone
						ExecutePattern st_util.xpt_StopCrimeMusic
						EntFireInput trigger_pawnshop,Enable
						EntFireInput trigger_mugger,Enable
						EntFireInput trigger_hobo,Enable
						EntFireInput trigger_brawl,Enable
						EntFireInput trigger_cat,Enable
						Pattern st_start.pt_checktasks
					}
				}
			}
			events
			{
				OnAccomplish1 "Pattern pt_done"
				OnFailedObj1 "Pattern pt_fail"
			}
		}
		st_hobo
		{
			group Neutral
			patterns
			{
				pt_default
				{
					actions
					{
						EntFireInput trigger_pawnshop,Disable
						EntFireInput trigger_mugger,Disable
						EntFireInput trigger_vandal,Disable
						EntFireInput trigger_brawl,Disable
						EntFireInput trigger_cat,Disable
						EntFireUser bum,2
						playvideo pm_1_7,1,1
						Wait 0.5
						SetAttr "Crime02Active 1"
						MissionLog add_primary,obj2,#P3_PM1_OBJ_2
						ExecutePattern st_util.xpt_StartCrimeMusic
					}
					events
					{
						OnAccomplish2 "Pattern pt_done"
						OnFailedObj2 "Pattern pt_fail"
					}
				}
				pt_done
				{
					actions
					{
						MissionLog done,obj2
						Pattern pt_end
					}
				}
				pt_fail
				{
					actions
					{
						PlayerKarma -KARMA_HIGH
						MissionLog fail,obj2
						Pattern pt_end
					}
				}
				
				pt_end
				{
					actions
					{
						RemoveAttr Crime02Active
						RemoveAttr Crime02NotDone
						ExecutePattern st_util.xpt_StopCrimeMusic
						EntFireInput trigger_pawnshop,Enable
						EntFireInput trigger_mugger,Enable
						EntFireInput trigger_vandal,Enable
						EntFireInput trigger_brawl,Enable
						EntFireInput trigger_cat,Enable
						Pattern st_start.pt_checktasks
					}
				}
			}
		}
		st_mugger
		{
			group Neutral
			patterns
			{
				pt_default
				{
					actions
					{
						EntFireInput trigger_pawnshop,Disable
						EntFireInput trigger_hobo,Disable
						EntFireInput trigger_vandal,Disable
						EntFireInput trigger_brawl,Disable
						EntFireInput trigger_cat,Disable
						playvideo pm_1_2,1,1
						Wait 0.5
						ExecutePattern st_util.xpt_StartCrimeMusic
						//Wait 0.3
						EntFireInput thief_creator,Spawn
						EntFireInput thief_victim_creator,Spawn
						MissionLog add_primary,obj3,#P3_PM1_OBJ_3
					}
					events
					{
						OnAccomplish3 "Pattern pt_done"
						OnFailedObj3 "Pattern pt_fail"
					}
				}
				pt_done
				{
					actions
					{
						MissionLog done,obj3
						Pattern pt_end
					}
				}
				pt_fail
				{
					actions
					{
						PlayerKarma -KARMA_HIGH
						MissionLog fail,obj3
						Pattern pt_end
					}
				}
				pt_end
				{
					actions
					{
						RemoveAttr Crime03NotDone
						ExecutePattern st_util.xpt_StopCrimeMusic
						EntFireInput trigger_pawnshop,Enable
						EntFireInput trigger_hobo,Enable
						EntFireInput trigger_vandal,Enable
						EntFireInput trigger_brawl,Enable
						EntFireInput trigger_cat,Enable
						Pattern st_start.pt_checktasks
					}
				}
			}
		}
		st_brawl
		{
			group Neutral
			patterns
			{
				pt_default
				{
					actions
					{	
						EntFireInput trigger_pawnshop,Disable
						EntFireInput trigger_hobo,Disable
						EntFireInput trigger_vandal,Disable
						EntFireInput trigger_mugger,Disable
						EntFireInput trigger_cat,Disable
						playvideo pm_1_3,1,1
						Wait 0.5
						ExecutePattern st_util.xpt_StartCrimeMusic
						//Wait 0.3
						SetAttr "gotfighters 0"
						EntFireInput guyfight1_creator,Spawn
						EntFireInput guyfight2_creator,Spawn
						MissionLog add_primary,obj4,#P3_PM1_OBJ_4
					}
					events
					{
						OnAccomplish4 "ExecutePattern pt_counter"
						OnFailedObj4 "Pattern pt_fail"
					}
				}
				pt_counter
				{
					actions
					{
						ChangeAttr "gotfighters +1"
						IfAttr "gotfighters == 2 Pattern pt_done"
					}
					events
					{
					}
				}
				pt_done
				{
					actions
					{
						MissionLog done,obj4
						Pattern pt_end
					}
				}
				pt_fail
				{
					actions
					{
						PlayerKarma -KARMA_HIGH
						MissionLog fail,obj4
						Pattern pt_end
					}
				}
				pt_end
				{
					actions
					{
						RemoveAttr Crime04NotDone
						ExecutePattern st_util.xpt_StopCrimeMusic
						EntFireInput trigger_pawnshop,Enable
						EntFireInput trigger_hobo,Enable
						EntFireInput trigger_vandal,Enable
						EntFireInput trigger_mugger,Enable
						EntFireInput trigger_cat,Enable
						Pattern st_start.pt_checktasks
					}
				}
			}
		}
		st_cat
		{
			group Neutral
			patterns
			{
				pt_default
				{
					actions
					{
						EntFireInput trigger_pawnshop,Disable
						EntFireInput trigger_hobo,Disable
						EntFireInput trigger_vandal,Disable
						EntFireInput trigger_mugger,Disable
						EntFireInput trigger_brawl,Disable
						playvideo pm_1_4,1,1
						Wait 0.5
						ExecutePattern st_util.xpt_StartCrimeMusic
						//Wait 0.3
						EntFireInput cat_victim_creator,Spawn
						EntFireInput cat_creator,Spawn
						MissionLog add_primary,obj5,#P3_PM1_OBJ_5
					}
					events
					{
						OnAccomplish5 "Pattern pt_done"
						OnFailedObj5 "Pattern pt_fail"
					}
				}
				pt_done
				{
					actions
					{
						MissionLog done,obj5
						Pattern pt_end
					}
				}
				pt_fail
				{
					actions
					{
						PlayerKarma -KARMA_HIGH
						MissionLog fail,obj5
						Pattern pt_end
					}
				}
				pt_end
				{
					actions
					{
						RemoveAttr Crime05NotDone
						ExecutePattern st_util.xpt_StopCrimeMusic
						EntFireInput trigger_pawnshop,Enable
						EntFireInput trigger_hobo,Enable
						EntFireInput trigger_vandal,Enable
						EntFireInput trigger_mugger,Enable
						EntFireInput trigger_brawl,Enable
						Pattern st_start.pt_checktasks
					}
				}
			}
		}
		st_pawnshop
		{
			group Neutral
			patterns
			{
				pt_default
				{
					actions
					{
						EntFireInput trigger_cat,Disable
						EntFireInput trigger_hobo,Disable
						EntFireInput trigger_vandal,Disable
						EntFireInput trigger_mugger,Disable
						EntFireInput trigger_brawl,Disable
						playvideo pm_1_5,1,1
						SetAttr "gotem 0"
						Wait 0.5
						ExecutePattern st_util.xpt_StartCrimeMusic
						//Wait 0.3
						EntFireInput robber_creator,Enable
						MissionLog add_primary,obj6,#P3_PM1_OBJ_6
					}
					events
					{
						OnGotRobber "ExecutePattern .xpt_count"
						OnFailedObj6 "Pattern pt_fail"
					}
				}
				xpt_count
				{
					actions
					{
						ChangeAttr "gotem +1"
						IfAttr "gotem == 3 Pattern pt_done"
					}
					events
					{
						OnGotRobber "Repeat 0"
						OnFailedObj6 "Pattern pt_fail"
					}
				}
				pt_done
				{
					actions
					{
						MissionLog done,obj6
						Pattern pt_end
					}
				}
				pt_fail
				{
					actions
					{
						PlayerKarma -KARMA_HIGH
						MissionLog fail,obj6
						Pattern pt_end
					}
				}
				pt_end
				{
					actions
					{
						RemoveAttr Crime06NotDone
						ExecutePattern st_util.xpt_StopCrimeMusic
						EntFireInput trigger_cat,Enable
						EntFireInput trigger_hobo,Enable
						EntFireInput trigger_vandal,Enable
						EntFireInput trigger_mugger,Enable
						EntFireInput trigger_brawl,Enable
						Pattern st_start.pt_checktasks
					}
				}
			}
		}
		st_aq
		{
			group Neutral
			patterns
			{
				pt_default
				{
					actions
					{
						playvideo pm_1_8,1,1
						Wait 0.9
						EntFireInput talib_creator,Enable
						MissionLog Clear
						SetAttr "fragsleft PM1_TALIB_FRAGS"
						MissionLog add_primary,main,#P3_PM1_OBJ_AQ
						Wait 1
						ExecutePattern st_util.xpt_StartCrimeMusic
						
					}
					events
					{
						OnUser1 "ExecutePattern st_aq.pt_counter"
					}
				}
				pt_counter
				{
					actions
					{
						ChangeAttr "fragsleft -1"
						MissionLog add_primary,main,#P3_PM1_OBJ_AQ
						IfAttr "fragsleft == 0 Pattern pt_end"
					}
				}
				pt_end
				{
					actions
					{
						MissionLog done,main
						EntFireInput fade_out,Fade
						Wait 1
						TargetPlayer 1
						IfAttr "Karma:Target >  0 EntFireInput client,Command:video_exitcmd pm_1_9  p3_end_mission"
						IfAttr "Karma:Target <= 0 EntFireInput client,Command:video_exitcmd pm_1_10 p3_end_mission"
					}
				}
			}
		}
		st_util
		{
			Group Neutral
			Patterns
			{
				xpt_StartCrimeMusic
				{
					actions
					{
						EntFireUser muzak.ambient,1
						EntFireInput muzak.crime,FadeIn:1
					}
				}
				
				xpt_StopCrimeMusic
				{
					actions
					{
						EntFireUser muzak.ambient,2
						EntFireInput muzak.crime,FadeOut:1
					}
				}
				xpt_OnAccomplish2
				{
					actions
					{
						MissionLog done,obj2
						EntFireInput trigger_hobo,Kill
					}
				}
				xpt_OnFail2
				{
					actions
					{
						MissionLog fail,obj2
						PlayerKarma -KARMA_HIGH
						EntFireInput trigger_hobo,Kill
					}
				}
				xpt_OnFail1
				{
					actions
					{
						CheckAttr "Crime01NotDone Block begin"
							EntFireInput "trigger_vandal,Kill"
							PlayerKarma -KARMA_HIGH
							RemoveAttr Crime01NotDone
						Block end
					}
				}
			}
		}
	}
	events
	{
		OnVandal	"State st_vandal"
		OnHobo		"State st_hobo"
		OnMugger	"State st_mugger"
		OnBrawl		"State st_brawl"
		OnCat		"State st_cat"
		OnPawnshop	"State st_pawnshop"
		OnEndMission	"Pattern st_aq.pt_end"
		
		OnAccomplish2	"ExecutePattern st_util.xpt_OnAccomplish2"
		OnFailedObj2	"ExecutePattern st_util.xpt_OnFail2"
		OnFailedObj1	"ExecutePattern st_util.xpt_OnFail1"
		
		OnNewGame	"ExecutePattern weaponGive.PM1"
	}
}


