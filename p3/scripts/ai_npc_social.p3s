		st_OnIgnite
		{
			Group Alert
			Patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern .xpt_SelectWeapon
						Aim false
						Crouch false
						Face false
						FreeMovement false
						SetAttr "ea_status sIGNITED"
						ExecutePattern .xpt_setparams
						Timer tPlayGesture,3,repeated
						Senses false
						Gesture g_onfire,3
						//SetAttr "ignite 1"
						Pattern pt_runaround
					}
				}
				
				pt_runaround
				{
					actions
					{
						AreaEvent OnFire,32
						FreeMovement run,reset
						ExecutePattern .xpt_SayOnFire
						Wait 2:4
						Repeat 0
					}
					events
					{
						OnTimer_tPlayGesture "Gesture g_onfire,3"
						OnInvalidRoute "Repeat 0"
						OnTargetReach "Repeat 0"
					}
				}
				
				pt_extinguish
				{
					actions
					{
						IfAttr "Object:target == Object:Null Pattern pt_end"
						IfAttr "RelationTo:target == Relation:enemy Pattern pt_end"
						IfAttr "RelationTo:target == Relation:fear Pattern pt_end"
						
						IfAttr "Object:target == Object:player Block begin"
							CheckAttr "flag_IgnorePlayerAttack Block begin"
								CheckAttr "flag_IgnorePlayerFear Pattern pt_end"
								Pattern pt_fear
							Block end
							CheckAttr "flag_IgnorePlayerFear Pattern pt_attack"
							Pattern pt_attack,pt_fear
						Block end
						
						IfAttr "Object:target != Object:Player Pattern pt_end"
					}
				}
				
				pt_attack
				{
					actions
					{
						ExecutePattern st_util.xpt_AddTargetToEnemy
						Pattern pt_end
					}
				}
				
				pt_fear
				{
					actions
					{
						ExecutePattern st_util.xpt_AddTargetToFear
						Pattern pt_end
					}
				}
				
				pt_end
				{
					actions
					{
						//RemoveAttr ignite
						SetActPack ACT_RUN,default_run,Alert
						AvoidProhibitedArea true
						Senses true
						
						ResetSequence 1
						ResetGesture g_onfire
						
						IfAttr "reaction <= RE_IGNITE Block begin"
							SetAttr "NewReaction RE_NONE"
							SetAttr "reaction RE_NONE"
							SetAttr "ea_status sNEUTRAL"
						Block end
						
						CheckAttr "flag_bystander SetAttr NewReaction RE_FEAR"
						
						State st_start
					}
				}
				
				xpt_SetParams
				{
					actions
					{
						SetActPack ACT_RUN,run_panic,Alert
						FreeMovementParams area_all,ED_MIDDLE,ED_VERY_FAR
						AvoidProhibitedArea false
					}
				}
				
				xpt_SelectWeapon
				{
					actions
					{
						Weapon drop
						//Weapon disarm
					}
				}
				
				xpt_SayOnFire
				{
					actions
					{
						Say ONFIRE,SCREAM
					}
				}
				
				xpt_ReactionChange
				{
					actions
					{
						IfAttr "reaction > RE_IGNITE Pattern pt_end"
					}
				}
			}
			events
			{
				OnExtinguish "Pattern pt_extinguish"
			}
		}
		
