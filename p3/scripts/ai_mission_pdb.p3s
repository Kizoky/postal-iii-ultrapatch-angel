behavior
{
	name bh_swat03
	inherited bh_civil
	States
	{
		st_init
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern bh_base:st_init.pt_default
						
						SetSquad SWAT_squad
						SetSquadRelation Player_squad:neutral
						
						SetAttr "StandBy 1"
						SetAttr "ReactionThreshold RE_DANGER"
						//SetAttr "flag_IgnorePlayerAttack 1"
						SetAttr "flag_IgnorePlayerFear 1"
						SetAttr "flag_IgnoreCombat 1"
						SetAttr "flag_IgnoreWeapon 1"
						
						Timer tSay,0:5
					}
				}
			}
		}
		
		st_combat_logic
		{
			Group Combat
			Patterns
			{
				xpt_SayAttack
				{
					actions
					{
						IfAttr "Timer:tCanSay > 0 Return 1"
						Say CATCH,HEROIC
						Timer tCanSay,5:3
					}
				}
			}
		}
		
		st_idle
		{
			Group Neutral
			Patterns
			{
				pt_decide
				{
					actions
					{
						Pattern pt_gotohint
					}
				}
				
				pt_idle
				{
					actions
					{
						Wait 5
						State st_start
					}
				}
				
				xpt_SetHintGroup
				{
					actions
					{
						SetHintGroup wish_fun_soldier
					}
				}
				
				xpt_SetHintParams
				{
					actions
					{
						FreeMovementParams hint_all,0,ED_VERY_CLOSE,hint_group,hint_face,use_node,once
					}
				}
				
				xpt_OnVisible
				{
					actions
					{
						IfAttr "Object:caller == Object:Player Block begin"
							TargetCaller 1
							ExecutePattern st_util.xpt_AddPlayerToEnemy
							RemoveAttr StandBy
							AreaEvent ENEMY,128
							State st_start
						Block end
						
						IgnoreTarget 10
						ResetTarget 1
					}
				}
				
				xpt_AllyHostaged
				{
					actions
					{
						TargetCaller 1
						IfAttr "target.ea_faction != self.ea_faction Return 1"
						ExecutePattern st_util.xpt_AddPlayerToEnemy
						RemoveAttr StandBy
						TargetPlayer 1
					}
				}
				
				xpt_EnemyIsNear
				{
					actions
					{
						//AreaEvent ENEMY,8
						ExecutePattern st_util.xpt_AddPlayerToEnemy
						RemoveAttr StandBy
						State st_start
					}
				}
				
				xpt_OnNewEnemy
				{
					actions
					{
						RemoveAttr StandBy
						State st_start
					}
				}
			}
			events
			{
				OnAE_HOSTAGED "ExecutePattern .xpt_AllyHostaged"
				OnAE_ENEMY "ExecutePattern .xpt_AllyHostaged"
				OnAE_EnemyIsNear	"ExecutePattern .xpt_EnemyIsNear"
				OnVisible "Wait 0"
			}
		}
		
		st_combat_hide
		{
			Group Combat
			Patterns
			{
				pt_hide_param
				{
					actions 
					{
						MoveToLean run,ED_VERY_CLOSE,ED_FAR,not_behind_target,nearest
						Pattern pt_hide_loop
					}
				}
			}
		}
		
		st_OnHostaged
		{
			Group Alert
			Patterns
			{
				pt_default
				{
					actions
					{
						AreaEvent HOSTAGED,ED_FAR
						TargetPlayer 1
						ExecutePattern st_util.xpt_AddPlayerToEnemy
						RemoveAttr StandBy
						ExecutePattern bh_base:st_OnHostaged.pt_default
					}
				}
				
				pt_resque
				{
					actions
					{
						AreaEvent HOSTAGE_RESQUE,ED_FAR
						Pattern pt_resque_exit
					}
				}

			}
		}
		
		st_OnNasty
		{
			Group Alert
			Patterns
			{
				pt_default
				{
					actions
					{
						AreaEvent ENEMY,16
						ExecutePattern st_util.xpt_AddPlayerToEnemy
						ExecutePattern bh_base:st_OnNasty.pt_default
					}
				}
				
				pt_react
				{
					actions
					{
						Pattern pt_puke
					}
				}
			}
		}
		
		st_OnKicked
		{
			Group Alert
			Patterns
			{
				pt_default
				{
					actions
					{
						AreaEvent ENEMY,16
						ExecutePattern st_util.xpt_AddPlayerToEnemy
						ExecutePattern bh_base:st_OnKicked.pt_default
					}
				}
			}
		}
		
		st_OnSprayStunned
		{	
			Group Alert
			Patterns
			{
				pt_default
				{
					actions
					{
						AreaEvent ENEMY,16
						Weapon drop
						ExecutePattern bh_base:st_OnSprayStunned.pt_default
					}
				}
				
			}
		}
		
		st_OnIgnite
		{
			Group Alert
			Patterns
			{
				pt_default
				{
					actions
					{
						AreaEvent ENEMY,16
						ExecutePattern bh_base:st_OnIgnite.pt_default
					}
				}
			}
		}
		
		ev_chair
		{
			Group Neutral
			Patterns
			{
				pt_sit
				{
					actions
					{
						Sequence seq.env_chair_2,9000
						Wait 60:120
						Repeat 0
						//Pattern pt_end
					}
					events
					{
						OnTimer_tSitIdle	"ExecutePattern .xpt_idle"
					}
				}
				
				xpt_AttackPlayer
				{
					actions
					{
						AreaEvent ENEMY,16
						ExecutePattern st_util.xpt_AddPlayerToEnemy
						RemoveAttr StandBy
						Pattern pt_end
					}
				}
			}
			events
			{
				//OnAE_HOSTAGED "ExecutePattern st_idle.xpt_AttackPlayer"
				OnAE_ENEMY 		"ExecutePattern .xpt_AttackPlayer"
				OnAE_EnemyIsNear	"ExecutePattern .xpt_AttackPlayer"
				OnNewEnemy		"ExecutePattern .xpt_AttackPlayer"
			}
		}
		
		st_deactivate
		{
			Group Alert
			Patterns
			{
				pt_default
				{
					actions
					{
						AreaEvent ENEMY,16
						TargetFromMem msGP
						FireEvent SoldierDead
						ExecutePattern bh_base:st_deactivate.pt_default
					}
				}
			}
		}
		
	}
}

