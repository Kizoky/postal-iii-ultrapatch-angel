	}
	
}

behavior
{
	name bh_dl_gay
	inherited bh_dl_military
	
	States
	{
		st_init
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern bh_base:st_init.pt_default
						
						SetSquad Gay_Squad
						SetSquadRelation Taliban_Squad:enemy:2,Mom_Squad:enemy:1
						
						IfAttr "slot#msGP.PlayerPath == PATH_INSANE SetAttr flag_VitalEnemy 1"
					}
				}
			}
		}
		
		st_start
		{
			Group Neutral
			Patterns
			{
				xpt_FirstRun
				{
					actions
					{
						CheckAttr "slot#msGP.DudeIsBad SetSquadRelation Player_Squad:enemy:6"
						ExecutePattern bh_base:st_start.xpt_FirstRun
					}
				}
			}
		}
		
		st_util
		{
			Group Neutral
			Patterns
			{
				xpt_AddPlayerToEnemy
				{
					actions
					{
						SetSquadRelation Player_Squad:enemy:6
						ExecutePattern bh_base:st_util.xpt_AddPlayerToEnemy
					}
				}
			}
		}
		
		st_deactivate
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						IfAttr "Object:caller == Object:player Block begin"
							TargetFromMem msGP
							FireEvent DudeKillsGay
							//SetAttr "slot#msGP.DudeIsBad 1"
							AreaEvent DudeIsBad,8
						Block end
						
						ExecutePattern bh_base:st_deactivate.pt_default
					}
				}
			}
		}
	}
	events
	{
		OnAE_DudeIsBad "ExecutePattern st_util.xpt_AddPlayerToEnemy"
	}
	
}


behavior
{
	name bh_dl_boss
	inherited bh_civil
	
	States
	{
		st_init
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern bh_base:st_init.pt_default
						
						SetAttr "ea_dmg_absorb RESIST_HIGH"
						SetAttr "ea_crit_disabled 1"
						SetAttr "TaserDamage 10"
						SetAttr "SprayDamage 10"
						
						SetAttr "flag_IgnorePlayerFear 1"
						SetAttr "flag_IngoreCombat 1"
						SetAttr "flag_IgnoreWeapon 1"
						SetAttr "ea_takeable 0"
						SetAttr "flag_zombie 1"
						SetAttr "flag_boss 1"
						
						SetSquad boss_squad
						SetSquadRelation Player_squad:enemy:8
						
						SetAreaGroup AG_BOSS
					}
				}
			}
		}
		
		st_idle
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						TargetPlayer 1
						State st_start
					}
				}
			}
		}
		
		st_deactivate
		{
			Group Alert
			Patterns
			{
				pt_default
				{
					actions
					{
						TargetFromMem msGP
						FireEvent BossDead
						ExecutePattern bh_base:st_deactivate.pt_default
					}
				}
			}
		}
		
		ChangeKarma
		{
			Group Neutral
			Patterns
			{
				Lethal
				{
					actions
					{
						//пусто
					}
				}
				NonLethal
				{
					actions
					{
						//пусто
					}
				}
			}
		}
		
	}
	
}


behavior
{
	name bh_boss_dave
	inherited bh_dl_boss
	
	States
	{
	
		st_start
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						AttributeProgressBar "DaveHealthPanel,show,ea_health"
						ExecutePattern bh_base:st_start.pt_default
					}
				}
			}
		}
		
		st_combat_logic
		{
			Group Combat
			Patterns
			{
				xpt_SetTaskDefault
				{
					actions
					{
						SetAttr "TaskCombat TC_POSITION"
						Timer tTaskCombat,5:5
						State st_start
					}
				}
			}
		}
		
		st_deactivate
		{
			Group Alert
			Patterns
			{
				pt_default
				{
					actions
					{
						TargetFromMem msGP
						FireEvent DaveKilled
						AttributeProgressBar "DaveHealthPanel,hide"
						ExecutePattern bh_base:st_deactivate.pt_default
					}
				}
			}
		}
		
	}
	
}


