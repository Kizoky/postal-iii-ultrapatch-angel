behavior
{
	name bh_angelitem_pizza
	States
	{
		st_init
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						SetAttr "pissy 0"
						State st_start
					}
				}
			}
		}
		
		st_start
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
					}
					events
					{
						OnUse			"Pattern pt_used"
						OnNasty			"Pattern pt_yuck"
					}
				}
				
				pt_used
				{
					actions
					{
						// This is inside AngelScript because P3S is too slow in execution
						IfAttr "pissy == 0 Block begin"
							AngelScript "Object:myowner CAngelItems OnPizzaUse"
						Block end
						
						IfAttr "pissy == 1 Block begin"
							AngelScript "Object:myowner CAngelItems OnPissyPizzaUse"
						Block end
						
						// TODO: add sound here
						EmitSound cat_meow
						
						// Remove -1 from the stack, adjust new attributes on use
						Item use
						
						State st_start
					}
				}
				
				pt_yuck
				{
					actions
					{
						SetAttr "pissy 1"
						
						State st_start
					}
				}
				
			}

		}
	}
}