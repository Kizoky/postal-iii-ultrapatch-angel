// Postal III Ultrapatch+Angel

@include "postal3.fgd"

@PointClass base(Targetname, Angles) studio("models/editor/landmarkpos.mdl") = info_landmark_pos :
	"Forces the Player's position and angles to be of this entity's if there is a landmark of the same name. "
[

]

@SolidClass base(Trigger) = wj_trigger_angelscript :
	"A trigger volume that can execute AngelScript calls."
[
	ASClassName(string): "AngelScript Class" : "" : "The name of the class which will be used in AngelScript. If nothing is specified it will use Script Owner's behavior."
	ASFunctionName(string): "AngelScript Function" : "" : "The name of the function which will be used in AngelScript."
	ASScriptOwner(string): "AngelScript Script Owner" : "" : "The targetname of the entity which will be used as the owner in AngelScript calls. If this is empty then the call will be global, and will use CBaseEntity@ toucher as the arg."
	ASFunctionArg(string): "AngelScript Argument" : "" : "The argument the function will have. This will always be a string. For global it will be '(CBaseEntity@ toucher, string args)', otherwise just '(string args)'."
]

@PointClass base(Targetname) size(-8 -8 -8, 8 8 8) = wj_logic_angelscript : 
	"An entity which can call AngelScript code through input. Only global calls are supported."
[
	targetent(string): "Target Entity" : "" : "The target name of the entity. If it's empty the calls will be global."

	input FireASFunction(string) : "ClassName??FuncName (Global)"
	input FireASFunctionOwner(string) : "ClassName??FuncName (Owner)"
	input FireASFunctionTarget(string) : "ClassName??FuncName (Target)"
]

@SolidClass base(Targetname) = func_nav_blocker : "A brush entity that can block nav areas touching its AABB." 
[
	input BlockNav(void) : "Starts blocking nav areas."
	input UnblockNav(void) : "Stops blocking nav areas."

	teamToBlock(choices) : "Team(s) to block" : -2 : "Block the nav for NPCs" =
	[
		-2 : "Everyone"
	]
	
	StartDisabled(choices) : "Start Disabled" : 0 : "(Yes - Unblocks nav || No - Blocks nav) on spawn" =
	[
		0 : "No"
		1 : "Yes"
	]
]

@SolidClass base(Trigger, Targetname) = func_nav_prerequisite : "A trigger volume that requires bots to do perform a task before they can move through it."
[
	Task(choices) : "Task" : 1 : "What must be done to move through this volume" =
	[
		1 : "Destroy Entity (Value = max range to attack from. -1 for no range restriction)"
		2 : "Move to Entity"
		3 : "Wait (Value = seconds to wait)"
	]

	Entity(target_destination) : "Task Entity" : : "The subject entity of the Task"

	Value(float) : "Task Value" : 0 : "A Task-specific value"

	start_disabled(choices) : "Start Disabled" : 0 =
	[
		0 : "No"
		1 : "Yes"
	]

	// Inputs
	input Enable(void) : "Enable"
	input Disable(void) : "Disable"
]

@SolidClass base(Targetname, EnableDisable) = func_nav_avoidance_obstacle : "A brush entity that tells bots to avoid nav areas touching its AABB." 
[
]

@PointClass base(prop_p3_fsmitem,Parentname) studioprop() = wj_prop_fsmitem : "Interactable Prop"
[
	FSMBehavior(string): "FSM behavior" : "bh_prop_" : ""
	StartState(string) : "Start state" : "prop_start" : ""
	InitState(string) : "Init state" : "prop_init" : ""
	Manner(string) : "Manner" : "" : "" 
	Faction(string) : "Faction" : "Interactable" : ""
	input SetFSMTarget(string) : "Set FSM Target to NPC"
	input SetState(string) : ""
	input SetAttribute(string) : ""
	input ChangeAttribute(string) : ""
	
	StartDisabled(choices) : "Start Disabled" : 0 : "Item visibility/interactivity with the world" =
	[
		0 : "No (Item visible/interactable on Spawn)"
		1 : "Yes (Item invisible/non-interactable on Spawn)"
	]
	
	TransformItem(string): "Inventory Item Manifest" : "" : "Prop will become an inventory item according to p3_ultrapatch_inventory.txt (or from addons). Some properties will be overridden by the manifest."
	
	input EnableItem(void) : "Enable Item"
	input DisableItem(void) : "Disable Item"
	
	input EnableInteraction(void) : "Enable Interaction"
	input DisableInteraction(void) : "Disable Interaction"
	
	input EnableTicking(void) : "Enable AngelScript Ticking"
	input DisableTicking(void) : "Disable AngelScript Ticking"
	
	output OnPropUse(void) : "Fired when something is interacting with the prop. Must have P3S scripting."
	
	spawnflags(Flags) =
	[
		1 : "Start Asleep" : 0
		2 : "Don't take physics damage" : 1
		4 : "Debris - Don't collide with the player or other debris" : 0
		8 : "Motion Disabled" : 1
		64 : "Enable motion on Physcannon grab" : 0
		128 : "Not affected by rotor wash" : 0
		256 : "Generate output on +USE " : 0
		512 : "Prevent pickup" : 1
		1024: "Prevent motion enable on player bump" : 1
		4096: "Debris with trigger interaction" : 0
		8192: "Force server-side (Multiplayer only)" : 0
		1048576: "Physgun can ALWAYS pick up. No matter what." : 0
		8388608: "Template Physprop (used by item_spawner, will not spawn)" : 0
		268435456: "Useable (player can use this item)" : 0
	]
	
	disableshadows(Choices) : "Disable Shadows" : 1 : "" =
	[
		0 : "No"
		1 : "Yes"
	]
]

