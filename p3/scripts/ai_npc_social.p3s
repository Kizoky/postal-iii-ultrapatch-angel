		st_OnHearDanger
		{
			Group Alert
			Patterns
			{
				pt_default
				{
					actions
					{
						FreeMovement false
						Pattern pt_react
					}
				}
				
				pt_react
				{
					actions
					{
						Pattern pt_danger //,pt_fear
					}
				}
				
				pt_danger
				{
					actions
					{
						Sequence seq.reaction_shocked_2,seq.reaction_confused,seq.reaction_afraid
						Wait 0.2
						ExecutePattern .xpt_SayDanger
						Wait 1:1
						Pattern pt_end, //pt_fear
					}
				}
				
				pt_fear
				{
					actions
					{
						SetAttr "NewReaction RE_FEAR"
						Wait 0.5
						Pattern pt_end
					}
				}
				
				pt_end
				{
					actions
					{
						ResetSequence 1
						
						IfAttr "reaction <= RE_DANGER Block begin"
							SetAttr "reaction RE_NONE"
							SetAttr "NewReaction RE_NONE"
						Block end
						
						State st_start
					}
				}
				
				xpt_SayDanger
				{
					actions
					{
						IfAttr "VoicePrefix:self == String:GAY Block begin"
							Say SCREAM,GETCOP,1
							Return 1
						Block end
						
						IfAttr "ea_manner == Manner:LowLife Say SCREAM,SEECARNAGE,1"
						IfAttr "ea_manner != Manner:LowLife Say SCREAM,GETCOP,SEECARNAGE,1" //,wait
					}
				}
				
				xpt_ReactionChange
				{
					actions
					{
						IfAttr "reaction > RE_DANGER Pattern pt_end"
					}
				}
			}
		}
		
		st_OnSeeFlame
		{
			Group Alert
			Patterns
			{
				pt_default
				{
					actions
					{
						FreeMovement false
						FreeMovementParams area_all,ED_MIDDLE,ED_FAR,move_from_target //backaway
						SetActPack ACT_RUN,run_panic,Alert
						Pattern pt_moveout
					}
				}
				
				pt_moveout
				{
					actions
					{
						FreeMovement run
						Say SEEFIRE
						Wait 3:3
						Pattern pt_end
					}
					events
					{
						OnTargetReach "Pattern pt_end"
						OnInvalidRoute "Pattern pt_end"
					}
				}
				
				pt_end
				{
					actions
					{
						SetActPack ACT_RUN,run_normal,Alert
						
						IfAttr "reaction <= RE_SEEFLAME Block begin"
							SetAttr "NewReaction RE_NONE"
							SetAttr "reaction RE_NONE"
						Block end
						
						State st_start
					}
				}
				
				xpt_ReactionChange
				{
					actions
					{
						IfAttr "reaction > RE_SEEFLAME Pattern pt_end"
					}
				}
			}
		}
		
		st_fear
		{
			Group Alert
			Patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern .xpt_InitRunAway
						FreeMovement false
						Face false
						ExecutePattern .xpt_SelectWeapon
						SetActPack ACT_RUN,run_panic,Alert
						Gesture g_emote_afraid,2:2
						Timer tAfraid,4,repeated
						Timer tFear,30:30
						Pattern pt_runaway
					}
				}
				
				xpt_InitRunAway
				{
					actions
					{
						SetAttr "RunAway_Tries 0"
					}
				}
				
				xpt_SelectWeapon
				{
					actions
					{
						Weapon disarm
						//�����
					}
				}
				
				pt_decide
				{
					actions
					{
						Pattern pt_runaway,pt_beg
					}
				}
				
				pt_runaway
				{
					actions
					{
						ResetSequence 1
						ExecutePattern .xpt_SetParams
						FreeMovement run
						
						Wait 1
						SetAttr "RunAway_Tries 0"
						//���� ��-���� ����-�� �������� �������, ���������� �������
						
						ExecutePattern .xpt_SayRun
						Wait 5:4
						Pattern pt_decide
					}
					events
					{
						OnInvalidRoute "ExecutePattern .xpt_OnInvalidRoute"
						//OnTargetReach "Pattern pt_decide"
					}
				}
				
				xpt_OnInvalidRoute
				{
					actions
					{
						CheckAttr "RunAway_Tries Block begin"
							IfAttr "RunAway_Tries < 3 Block begin"
								ChangeAttr "RunAway_Tries +1"
								Pattern pt_runaway
								Return 1
							Block end
							
							IfAttr "RunAway_Tries == 3 SetAttr RunAway_Tries 0"
						Block end
						
						Pattern pt_beg
					}
				}
				
				xpt_SetParams
				{
					actions
					{
						IfAttr "RunAway_Tries == 0 FreeMovementParams area_hidden,ED_FAR,ED_VERY_FAR,move_from_target" //,safe
						IfAttr "RunAway_Tries == 1 FreeMovementParams area_all,ED_MIDDLE,ED_VERY_FAR,move_from_target"
						IfAttr "RunAway_Tries == 2 FreeMovementParams area_all,ED_MIDDLE,ED_VERY_FAR"
					}
				}
				
				pt_beg
				{
					actions
					{
						FreeMovement false
						Sequence seq.env_crouch,9000 
						Gesture g_emote_afraid,2:2
						ExecutePattern .xpt_SayBeg
						Wait 4:4
						Pattern pt_runaway
					}
				}
				
				pt_end
				{
					actions
					{
						RemoveAttr RunAway_Tries
						Timer tFear,0
						Timer tAfraid,0
						ResetGesture g_emote_afraid
						ResetSequence 1
						SetActPack ACT_RUN,run_normal,Alert
						Crouch false
						
						IfAttr "reaction <= RE_FEAR Block begin"
							SetAttr "NewReaction	RE_NONE"
							SetAttr "reaction		RE_NONE"
						Block end
						
						State st_start
					}
				}
				
				xpt_SayRun
				{
					actions
					{
						IfAttr "ea_Manner == Manner:LowLife Block begin"
							Say SEECARNAGE,SCREAM
							Return 1
						Block end
						
						Say SEECARNAGE,SCREAM,GETCOP
						//Say CHAV_ATTACK
					}
				}
				
				xpt_SayBeg
				{
					actions
					{
						IfAttr "Object:target == Object:player Say CRY,DONTKILLME"
						IfAttr "Object:target != Object:player Say CRY"
					}
				}
				
				xpt_ReactionChange
				{
					actions
					{
						IfAttr "reaction > RE_FEAR Pattern pt_end"
					}
				}
			}
			events
			{
				//OnHit "Say DONTKILLME"
				OnTimer_tFear "Pattern pt_end"
				OnTimer_tAfraid "Gesture g_emote_afraid,2:2"
			}
		}
		
		
		st_OnKicked
		{
			Group Alert
			Patterns
			{
				pt_default
				{
					actions
					{
						FireEvent KickedMe
						
						CheckAttr "NotAttackedByPlayer Block begin"
							IfAttr "Object:target == Object:player ExecutePattern st_util.xpt_OnAttackedByPlayer"
						Block end
						
						SetAttr "ReactionIgnoreLevel RE_WEAPON"
						SetAttr "Commented 0"
						
						IfAttr "reaction == RE_KICKED Block begin"
							SetAttr "reaction RE_NONE"
							SetAttr "NewReaction RE_NONE"
						Block end
						
						ExecutePattern st_util.xpt_SayHit
						Wait 5
						Pattern pt_end
					}
					events
					{
						OnStandUpBegin "Pattern pt_standing"
					}
				}
				
				pt_standing
				{
					actions
					{
						Wait 5
						Pattern pt_end
					}
					events
					{
						OnStandUpEnd "Pattern pt_react"
					}
				}
				
				pt_react
				{
					actions
					{
						CheckAttr "NewReactionSet Pattern pt_end"
						Pattern pt_decide
					}
				}
				
				pt_decide
				{
					actions
					{
						IfAttr "RelationTo:target == Relation:enemy Pattern pt_end"
						IfAttr "RelationTo:target == Relation:fear  Pattern pt_end"
						
						CheckAttr "flag_IgnorePlayerAttack Block begin"
							CheckAttr "flag_IgnorePlayerFear Pattern pt_blame"
							Pattern pt_blame,pt_fear
						Block end
						
						CheckAttr "flag_IgnorePlayerFear Pattern pt_attack,pt_blame"
						
						Pattern pt_blame,pt_attack,pt_fear
					}
				}
				
				pt_attack
				{
					actions
					{
						IfAttr "Object:target == Object:player ExecutePattern st_util.xpt_AddTargetToEnemy"
						Pattern pt_end
					}
				}
				
				pt_blame
				{
					actions
					{
						Face true
						Wait 0.3:0.3
						Sequence emote_aggro
						Say BUMPED
						WaitForEnd 1
						SetAttr "Commented 1"
						Pattern pt_end
					}
				}
				
				pt_fear
				{
					actions
					{
						ExecutePattern st_util.xpt_AddTargetToFear
						SetAttr "NewReaction RE_FEAR"
						Pattern pt_end
					}
				}
				
				pt_end
				{
					actions
					{
						Face false
						ResetSequence 1
						RemoveAttr Commented
						
						RemoveAttr "NewReactionSet"
						
						IfAttr "reaction <= ReactionIgnoreLevel Block begin"
							SetAttr "NewReaction RE_NONE"
							SetAttr "reaction	 RE_NONE"
						Block end
						
						State st_start
					}
				}
				
				xpt_ReactionChange
				{
					actions
					{
						IfAttr "reaction >= RE_STUNNED Pattern pt_end"
						IfAttr "reaction > ReactionIgnoreLevel SetAttr NewReactionSet 1"
					}
				}
			}
			events
			{
				OnKicked "Pattern pt_default"
				OnHit "Wait 0"
			}
		}
		
		st_OnBumped
		{
			Group Alert
			Patterns
			{
				pt_default
				{
					actions
					{
						Pattern pt_end,pt_comment
					}
				}
				
				pt_comment
				{
					actions
					{
						LookAt true
						Say BUMPED,0 //,wait
						Pattern pt_end
					}
				}
				
				pt_end
				{
					actions
					{
						LookAt false
						IfAttr "NewReaction <= RE_BUMPED SetAttr NewReaction RE_NONE"
						IfAttr "reaction <= RE_BUMPED SetAttr reaction RE_NONE"
						Timer tBump,8
						IgnoreTarget 10
						ResetTarget 1
						State st_start
					}
				}
				
				xpt_ReactionChange
				{
					actions
					{
						IfAttr "reaction > RE_BUMPED Pattern pt_end"
					}
				}
			}
			events
			{
				OnBump "Wait 0"
			}
		}
		
		
		st_OnNasty
		{
			Group Alert
			Patterns
			{
				pt_default
				{
					actions
					{
						IfAttr "Timer:tIgnoreNasty > 0 Pattern pt_end"
						SetAttr "Commented 0"
						FreeMovement false
						Pattern pt_react
					}
				}
				
				pt_react
				{
					actions
					{
						IfAttr "RelationTo:target == Relation:enemy Pattern pt_puke,pt_end"
						IfAttr "RelationTo:target == Relation:fear 	Pattern pt_puke,pt_end"
						
						//����, ����� ��������� ������ ��������, ������ ���� ������� �����
						IfAttr "Object:target == Object:Player Block begin"
							CheckAttr "flag_IgnorePlayerAttack SetAttr flag_IgnoreNastyAttack 1"
						Block end
						IfAttr "Object:target != Object:Player SetAttr flag_IgnoreNastyAttack 1"
						//������� � ������� ���� ��� ���������� ��������
						
						CheckAttr "flag_IgnoreNastyAttack Block begin"
							CheckAttr "flag_IgnorePlayerFear Block begin"
								IfAttr "Commented == 0 Pattern pt_comment,pt_puke"
								IfAttr "Commented == 1 Pattern pt_puke"
							Block end
							
							IfAttr "Commented == 0 Pattern pt_comment,pt_puke,pt_fear"
							IfAttr "Commented == 1 Pattern pt_puke,pt_fear"
						Block end
						
						CheckAttr "flag_IgnorePlayerFear Block begin"
							IfAttr "Commented == 0 Pattern pt_attack,pt_comment,pt_puke"
							IfAttr "Commented == 1 Pattern pt_attack,pt_puke"
						Block end
						
						IfAttr "Commented == 0 Pattern pt_comment,pt_attack,pt_puke,pt_fear"
						IfAttr "Commented == 1 Pattern pt_attack,pt_puke,pt_fear"
					}
				}
				
				pt_comment
				{
					actions
					{
						LookAt true
						Sequence emote_annoyed
						ExecutePattern .xpt_SayPissedOn
						WaitForEnd 1
						SetAttr "Commented 1"
						Pattern pt_react
					}
				}
				
				pt_attack
				{
					actions
					{
						IfAttr "Commented == 0 ExecutePattern .xpt_SayPissedOn"
						ExecutePattern st_util.xpt_AddTargetToEnemy
						Pattern pt_end
					}
				}
				
				pt_puke
				{
					actions
					{
						SetAttr "NewReaction RE_PUKE"
						Pattern pt_end
					}
				}
				
				pt_fear
				{
					actions
					{
						ExecutePattern st_util.xpt_AddTargetToFear
						SetAttr "NewReaction RE_FEAR"
						Pattern pt_end
					}
				}
				
				pt_end
				{
					actions
					{
						RemoveAttr flag_IgnoreNastyAttack
						IfAttr "Timer:tIgnoreNasty <= 0 Timer tIgnoreNasty,NASTY_TIMER_DEFAULT:NASTY_TIMER_SPREAD_DEFAULT"
						//�������� ��� ����, ����� ����� ���� �������� ������� �������� ��� ������������, �� ���������� ������ �����
						LookAt false
						RemoveAttr Commented
						
						IfAttr "NewReaction <= RE_NASTY Block begin"
							SetAttr "NewReaction RE_NONE"
							SetAttr "reaction RE_NONE"
						Block end
						
						State st_start
					}
				}
				
				xpt_SayPissedOn
				{
					actions
					{
						Say PISSEDON,1
					}
				}
				
				xpt_ReactionChange
				{
					actions
					{
						IfAttr "reaction > RE_NASTY Pattern pt_end"
					}
				}
			}
		}
		
