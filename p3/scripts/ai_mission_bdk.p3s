behavior
{
	name bh_krotchy_nerd_base
	inherited bh_civil
	
	States
	{
	
		st_init
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern bh_base:st_init.pt_default
						
						SetSquad nerd_squad
						TargetEntByName mission_logic
						TargetToMem msGP
						
						TargetEntByName "npc_krotchy"
						TargetToMem msLEADER
						
						TargetPlayer 1
						Relationship target,enemy,3
						SetSquadRelation player_squad:enemy:5
						//,cops_squad:enemy:3
						
						Timer tCheckTarget,5,repeat
						SetAttr "NerdIgonreDistance BDK_DEFAULT_NERD_IGNORE,0,BDK_DEFAULT_NERD_IGNORE"
						
					}
				}
			}
		}
		st_start
		{
			Group Neutral
			Patterns
			{
				pt_default1
				{
					actions
					{
						IfAttr "DistTo:Player > NerdIgonreDistance Block begin"
							FreeMovementParams area_all,256,-1,area_group
							FreeMovement walk,reset
						Block end
						IfAttr "DistTo:Player <= NerdIgonreDistance Block begin"
							TargetPlayer 1
							ExecutePattern bh_base:st_start.pt_default
						Block end
						repeat 1
					}
				}
			}
		}
		st_picktoy
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						FreeMovement false
						TargetCaller 1
						Pattern pt_moveto
					}
				}
				
				pt_moveto
				{
					actions
					{
						MoveToTarget run,1,0
						Wait 5:3
						Pattern pt_end
					}
					events
					{
						OnTargetReach "Pattern pt_pick"
					}
				}
				
				pt_pick
				{
					actions
					{
						
						Sequence seq.env_crouch_inspect,8
						Wait 10
						Pattern pt_end
					}
					events
					{
						OnDamage "Pattern pt_end"
					}
				}
				
				pt_end
				{
					actions
					{
						ResetTarget 1
						IfAttr "reaction <= RE_KICKED Block begin"
							SetAttr "reaction RE_NONE"
							SetAttr "NewReaction RE_NONE"
						Block end
						State st_start
					}
				}
				
				xpt_ReactionChange
				{
					actions
					{
						IfAttr "reaction >= RE_KICKED and reaction != RE_FEAR Pattern pt_end"
					}
				}
			}
			events
			{	
				OnAE_KrotchyToy "Wait 0"
			}
		}
	}
	
	
	events
	{
		OnAE_KrotchyToy "State st_picktoy"
		OnTimer_tCheckTarget "CheckTarget 1"
		//OnLost "ResetTarget 1"
	}
}

