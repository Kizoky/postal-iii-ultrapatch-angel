behavior
{
	name bh_bdk_civil
	inherited bh_civil
	states
	{
		st_init
		{
			group Neutral
			patterns 
			{
				pt_default
				{
					actions
					{
						ExecutePattern bh_base:st_init.pt_default
						
						IfAttr "Name:self == String:npc_shopper SetAttr shopping 1"
						SetAttr "flag_bystander 1"
					}
				}
			}
		}
		
		st_init_static
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern st_init.pt_default
						SetAttr "flag_static 1"
					}
				}
			}
		}
		
		st_idle
		{
			group Neutral
			patterns
			{
				xpt_SetAreaGroup
				{
					actions
					{
						SetAreaGroup AG_DEFAULT,AG_BATTLE
						CheckAttr "shopping SetAreaGroup AG_SHOP"
					}
				}
				xpt_SetHintGroup
				{
					actions
					{
						CheckAttr "flag_static Return 1"
						SetHintGroup wish_fun_idle
						CheckAttr "shopping SetHintGroup wish_fun_shop"
					}
				}
				
			}
		}
		
	}
	
}