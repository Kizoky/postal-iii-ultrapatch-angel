	{
		st_init
		{
			Group Neutral
			Patterns
			{
				pt_default
				{
					actions
					{
						ExecutePattern bh_base:st_init.pt_default
						
						SetSquad protector_suqad
						SetSquadRelation venezuela_squad:enemy:4
						
						SetAttr "GrenadeType GRND_TYPE_FRAG"
						SetAttr "flag_ThrowSafe 1"
					}
				}
